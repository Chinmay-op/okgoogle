<!-- Edit Student Selection Modal -->
<div class="modal fade" id="editStudentSelectionModal" tabindex="-1">
    <div class="modal-dialog">
        <form class="modal-content" action="/admin/mess/edit-student-selection" method="POST">
            <div class="modal-header">
                <h5 class="modal-title">Edit Student Selection</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="student_uid" id="editStudentUid">
                <input type="hidden" name="meal_type" id="editStudentMealType">
                <input type="hidden" name="selection_date" value="<%= typeof targetDate !== 'undefined' ? targetDate : '' %>">
                <div class="mb-3">
                    <label>UID</label>
                    <input type="text" class="form-control" id="editStudentUidDisplay" disabled>
                </div>
                <div class="mb-3">
                    <label>Selected Food</label>
                    <input type="text" class="form-control" name="selected_food" id="editStudentSelectedFood" placeholder="e.g. 'DEFAULT' or specific food name" required>
                    <small class="text-muted">Type 'DEFAULT' to assign the default menu, or type the exact name of the optional food.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Selection</button>
            </div>
        </form>
    </div>
</div>

<script>
    function editStudentSelection(uid, mealType, currentFood) {
        document.getElementById('editStudentUid').value = uid;
        document.getElementById('editStudentUidDisplay').value = uid;
        document.getElementById('editStudentMealType').value = mealType || 'breakfast';
        document.getElementById('editStudentSelectedFood').value = currentFood;
        var myModal = new bootstrap.Modal(document.getElementById('editStudentSelectionModal'));
        myModal.show();
    }
</script>

<!-- Add Special Food Modal -->
<div class="modal fade" id="addSpecialFoodModal" tabindex="-1" aria-labelledby="addSpecialFoodModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addSpecialFoodModalLabel">Add Special Food Item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/special-food/items/add" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Food Name (e.g., Milk)</label>
            <input type="text" class="form-control" name="food_name" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Quantity / Description (e.g., 300ml)</label>
            <input type="text" class="form-control" name="quantity_desc" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Duration (Days)</label>
            <input type="number" class="form-control" name="duration_days" min="1" value="30" required>
            <small class="text-muted">This duration will be used in student requests.</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Price per Day (₹)</label>
            <input type="number" step="0.01" class="form-control" name="price_per_day" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Availability</label>
            <select class="form-select" name="availability" required>
              <option value="both">Both (Day & Night)</option>
              <option value="day">Day Only</option>
              <option value="night">Night Only</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-primary">Add Item</button>
        </div>
      </form>
    </div>
  </div>
</div>

