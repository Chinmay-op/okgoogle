        <form class="modal-content" action="/admin/mess/edit-optional-single" method="POST" id="editSingleOptionalForm">
            <div class="modal-header">
                <h5 class="modal-title">Edit Optional Menu: <span id="singleOptionalMealLabel"></span> - <span id="singleOptionalDayLabel"></span></h5>
