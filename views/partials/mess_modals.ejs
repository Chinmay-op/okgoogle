<!-- Single Day Default Menu Modal -->
<div class="modal fade" id="editSingleModal" tabindex="-1">
    <div class="modal-dialog">
        <form class="modal-content" action="/admin/mess/edit-single" method="POST">
            <div class="modal-header">
                <h5 class="modal-title">Edit Default Menu: <span id="singleMealLabel"></span> - <span id="singleDayLabel"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="meal_type" id="singleMealType">
                <input type="hidden" name="weekday" id="singleWeekday">
                <div class="mb-3">
                    <label>Food Name</label>
                    <input type="text" class="form-control" name="food_name" id="singleFoodName" required>
                </div>
                <div class="mb-3">
                    <label>Drink</label>
                    <input type="text" class="form-control" name="drink" id="singleDrink">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- Full Week Default Menu Modal -->
<div class="modal fade" id="editFullWeekModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form class="modal-content" action="/admin/mess/edit-full" method="POST">
            <div class="modal-header">
                <h5 class="modal-title">Edit Full Week Default Menu: <span id="fullWeekMealLabel"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="meal_type" id="fullWeekMealType">
                <table class="table">
                    <thead><tr><th>Day</th><th>Food Name</th><th>Drink</th></tr></thead>
                    <tbody>
                        <% ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'].forEach(d => { %>
                        <tr>
                            <td><%= d %></td>
                            <td><input type="text" class="form-control full-week-food-<%= d %>" name="food_<%= d %>"></td>
                            <td><input type="text" class="form-control full-week-drink-<%= d %>" name="drink_<%= d %>"></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Week</button>
            </div>
        </form>
    </div>
</div>

<!-- Single Day Optional Menu Modal -->
