<!-- Request Special Food Modal (Student) -->
<div class="modal fade" id="requestSpecialFoodModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Request <span id="reqSFNameDisplay" class="text-primary"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/special-food/requests/add" method="POST">
        <input type="hidden" name="special_food_id" id="reqSFId">
        <input type="hidden" id="reqSFBasePrice">
        
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Duration (Days)</label>
            <input type="number" class="form-control" name="duration_days" id="reqSFDuration" value="30" min="1" required readonly>
            <small class="text-muted">Set by the admin while creating the item.</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Quantity Multiplier</label>
            <input type="number" class="form-control" name="quantity_multiplier" id="reqSFQuantity" value="1" min="1" required oninput="calculateSFTotal()">
            <small class="text-muted">E.g. 2 means double the quantity.</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Time Slot</label>
            <select class="form-select" name="obtain_time" id="reqSFTime" required onchange="calculateSFTotal()">
              <option value="day">Day</option>
              <option value="night">Night</option>
              <option value="both">Both (Day & Night) - 2x Price</option>
            </select>
          </div>
          
          <div class="alert alert-info mt-3">
            <h5 class="mb-0">Estimated Total: ₹<span id="reqSFTotal">0</span></h5>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-primary">Submit Request</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Approve Special Food Modal (Superadmin) -->
<div class="modal fade" id="approveSpecialFoodModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Approve Special Food Request</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="approveSpecialFoodForm" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Start Date</label>
            <input type="date" class="form-control" name="start_date" id="approveSFStartDate" required>
            <small class="text-muted">The validity period will start from this date.</small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-success">Approve Request</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Edit Item
    const editBtns = document.querySelectorAll('.edit-food-btn');
    editBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('editSpecialFoodForm').action = '/special-food/items/edit/' + this.dataset.id;
            document.getElementById('editSFName').value = this.dataset.name;
            document.getElementById('editSFQuantity').value = this.dataset.quantity;
            document.getElementById('editSFPrice').value = this.dataset.price;
            document.getElementById('editSFDuration').value = this.dataset.durationDays || 30;
            document.getElementById('editSFAvailability').value = this.dataset.availability;
        });
    });
    
    // Request Item
    const reqBtns = document.querySelectorAll('.request-food-btn');
    reqBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('reqSFId').value = this.dataset.id;
            document.getElementById('reqSFNameDisplay').innerText = this.dataset.name;
            document.getElementById('reqSFBasePrice').value = this.dataset.price;
            document.getElementById('reqSFDuration').value = this.dataset.durationDays || 30;
            
            const avail = this.dataset.availability;
            const timeSelect = document.getElementById('reqSFTime');
            
            // Enable all options first
            Array.from(timeSelect.options).forEach(opt => opt.disabled = false);
            
            // Disable options that don't match the item's availability
            if (avail === 'day') {
                timeSelect.querySelector('option[value="night"]').disabled = true;
                timeSelect.querySelector('option[value="both"]').disabled = true;
                timeSelect.value = 'day';
            } else if (avail === 'night') {
                timeSelect.querySelector('option[value="day"]').disabled = true;
                timeSelect.querySelector('option[value="both"]').disabled = true;
                timeSelect.value = 'night';
            } else {
                // 'both' means any option is valid
                timeSelect.value = 'day'; // Default to day, let student choose
            }
            
            calculateSFTotal();
        });
    });
    
    // Approve Request
    const approveBtns = document.querySelectorAll('.approve-food-btn');
    approveBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('approveSpecialFoodForm').action = '/special-food/requests/approve/' + this.dataset.id;
            // Set default date to today
            const today = new Date();
            const todayStr = new Date(today.getTime() - (today.getTimezoneOffset() * 60000)).toISOString().split('T')[0];
            document.getElementById('approveSFStartDate').value = todayStr;
        });
    });
});

function calculateSFTotal() {
    const basePrice = parseFloat(document.getElementById('reqSFBasePrice').value) || 0;
    const duration = parseInt(document.getElementById('reqSFDuration').value) || 0;
    const qty = parseInt(document.getElementById('reqSFQuantity').value) || 0;
    const time = document.getElementById('reqSFTime').value;
    
    let multiplier = 1;
    if (time === 'both') multiplier = 2;
    
    const total = basePrice * duration * qty * multiplier;
    document.getElementById('reqSFTotal').innerText = total.toFixed(2);
}
</script>
