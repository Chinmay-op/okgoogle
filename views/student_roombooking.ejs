<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Room Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

        <style>
        /* Remove arrows from number input */
        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type="number"] {
            -moz-appearance: textfield;
        }

        body { background-color: #f0f2f5; font-family: 'Segoe UI', sans-serif; overflow-x: hidden; }

        .navbar-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 0 0 15px 15px;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
            padding: 0.8rem 2rem;
        }

        .block-tabs .nav-link {
            font-size: 1.05rem; font-weight: 700; color: #444 !important;
            background-color: #fff; border: 1px solid #ddd; border-radius: 8px;
            padding: 10px 25px; margin-right: 10px; transition: all 0.2s;
        }
        .block-tabs .nav-link.active { background-color: #6c5ce7 !important; color: white !important; }

        .floor-pills .nav-link {
            font-weight: 600; color: #555 !important; background-color: #fff;
            border: 1px solid #ccc; border-radius: 20px; padding: 8px 20px; margin-right: 10px;
        }
        .floor-pills .nav-link.active { background-color: #0984e3 !important; color: white !important; }

        .room-card {
            background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            margin-bottom: 20px; padding: 15px; border-top: 5px solid #a29bfe;
        }
        .room-header { font-weight: 700; color: #444; border-bottom: 1px solid #eee; padding-bottom: 5px; margin-bottom: 10px; }

        .room-box {
            min-height: 80px; 
            height: 100%;
            padding: 5px;
            border-radius: 10px; display: flex; flex-direction: column;
            align-items: center; justify-content: center; cursor: pointer;
            border: 2px solid transparent; position: relative; transition: all 0.12s;
            user-select: none;
        }
        .room-box:hover { transform: scale(1.04); box-shadow: 0 5px 15px rgba(0,0,0,0.12); }

        .room-available { background-color: #28a745; color: white; border-color: #1f8a39; }
        .room-booked { background-color: #ffdb4d; color: #5a4300; border-color: #d9a800; }
        .room-booked-pending { background-color: #ffb3c7; color: #6b1230; border-color: #e26d8c; }
        .room-booked-new { background-color: #0a2463; color: white; border-color: #061a47; }
        .room-disabled { pointer-events: none; opacity: 0.75; }

        .room-no { font-weight: 800; font-size: clamp(0.75rem, 2.5vw, 0.85rem); }
        .room-meta { font-size: clamp(0.6rem, 2.2vw, 0.65rem); font-weight: 700; opacity: 0.95; }
        
        .occupant-name {
            font-weight: 700;
            margin-top: 0.25rem;
            font-size: clamp(0.65rem, 2.5vw, 0.8rem);
            text-align: center;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        .mybooking-card {
            border-radius: 12px;
            background: #fff;
            border: 1px solid #eaeaea;
        }

        @media (max-width: 575.98px) {
            .block-tabs .nav-link { 
                padding: 8px 15px; 
                font-size: 0.95rem; 
                margin-bottom: 5px; 
                margin-right: 5px;
            }
            .floor-pills .nav-link { 
                padding: 6px 15px; 
                font-size: 0.85rem; 
                margin-bottom: 5px;
                margin-right: 5px;
            }
        }
    </style>
</head>
<body>
<% 
function formatIST(value) {
    if (!value) return '--';
    const date = new Date(value);
    if (isNaN(date.getTime())) return String(value);
    const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Kolkata',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false
    }).formatToParts(date).reduce((acc, part) => {
        if (part.type !== 'literal') acc[part.type] = part.value;
        return acc;
    }, {});
    return `${parts.year}-${parts.month}-${parts.day} ${parts.hour}:${parts.minute}:${parts.second} IST`;
}
%>

<nav class="navbar navbar-expand-lg navbar-custom mb-4">
    <div class="container-fluid">
        <span class="navbar-brand text-white fw-bold"><i class="fas fa-bed me-2"></i>Room Booking</span>
        <div class="navbar-nav ms-auto">
            <a href="/student/dashboard" class="nav-item nav-link text-white">Home</a>
            <a href="/student/logout" class="nav-item nav-link text-white ms-2">Logout</a>
        </div>
    </div>
</nav>

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-lg-3 col-md-4">

            <% if(message && message.length > 0){ %>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    <%- message %>
                </div>
            <% } %>

            <% if(typeof roomBookingEnabled !== 'undefined' && !roomBookingEnabled){ %>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    Room booking is currently disabled. You cannot apply for a new room, but you can view your current status.
                </div>
            <% } %>

            <div class="card p-3 mb-3 shadow-sm border-0 mybooking-card">
                <h6 class="fw-bold text-muted text-uppercase small">My Booking</h6>
                <hr>
                <% if (myBooking) { %>
                    <div class="mb-2"><small class="text-muted">Room</small><div class="fw-bold"><%= myBooking.block %> - <%= myBooking.floor %> - Room <%= myBooking.room_no %> (Bed <%= myBooking.bed_no || '--' %>)</div></div>
                    <div class="mb-2"><small class="text-muted">Payment</small><div class="fw-bold text-warning"><%= myBooking.payment_status %></div></div>
                    <div class="mb-2"><small class="text-muted">Advance Amount</small><div class="fw-bold"><%= (myBooking.advance_amount != null ? myBooking.advance_amount : '--') %></div></div>
                    <div class="mb-2"><small class="text-muted">Transaction ID</small><div class="fw-bold"><%= (myBooking.transaction_id || '--') %></div></div>
                    <div class="mb-2"><small class="text-muted">Booked At</small><div class="fw-bold"><%= formatIST(myBooking.created_at) %></div></div>
                    <div class="alert alert-warning py-2 mb-0">You already have an active room booking.</div>
                <% } else { %>
                    <div class="text-muted">No active booking</div>
                <% } %>
            </div>

            <div class="card p-3 shadow-sm border-0" style="border-radius: 12px;">
                <h6 class="fw-bold text-muted text-uppercase small">Legend</h6>
                <hr>
                <div class="d-grid gap-2">
                    <div class="p-2 rounded room-available text-center"><strong>Available</strong></div>
                    <div class="p-2 rounded room-booked-pending text-center"><strong>Pending</strong></div>
                    <div class="p-2 rounded room-booked text-center"><strong>Confirmed</strong></div>
                    <div class="p-2 rounded room-booked-new text-center"><strong>New Admission</strong></div>
                </div>
            </div>

        </div>

        <div class="col-lg-9 col-md-8">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm border">
                <ul class="nav nav-pills block-tabs" id="blockTabs"></ul>
                <ul class="nav nav-pills floor-pills mt-2 mt-md-0" id="floorPills"></ul>
            </div>

            <h5 class="text-dark fw-bold mb-3 px-2" id="gridTitle">Rooms</h5>
            <div class="row" id="roomsContainer"></div>
        </div>
    </div>
</div>

<!-- Agreement Modal -->
<div class="modal fade" id="agreeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold">Confirm Booking</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <div class="text-muted small">Selected Room</div>
                    <div class="fw-bold" id="selRoomText">--</div>
                </div>

                <div class="alert alert-info">
                    <strong>Note:</strong> Enter the correct advance amount paid and the transaction ID of payment to lock the room. Do not enter wrong amount otherwise your booking will be rejected.
                </div>

                <div class="row g-3 align-items-start">
                    
                    <div class="col-md-7">
                        <div class="mb-2">
                            <label class="form-label fw-bold">Advance Amount (₹)</label>
                            <input type="number" class="form-control" id="payAmount" placeholder="Enter paid amount">
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-bold">Transaction ID</label>
                            <input type="text" class="form-control" id="txnId" maxlength="255" placeholder="Enter UPI transaction ID">
                        </div>
                    </div>
                </div>

                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="agreeCheck">
                    <label class="form-check-label" for="agreeCheck">
                        I agree to pay the advance amount for this room.
                    </label>
                </div>

                <form id="bookForm" action="/student/roombooking" method="POST" class="mt-3">
                    <input type="hidden" name="room_no" id="f_room_no">
                    <input type="hidden" name="block" id="f_block">
                    <input type="hidden" name="floor" id="f_floor">
                    <input type="hidden" name="agreement_accepted" id="f_agreement">
                    <input type="hidden" name="advance_amount" id="f_advance_amount">
                    <input type="hidden" name="transaction_id" id="f_transaction_id">

                    <button type="submit" class="btn btn-success w-100 mt-3" onclick="return submitBooking()">
                        <i class="fas fa-lock me-1"></i> Confirm & Lock Room
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
<script type="application/json" id="roomsData"><%- JSON.stringify(rooms || []) %></script>
<script type="application/json" id="myBookingData"><%- JSON.stringify(!!myBooking) %></script>
<script type="application/json" id="roomBookingEnabledData"><%- JSON.stringify(typeof roomBookingEnabled !== 'undefined' ? !!roomBookingEnabled : true) %></script>
<script>
    const rooms = JSON.parse((document.getElementById('roomsData') || {}).textContent || '[]');
    const hasMyBooking = JSON.parse((document.getElementById('myBookingData') || {}).textContent || 'false');
    const roomBookingEnabled = JSON.parse((document.getElementById('roomBookingEnabledData') || {}).textContent || 'true');

    let currentBlock = null;
    let currentFloor = null;
    let selected = { room_no: null, block: null, floor: null };

    const agreeModal = new bootstrap.Modal(document.getElementById('agreeModal'));

    function uniq(arr){ return Array.from(new Set(arr)); }

    function initTabs(){
        const blocks = uniq(rooms.map(r => (r.block || '').trim()).filter(Boolean)).sort();
        const blockTabs = document.getElementById('blockTabs');
        blockTabs.innerHTML = '';
        blocks.forEach((b, idx) => {
            const active = idx === 0 ? 'active' : '';
            blockTabs.innerHTML += `<li class="nav-item"><button class="nav-link ${active}" onclick="switchBlock('${b}', this)">Block ${b}</button></li>`;
        });
        currentBlock = blocks[0] || 'A';
        renderFloors();
    }

    function switchBlock(b, el){
        currentBlock = b;
        document.querySelectorAll('#blockTabs .nav-link').forEach(x => x.classList.remove('active'));
        if (el) el.classList.add('active');
        renderFloors();
    }

    function renderFloors(){
        const floors = uniq(rooms.filter(r => (r.block || '').trim() === currentBlock)
            .map(r => (r.floor || '').trim()).filter(Boolean));

        const floorPills = document.getElementById('floorPills');
        floorPills.innerHTML = '';
        floors.forEach((f, idx) => {
            const active = idx === 0 ? 'active' : '';
            floorPills.innerHTML += `<li class="nav-item"><button class="nav-link ${active}" onclick="switchFloor('${f}', this)">${f}</button></li>`;
        });
        currentFloor = floors[0] || 'Ground Floor';
        renderGrid();
    }

    function switchFloor(f, el){
        currentFloor = f;
        document.querySelectorAll('#floorPills .nav-link').forEach(x => x.classList.remove('active'));
        if (el) el.classList.add('active');
        renderGrid();
    }

    function groupByRoom(list){
        const g = {};
        list.forEach(r => {
            const key = (r.room_no || '').toString();
            if (!g[key]) g[key] = [];
            g[key].push(r);
        });
        return g;
    }

    function compareBookingDisplayOrder(a, b){
        const getPriority = (row) => {
            const uid = ((row.booked_uid || '') + '').trim();
            const paymentStatus = String(row.payment_status || '').trim().toLowerCase();
            if (/^BH/i.test(uid)) return 0;
            if (paymentStatus === 'pending') return 1;
            if (paymentStatus === 'confirmed') return 2;
            return 3;
        };

        const pa = getPriority(a);
        const pb = getPriority(b);
        if (pa !== pb) return pa - pb;

        const at = new Date(a.booked_at || a.created_at || 0).getTime() || 0;
        const bt = new Date(b.booked_at || b.created_at || 0).getTime() || 0;
        if (bt !== at) return bt - at;

        const ai = parseInt(a.booking_id || a.id || 0, 10) || 0;
        const bi = parseInt(b.booking_id || b.id || 0, 10) || 0;
        return bi - ai;
    }

        function renderGrid(){
        const container = document.getElementById('roomsContainer');
        container.innerHTML = '';
        document.getElementById('gridTitle').innerText = `Rooms: ${currentBlock} - ${currentFloor}`;

        const subset = rooms.filter(r => (r.block || '').trim() === currentBlock && (r.floor || '').trim() === currentFloor);
        const grouped = groupByRoom(subset);

        Object.keys(grouped).sort().forEach(roomNo => {
            const items = grouped[roomNo];
            const info = items[0] || {};
            const capacity = parseInt(info.capacity) || 1;
            
            let bedsHtml = '';
            const allLetters = ['A', 'B', 'C', 'D', 'E', 'F'];
            
            let colClass = '';
            if (capacity === 1) colClass = 'col-12';
            else if (capacity === 2) colClass = 'col-6';
            else colClass = 'col-6 col-sm-4';
            
            for (let i = 0; i < capacity; i++) {
                const bedLetter = allLetters[i] || String.fromCharCode(65 + i);
                
                // Find if this specific bed is booked
                const booking = items
                    .filter(b => (b.booked_bed || '').trim().toUpperCase() === bedLetter && b.booked_uid)
                    .sort(compareBookingDisplayOrder)[0];
                
                if (booking) {
                    const bookedBy = (booking.booked_name && booking.booked_uid) 
                        ? `${booking.booked_name.split(' ')[0]} (${booking.booked_uid})` 
                        : (booking.booked_name || booking.booked_uid || 'Booked');
                    const isNewUid = /^BH/i.test(((booking.booked_uid || '') + '').trim());
                    const paymentStatus = String(booking.payment_status || '').trim().toLowerCase();
                    const boxClass = isNewUid
                        ? 'room-booked-new'
                        : (paymentStatus === 'pending' ? 'room-booked-pending' : 'room-booked');
                    const labelText = isNewUid
                        ? 'NEW ADMISSION'
                        : (paymentStatus === 'pending' ? 'PENDING' : 'CONFIRMED');
                        
                    bedsHtml += `
                        <div class="${colClass}">
                            <div class="room-box ${boxClass} room-disabled">
                                <div class="room-no">Bed ${bedLetter}</div>
                                <div class="occupant-name">${bookedBy}</div>
                                <div class="room-meta mt-1">${labelText}</div>
                            </div>
                        </div>`;
                } else if (info.is_permanent) {
                    const desc = info.description || 'PERMANENT';
                    bedsHtml += `
                        <div class="${colClass}">
                            <div class="room-box bg-secondary text-white room-disabled" style="border-color: #555;">
                                <div class="room-no">Bed ${bedLetter}</div>
                                <div class="occupant-name">${desc}</div>
                            </div>
                        </div>`;
                } else {
                    bedsHtml += `
                        <div class="${colClass}">
                            <div class="room-box room-available" onclick="selectRoom('${roomNo}','${info.block}','${info.floor}','${bedLetter}')">
                                <div class="room-no">Bed ${bedLetter}</div>
                                <div class="room-meta mt-1">AVAILABLE</div>
                            </div>
                        </div>`;
                }
            }

            const meta = `${info.room_type || ''} • Cap ${info.capacity || ''}`.trim();

            container.innerHTML += `
                <div class="col-md-6 col-lg-4">
                    <div class="room-card">
                        <div class="room-header text-center d-flex justify-content-between align-items-center">
                            <span>Room ${roomNo}</span>
                            <span class="badge bg-secondary" style="font-size: 0.65rem;">${meta}</span>
                        </div>
                        <div class="row g-2 pt-1">
                            ${bedsHtml}
                        </div>
                    </div>
                </div>
            `;
        });
    }

    function selectRoom(room_no, block, floor, bed_no){
        if (hasMyBooking) {
            alert('You already have an active booking.');
            return;
        }
        if (!roomBookingEnabled) {
            alert('Room booking is currently disabled by admin.');
            return;
        }
        selected = { room_no, block, floor, bed_no };
        document.getElementById('selRoomText').innerText = `${block} - ${floor} - Room ${room_no} (Bed ${bed_no})`;
        document.getElementById('agreeCheck').checked = false;
        const amt = document.getElementById('payAmount');
        const txn = document.getElementById('txnId');
        if (amt) amt.value = '';
        if (txn) txn.value = '';
        agreeModal.show();
    }

    function submitBooking(){
        if (!document.getElementById('agreeCheck').checked) {
            alert('Please accept the agreement to continue.');
            return false;
        }
        const amountRaw = (document.getElementById('payAmount') || {}).value;
        const amount = parseFloat(amountRaw);
        if (!amountRaw || isNaN(amount)) {
            alert('Please enter a valid advance amount.');
            return false;
        }
        const txnId = ((document.getElementById('txnId') || {}).value || '').trim();
        if (!txnId) {
            alert('Please enter your transaction ID.');
            return false;
        }
        document.getElementById('f_room_no').value = selected.room_no;
        document.getElementById('f_block').value = selected.block;
        document.getElementById('f_floor').value = selected.floor;
        
        // Add bed_no to the form dynamically if it doesn't exist
        let bedInput = document.getElementById('f_bed_no');
        if (!bedInput) {
            bedInput = document.createElement('input');
            bedInput.type = 'hidden';
            bedInput.name = 'bed_no';
            bedInput.id = 'f_bed_no';
            document.getElementById('bookForm').appendChild(bedInput);
        }
        bedInput.value = selected.bed_no;
        
        document.getElementById('f_agreement').value = 'true';
        document.getElementById('f_advance_amount').value = String(amount);
        document.getElementById('f_transaction_id').value = txnId;
        return true;
    }

    window.onload = initTabs;
</script>

</body>
</html>
