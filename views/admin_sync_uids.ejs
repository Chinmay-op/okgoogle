<%- include('partials/header') %>
<!-- Ensure sidebar and layout container are handled by header/footer partials as in other admin views -->

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-sync-alt me-2 text-primary"></i> Bulk UID Sync</h2>
    <a href="/admin/dashboard" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
  </div>

  <% if (message && message.length > 0) { %>
    <div class="alert alert-info"><%= message %></div>
  <% } %>

  <div class="row">
    <div class="col-md-5">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="fas fa-cogs me-2"></i>Sync Configuration</h5>
        </div>
        <div class="card-body">
          <p class="text-muted small">
            Map the temporary hostel UIDs to official college UIDs by matching the student's registered mobile number against the college database.
          </p>
          <div class="alert alert-warning">
            <strong><%= tempCount %></strong> students currently using temporary UIDs.
          </div>
          
          <form action="/admin/sync-uids" method="POST">
            <div class="mb-3">
              <label class="form-label fw-bold">College Table Name</label>
              <input type="text" name="college_table" class="form-control" value="<%= typeof college_table !== 'undefined' ? college_table : '' %>" required pattern="^[a-zA-Z0-9_]+$" title="Only letters, numbers, and underscores allowed">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">College UID Column Name</label>
              <input type="text" name="college_uid_col" class="form-control" value="<%= typeof college_uid_col !== 'undefined' ? college_uid_col : '' %>" required pattern="^[a-zA-Z0-9_]+$">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">College Mobile Column Name</label>
              <input type="text" name="college_mobile_col" class="form-control" value="<%= typeof college_mobile_col !== 'undefined' ? college_mobile_col : '' %>" required pattern="^[a-zA-Z0-9_]+$">
            </div>
            
            <div class="d-flex gap-2 mt-4">
              <button type="submit" name="action" value="preview" class="btn btn-info text-white flex-grow-1">
                <i class="fas fa-search me-1"></i> Dry Run / Preview
              </button>
              <button type="submit" name="action" value="sync" class="btn btn-success flex-grow-1" onclick="return confirm('Are you sure you want to run the bulk sync? This will permanently update UIDs.');">
                <i class="fas fa-play me-1"></i> Run Sync
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-md-7">
      <% if (typeof previewResults !== 'undefined' && previewResults) { %>
        <div class="card shadow-sm border-info">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-eye me-2"></i>Preview Results</h5>
          </div>
          <div class="card-body p-0">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Temp UID</th>
                  <th>Name</th>
                  <th>Mobile</th>
                  <th>Found College UID</th>
                </tr>
              </thead>
              <tbody>
                <% previewResults.forEach(function(p) { %>
                  <tr>
                    <td><span class="badge bg-warning text-dark"><%= p.temp_uid %></span></td>
                    <td><%= p.sname %></td>
                    <td><%= p.mobileno %></td>
                    <td>
                      <% if (p.real_uid) { %>
                        <span class="badge bg-success"><%= p.real_uid %></span>
                      <% } else { %>
                        <span class="text-danger small"><i class="fas fa-times me-1"></i>No match</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } else if (tempStudents && tempStudents.length > 0) { %>
        <div class="card shadow-sm">
          <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-users me-2"></i>Students Awaiting Sync</h5>
          </div>
          <div class="card-body p-0">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Temp UID</th>
                  <th>Name</th>
                  <th>Mobile</th>
                </tr>
              </thead>
              <tbody>
                <% tempStudents.forEach(function(s) { %>
                  <tr>
                    <td><span class="badge bg-warning text-dark"><%= s.uid %></span></td>
                    <td><%= s.sname %></td>
                    <td><%= s.mobileno %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } else { %>
        <div class="alert alert-success mt-4">
          <i class="fas fa-check-circle me-2"></i> All students have official UIDs. No temporary UIDs found.
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
