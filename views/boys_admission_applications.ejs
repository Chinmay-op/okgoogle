<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boys Hostel - New Students View</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .header-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,.1);
        }
        .glass-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,.05);
            padding: 20px;
        }
        .stat-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,.05);
            padding: 18px;
            border-left: 5px solid #667eea;
            margin-bottom: 16px;
        }
        .stat-card.pending { border-left-color: #ffb400; }
        .stat-card.admitted { border-left-color: #2ecc71; }
        .stat-card.rejected { border-left-color: #e74c3c; }
        .stat-title { font-size: .8rem; text-transform: uppercase; color: #6c757d; font-weight: 700; }
        .stat-value { font-size: 1.8rem; font-weight: 800; color: #1f2a44; }
    </style>
</head>
<body>
<div class="container-fluid mt-4 px-4 pb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="/daterange" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back to Dashboard</a>
    </div>

    <div class="header-gradient d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-user-graduate me-2"></i>New Students</h2>
            <div class="opacity-75">Hostel admission form submissions and final room allotment summary</div>
        </div>
        <div class="text-end">
            <div class="small opacity-75">Role</div>
            <div class="fw-bold fs-5"><%= role %></div>
        </div>
    </div>

    <% if (message && message.length > 0) { %>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% 
        const total = applications.length;
        const pending = applications.filter(a => String(a.status || '').toLowerCase() === 'pending').length;
        const admitted = applications.filter(a => String(a.status || '').toLowerCase() === 'admitted').length;
        const rejected = applications.filter(a => String(a.status || '').toLowerCase() === 'rejected').length;
    %>

    <div class="row">
        <div class="col-md-3"><div class="stat-card"><div class="stat-title">Total Applications</div><div class="stat-value"><%= total %></div></div></div>
        <div class="col-md-3"><div class="stat-card pending"><div class="stat-title">Pending</div><div class="stat-value"><%= pending %></div></div></div>
        <div class="col-md-3"><div class="stat-card admitted"><div class="stat-title">Admitted</div><div class="stat-value"><%= admitted %></div></div></div>
        <div class="col-md-3"><div class="stat-card rejected"><div class="stat-title">Rejected</div><div class="stat-value"><%= rejected %></div></div></div>
    </div>

    <div class="glass-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <h5 class="mb-0 fw-bold text-dark">Applications</h5>
            <div class="input-group" style="max-width: 360px;">
                <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                <input id="searchInput" type="text" class="form-control" placeholder="Search name, branch, UID, room...">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle" id="appsTable">
                <thead class="table-light">
                    <tr>
                        <th>#ID</th>
                        <th>Full Name</th>
                        <th>Branch</th>
                        <th>Year</th>
                        <th>Status</th>
                        <th>UID</th>
                        <th>Room</th>
                        <th>Submitted</th>
                        <th class="text-end">View</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (applications && applications.length) { %>
                        <% applications.forEach(function(app){ %>
                            <tr>
                                <td class="fw-bold"><%= app.id %></td>
                                <td><%= app.full_name %></td>
                                <td><%= app.branch || '--' %></td>
                                <td><%= app.admission_year || '--' %></td>
                                <td>
                                    <% if(String(app.status || '').toLowerCase() === 'admitted') { %>
                                        <span class="badge bg-success">Admitted</span>
                                    <% } else if(String(app.status || '').toLowerCase() === 'rejected') { %>
                                        <span class="badge bg-danger">Rejected</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    <% } %>
                                </td>
                                <td class="font-monospace"><%= app.student_uid || '--' %></td>
                                <td>
                                    <%= app.allotted_block || '--' %> /
                                    <%= app.allotted_room || '--' %> /
                                    <%= app.allotted_bed || '--' %>
                                </td>
                                <td><%= app.created_at ? new Date(app.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) : '--' %></td>
                                <td class="text-end">
                                    <a href="/boys/admission-applications/<%= app.id %>" class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye me-1"></i>View
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No applications found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const searchInput = document.getElementById('searchInput');
    const rows = document.querySelectorAll('#appsTable tbody tr');
    if (searchInput) {
        searchInput.addEventListener('input', function () {
            const term = this.value.toLowerCase();
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(term) ? '' : 'none';
            });
        });
    }
</script>
</body>
</html>
