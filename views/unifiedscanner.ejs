<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Unified Scanner</title>
  <link rel="stylesheet" href="stylesheets/codescanner.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="icon" href="/images/4174.png">
  <img src="/images/logo.png" height="auto" width="auto" class="center" /><br><br>
  <script>
    var barcode = '';
    var interval;

    document.addEventListener('keydown', function (evt) {
      if (interval) clearInterval(interval);

      if (evt.code === 'Enter') {
        if (barcode) handleBarcode(barcode);
        barcode = '';
        return;
      }
      if (evt.key !== 'Shift') barcode += evt.key;
      interval = setInterval(() => barcode = '', 20);
    });

    function handleBarcode(scanned_barcode) {
      var backRoute = window.location.pathname === '/homepage' ? '/homepage' : '/unifiedscanner';
      location.href = "/unifiedcodescanner/" + scanned_barcode + "?back=" + encodeURIComponent(backRoute);
    }

    function showdiv() {
      document.getElementById("staticuid").hidden = !document.getElementById("staticuid").hidden;
    }

    function manualenter() {
      var UID = document.getElementById("inp").value;
      var backRoute = window.location.pathname === '/homepage' ? '/homepage' : '/unifiedscanner';
      location.href = "/unifiedcodescanner/" + UID + "?back=" + encodeURIComponent(backRoute);
    }
  </script>
</head>
<body>
  <div class="bg-image"
    style="background-image: url('/images/tokenhomepagebg.png'); height: 100vh; width:50vh;">

    <% if (message && message.length > 0) { %>
      <div class="alert-danger">
        <h3><%- message %></h3>
      </div>
    <% } %>

    <div class="m-4">
      <nav class="navbar navbar-expand-lg navbar-light bg-light text-dark">
        <a class="nav-item nav-link text-dark" onclick="showdiv()">Enter UID</a>
        <div class="navbar-nav ms-auto">
          <% if (role == 'SuperID' || role == 'Hostelauthority' || role == 'BoysHostelAdmin' || role == 'GirlsHostelAdmin') { %>
          <a href="/attendance" class="nav-item nav-link text-dark">Attendance</a>
          <% } %>
          <a href="/gateouttoday" class="nav-item nav-link text-dark">Gateout</a>
          <a href="/logout" class="nav-item nav-link text-dark">Logout</a>
        </div>
      </nav>
    </div>

    <div id="staticuid" hidden>
      <div class="inp">
        <input type="text" id="inp" placeholder="&nbsp;">
        <span class="label">UID</span>
        <span class="focus-bg"></span>
      </div><br>
      <div>
        <center><button class="btn btn-dark" onclick="manualenter()">Next</button></center>
      </div>
    </div>
  </div>
</body>
</html>
