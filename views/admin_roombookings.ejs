<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Room Bookings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body { background-color: #f0f2f5; font-family: 'Segoe UI', sans-serif; }
        .navbar-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 0 0 15px 15px;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
            padding: 0.8rem 2rem;
        }
        .card { border-radius: 12px; }
        .badge-status { font-size: 0.78rem; }

        .room-card {
            background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            margin-bottom: 20px; padding: 15px; border-top: 5px solid #a29bfe;
        }
        .room-header { font-weight: 700; color: #444; border-bottom: 1px solid #eee; padding-bottom: 5px; margin-bottom: 10px; }
        .room-box {
            height: 90px; border-radius: 10px; display: flex; flex-direction: column;
            align-items: center; justify-content: center; cursor: pointer;
            border: 2px solid transparent; position: relative; transition: all 0.12s;
            user-select: none;
        }
        .room-box:hover { transform: scale(1.04); box-shadow: 0 5px 15px rgba(0,0,0,0.12); }
        .room-available { background-color: #28a745; color: white; border-color: #1f8a39; }
        .room-booked { background-color: #ffdb4d; color: #5a4300; border-color: #d9a800; }
        .room-booked-pending { background-color: #ffb3c7; color: #6b1230; border-color: #e26d8c; }
        .room-booked-new { background-color: #0a2463; color: white; border-color: #061a47; }
        .room-disabled { pointer-events: none; opacity: 0.75; }
        .room-no { font-weight: 800; font-size: 0.95rem; }
        .room-meta { font-size: 0.7rem; opacity: 0.9; }

        .block-tabs .nav-link {
            font-size: 1.05rem; font-weight: 700; color: #444 !important;
            background-color: #fff; border: 1px solid #ddd; border-radius: 8px;
            padding: 10px 25px; margin-right: 10px; transition: all 0.2s;
        }
        .block-tabs .nav-link.active { background-color: #6c5ce7 !important; color: white !important; }
        .floor-pills .nav-link {
            font-weight: 600; color: #555 !important; background-color: #fff;
            border: 1px solid #ccc; border-radius: 20px; padding: 8px 20px; margin-right: 10px;
        }
        .floor-pills .nav-link.active { background-color: #0984e3 !important; color: white !important; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-custom mb-4">
    <div class="container-fluid">
        <span class="navbar-brand text-white fw-bold"><i class="fas fa-clipboard-list me-2"></i>Room Bookings</span>
        <div class="navbar-nav ms-auto">
            <a href="/daterange" class="nav-item nav-link text-white">Home</a>
            <a href="/logout" class="nav-item nav-link text-white ms-2">Logout</a>
        </div>
    </div>
</nav>

<div class="container-fluid px-4">
    <% if(message && message.length > 0){ %>
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            <%- message %>
        </div>
    <% } %>

<% if (role === 'BoysHostelAdmin' || role === 'SuperID') { %>
  <div class="d-flex justify-content-end mb-3">
    <a href="/admin/pending-admissions" class="btn btn-warning">
      <i class="fas fa-clock me-2"></i>
      Pending Admission Applications
      <span class="badge bg-dark ms-2" id="pendingCount"><%= pendingApplications.length %></span>
    </a>
  </div>
  <% } %>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0 fw-bold">Locked Bookings</h5>
                <div class="text-muted small">Role: <%= role %></div>
            </div>
        </div>
        <div class="card-body">
            <% if (rooms && rooms.length) { %>
                <div class="mb-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm border">
                        <ul class="nav nav-pills block-tabs" id="blockTabs"></ul>
                        <ul class="nav nav-pills floor-pills mt-2 mt-md-0" id="floorPills"></ul>
                    </div>
                    <h6 class="text-dark fw-bold mb-3 px-2" id="gridTitle">Rooms</h6>
                    <div class="row" id="roomsContainer"></div>
                    <div class="text-muted small mt-2">
                        <span class="badge bg-success">Available</span>
                        <span class="badge bg-warning text-dark ms-2">Locked</span>
                        <% if (role === 'SuperID') { %>
                            <span class="ms-2">Click available room to lock for a student.</span>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <div id="bookingsSection" class="d-flex justify-content-end align-items-center mb-3 mt-4 flex-wrap gap-3">
                <div class="d-flex align-items-center">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Search Room, Name, UID..." onkeyup="filterTable()" style="width: 200px;">
                    </div>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="openUnappliedStudentsModal()">
                    <i class="fas fa-user-clock me-1"></i> Unapplied Hostel Students
                </button>
                <form class="d-flex align-items-center">
                    <label class="me-2 fw-bold text-muted small text-nowrap">Filter by Year:</label>
                    <select class="form-select form-select-sm" onchange="window.location.href='/admin/roombookings?year_filter=' + this.value + '#bookingsSection'" style="width: auto; min-width: 130px;">
                        <option value="">All Students</option>
                        <option value="1" <%= (typeof yearFilter !== 'undefined' && yearFilter === '1') ? 'selected' : '' %>>1st Year</option>
                        <option value="2" <%= (typeof yearFilter !== 'undefined' && yearFilter === '2') ? 'selected' : '' %>>2nd Year</option>
                        <option value="3" <%= (typeof yearFilter !== 'undefined' && yearFilter === '3') ? 'selected' : '' %>>3rd Year</option>
                        <option value="4" <%= (typeof yearFilter !== 'undefined' && yearFilter === '4') ? 'selected' : '' %>>4th Year</option>
                    </select>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Room</th>
                            <th>Bed</th>
                            <th>Block</th>
                            <th>Floor</th>
                            <th>Student</th>
                            <th>UID</th>
                            <th>Payment</th>
                            <th>Advance</th>
                            <th>Txn ID</th>
                            <th>Agreement</th>
                            <th>Booked At</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (bookings && bookings.length) { %>
                            <% bookings.forEach(function(b){ %>
                                <% const bookingStatus = (b.booking_status || '').toLowerCase(); const paymentStatus = (b.payment_status || '').toLowerCase(); %>
                                <tr>
                                    <td class="fw-bold"><%= b.room_no %></td>
                                    <td class="fw-bold text-primary"><%= b.bed_no || '--' %></td>
                                    <td><%= b.block %></td>
                                    <td><%= b.floor %></td>
                                    <td><%= b.sname || '--' %></td>
                                    <td><%= b.uid %></td>
                                    <td>
                                        <% if (bookingStatus === 'cancelled' || paymentStatus === 'cancelled') { %>
                                            <span class="badge bg-danger badge-status">CANCELLED</span>
                                        <% } else if (paymentStatus === 'confirmed') { %>
                                            <span class="badge bg-primary badge-status">CONFIRMED</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark badge-status">PENDING</span>
                                        <% } %>
                                    </td>
                                    <td><%= (b.advance_amount != null ? b.advance_amount : '--') %></td>
                                    <td><%= (b.transaction_id || '--') %></td>
                                    <td>
                                        <% if (b.agreement_accepted) { %>
                                            <span class="badge bg-success badge-status">YES</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary badge-status">NO</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <%= b.created_at ? new Date(b.created_at).toISOString().replace('T', ' ').substring(0, 19) : '--' %>
                                    </td>
                                    <td class="text-end">
                                        <% if (role === 'SuperID') { %>
                                        <button type="button" class="btn btn-sm btn-info text-white me-1" onclick="openPaymentModal('<%= b.id %>', '<%= b.uid %>')">
                                            <i class="fas fa-money-check-alt"></i> Pay
                                        </button>
                                        <% } %>
                                        <% if (role === 'SuperID' && bookingStatus === 'locked' && paymentStatus !== 'cancelled') { %>
                                            <button type="button"
                                                    class="btn btn-sm btn-warning text-dark me-1 js-transfer-btn"
                                                    data-booking-id="<%= b.id %>"
                                                    data-uid="<%= b.uid || '' %>"
                                                    data-name="<%= b.sname || '' %>"
                                                    data-room="<%= b.room_no || '' %>"
                                                    data-block="<%= b.block || '' %>"
                                                    data-floor="<%= b.floor || '' %>"
                                                    data-bed="<%= b.bed_no || '' %>"
                                                    data-status="<%= paymentStatus || '' %>">
                                                <i class="fas fa-exchange-alt"></i> Transfer
                                            </button>
                                        <% } %>
                                        <% if (bookingStatus === 'cancelled' || paymentStatus === 'cancelled') { %>
                                            <span class="text-danger small fw-semibold">Cancelled</span>
                                        <% } else { %>
                                        <% if (role !== 'BoysHostelAdmin') { %>
                                        <% if (bookingStatus === 'locked' && (b.payment_status || '').toLowerCase() === 'pending' && b.transaction_id && b.advance_amount != null) { %>
                                            <form action="/admin/roombooking/approve" method="POST" style="display:inline;">
                                                <input type="hidden" name="booking_id" value="<%= b.id %>">
                                                <button type="submit" class="btn btn-sm btn-primary me-1" onclick="return confirm('Approve payment using existing Txn ID (<%= b.transaction_id %>) and Advance Amount (₹<%= b.advance_amount %>)?');">
                                                    <i class="fas fa-check"></i> Approve
                                                </button>
                                            </form>
                                        <% } %>
                                        <% } %>
                                        <% if (role === 'SuperID') { %>
                                            <form action="/admin/roombooking/cancel" method="POST" style="display:inline;">
                                                <input type="hidden" name="id" value="<%= b.id %>">
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Cancel this booking? Room will become available again.');">
                                                    <i class="fas fa-times"></i> Cancel
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span class="text-muted small">--</span>
                                        <% } %>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="11" class="text-center text-muted">No bookings found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title fw-bold">Update Payment Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <div class="text-muted small">Student</div>
                    <div class="fw-bold" id="payStudentText">--</div>
                </div>

                <form action="/admin/roombooking/payment" method="POST">
                    <input type="hidden" name="booking_id" id="p_booking_id">

                    <div class="alert alert-info small">
                        Enter payment details to mark this booking as CONFIRMED.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Advance Amount Paid (₹)</label>
                        <input type="number" class="form-control" name="advance_amount" id="p_amount" min="1" step="1" required placeholder="Enter amount">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Transaction ID / Receipt No.</label>
                        <input type="text" class="form-control" name="transaction_id" id="p_txn" maxlength="255" required placeholder="Txn ID">
                    </div>

                    <button type="submit" class="btn btn-success w-100 mt-3" onclick="return confirm('Mark this booking as confirmed?');">
                        <i class="fas fa-check-circle me-1"></i> Confirm Payment
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Transfer Modal -->
<div class="modal fade" id="transferModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header bg-warning">
                <h5 class="modal-title fw-bold">Transfer Room / Bed</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <div class="text-muted small">Student</div>
                    <div class="fw-bold" id="transferStudentText">--</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small">Current Room</div>
                    <div class="fw-bold" id="transferCurrentText">--</div>
                </div>

                <form action="/admin/roombooking/transfer" method="POST" onsubmit="return confirmTransferBooking();">
                    <input type="hidden" name="booking_id" id="t_booking_id">
                    <input type="hidden" name="new_floor" id="t_floor">

                    <div class="alert alert-warning small">
                        Select a new empty room and bed. The booking will be moved and the previous room will be freed automatically.
                    </div>

                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Block</label>
                            <select name="new_block" id="t_block" class="form-select" required onchange="populateTransferRooms()">
                                <option value="">-- Select Block --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Room</label>
                            <select name="new_room" id="t_room" class="form-select" required onchange="populateTransferBeds()">
                                <option value="">-- Select Room --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Bed</label>
                            <select name="new_bed" id="t_bed" class="form-select" required>
                                <option value="">-- Select Bed --</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 mt-3 fw-bold">
                        <i class="fas fa-exchange-alt me-1"></i> Confirm Transfer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Unapplied Hostel Students Modal -->
<div class="modal fade" id="unappliedStudentsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title fw-bold">
                    Hostel Students Not Yet Applied
                    <span class="badge bg-dark ms-2" id="unappliedCountBadge">0</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info small mb-3">
                    This list shows hostel students who do not have any room booking entry yet.
                </div>

                <div class="mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" class="form-control" id="unappliedSearchInput" placeholder="Search by name or UID">
                    </div>
                </div>

                <div class="list-group" id="unappliedStudentsList" style="max-height: 55vh; overflow-y: auto;">
                    <div class="list-group-item text-muted">Loading...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Admin Lock Modal (SuperID) -->
<% if (role === 'SuperID') { %>
<div class="modal fade" id="lockModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold">Lock Room For Student</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <div class="text-muted small">Selected Room</div>
                    <div class="fw-bold" id="adminSelRoomText">--</div>
                </div>

                <form action="/admin/roombooking/lock" method="POST" onsubmit="return submitAdminLock();">
                    <input type="hidden" name="room_no" id="a_room_no">
                    <input type="hidden" name="bed_no" id="a_bed_no">
                    <input type="hidden" name="block" id="a_block">
                    <input type="hidden" name="floor" id="a_floor">
                    <input type="hidden" name="agreement_accepted" id="a_agreement">

                    <div class="mb-2">
                        <label class="form-label fw-bold">Student (UID)</label>
                        <input type="text" class="form-control" name="uid" id="a_uid" placeholder="Type UID" list="studentUidList" required>
                        <datalist id="studentUidList">
                            <% (students || []).forEach(function(st){ %>
                                <option value="<%= st.uid %>"><%= st.sname %></option>
                            <% }); %>
                        </datalist>
                        <div class="text-muted small mt-1">Start typing UID to see suggestions (Hostel + not restricted).</div>
                    </div>

                    <div class="alert alert-info">
                        <strong>Optional:</strong> Enter advance payment details. If left blank, room will still be locked.
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Advance Amount (₹)</label>
                            <input type="text" class="form-control" name="advance_amount" id="a_amount" inputmode="numeric" placeholder="Enter advance amount paid">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Transaction ID</label>
                            <input type="text" class="form-control" name="transaction_id" id="a_txn" maxlength="255" placeholder="Enter transaction id">
                        </div>
                    </div>

                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="a_agree_check">
                        <label class="form-check-label" for="a_agree_check">Agreement accepted for this booking</label>
                    </div>

                    <button type="submit" class="btn btn-success w-100 mt-3">
                        <i class="fas fa-lock me-1"></i> Lock Room
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

<script type="application/json" id="roomsData"><%- JSON.stringify(rooms || []) %></script>
<script type="application/json" id="roleData"><%- JSON.stringify(role || '') %></script>
<script>
    const rooms = JSON.parse((document.getElementById('roomsData') || {}).textContent || '[]');
    const PERMANENT_ROOM_NAMES = new Set(['AF-02', 'AF-31', 'AS-31', 'BG-26']);

    function isPermanentRoom(info) {
        if (!info) return false;
        const roomName = String(info.room_no || info.name || '').trim().toUpperCase();
        return !!info.is_permanent || PERMANENT_ROOM_NAMES.has(roomName);
    }
    const role = JSON.parse((document.getElementById('roleData') || {}).textContent || '');

    let currentBlock = null;
    let currentFloor = null;
    let selected = { room_no: null, block: null, floor: null };

    const lockModalEl = document.getElementById('lockModal');
    const lockModal = lockModalEl ? new bootstrap.Modal(lockModalEl) : null;

    const unappliedModalEl = document.getElementById('unappliedStudentsModal');
    const unappliedModal = unappliedModalEl ? new bootstrap.Modal(unappliedModalEl) : null;
    const unappliedListEl = document.getElementById('unappliedStudentsList');
    const unappliedSearchEl = document.getElementById('unappliedSearchInput');
    const unappliedBadgeEl = document.getElementById('unappliedCountBadge');

    function uniq(arr){ return Array.from(new Set(arr)); }

    function initTabs(){
        if (!rooms || !rooms.length) return;
        const blocks = uniq(rooms.map(r => (r.block || '').trim()).filter(Boolean)).sort();
        const blockTabs = document.getElementById('blockTabs');
        if (!blockTabs) return;
        blockTabs.innerHTML = '';
        blocks.forEach((b, idx) => {
            const active = idx === 0 ? 'active' : '';
            blockTabs.innerHTML += `<li class="nav-item"><button class="nav-link ${active}" onclick="switchBlock('${b}', this)">Block ${b}</button></li>`;
        });
        currentBlock = blocks[0] || 'A';
        renderFloors();
    }

    const paymentModalEl = document.getElementById('paymentModal');
    const paymentModal = paymentModalEl ? new bootstrap.Modal(paymentModalEl) : null;

    const transferModalEl = document.getElementById('transferModal');
    const transferModal = transferModalEl ? new bootstrap.Modal(transferModalEl) : null;
    const transferStudentTextEl = document.getElementById('transferStudentText');
    const transferCurrentTextEl = document.getElementById('transferCurrentText');
    const transferBookingIdEl = document.getElementById('t_booking_id');
    const transferFloorEl = document.getElementById('t_floor');
    const transferBlockSel = document.getElementById('t_block');
    const transferRoomSel = document.getElementById('t_room');
    const transferBedSel = document.getElementById('t_bed');
    const transferRoomGroups = buildTransferRoomGroups();

    function openPaymentModal(id, uid) {
        const idField = document.getElementById('p_booking_id');
        const textField = document.getElementById('payStudentText');
        if(idField) idField.value = id;
        if(textField) textField.innerText = 'UID: ' + uid;
        if(paymentModal) paymentModal.show();
    }

    function buildTransferRoomGroups() {
        const map = {};
        rooms.forEach(r => {
            const roomNo = (r.room_no || '').trim();
            const block = (r.block || '').trim();
            const floor = (r.floor || '').trim();
            if (!roomNo || !block || !floor) return;
            const key = [roomNo, block, floor].join('||');
            if (!map[key]) map[key] = [];
            map[key].push(r);
        });
        return map;
    }

    function getTransferBeds(group) {
        const items = Array.isArray(group) ? group : [];
        const info = items[0] || {};
        const capacity = parseInt(info.capacity, 10) || 1;
        const occupied = items
            .map(r => ((r.booked_bed || '') + '').trim().toUpperCase())
            .filter(Boolean);
        const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
        const beds = [];
        for (let i = 0; i < capacity; i++) {
            const letter = letters[i] || String.fromCharCode(65 + i);
            if (!occupied.includes(letter)) beds.push(letter);
        }
        return beds;
    }

    function populateTransferBlocks(defaultBlock) {
        if (!transferBlockSel) return;
        const blocks = uniq(rooms.map(r => (r.block || '').trim()).filter(Boolean)).sort();
        transferBlockSel.innerHTML = '<option value="">-- Select Block --</option>';
        blocks.forEach(block => {
            const opt = document.createElement('option');
            opt.value = block;
            opt.textContent = 'Block ' + block;
            transferBlockSel.appendChild(opt);
        });
        if (defaultBlock) transferBlockSel.value = defaultBlock;
    }

    function populateTransferRooms() {
        if (!transferBlockSel || !transferRoomSel || !transferBedSel) return;
        const block = transferBlockSel.value;
        transferRoomSel.innerHTML = '<option value="">-- Select Room --</option>';
        transferBedSel.innerHTML = '<option value="">-- Select Bed --</option>';
        if (transferFloorEl) transferFloorEl.value = '';
        if (!block) return;

        Object.entries(transferRoomGroups)
            .filter(([, group]) => ((group[0] || {}).block || '').trim() === block)
            .sort((a, b) => {
                const ai = a[1][0] || {};
                const bi = b[1][0] || {};
                const roomCmp = String(ai.room_no || '').localeCompare(String(bi.room_no || ''), undefined, { numeric: true, sensitivity: 'base' });
                if (roomCmp !== 0) return roomCmp;
                return String(ai.floor || '').localeCompare(String(bi.floor || ''), undefined, { numeric: true, sensitivity: 'base' });
            })
            .forEach(([key, group]) => {
                const info = group[0] || {};
                const beds = getTransferBeds(group);
                if (!beds.length) return;
                if (isPermanentRoom(info)) return;
                const opt = document.createElement('option');
                opt.value = info.room_no || '';
                opt.dataset.room = info.room_no || '';
                opt.dataset.floor = info.floor || '';
                opt.dataset.block = info.block || '';
                opt.dataset.key = key;
                opt.textContent = 'Room ' + (info.room_no || '--') + ' (' + (info.floor || '--') + ') - ' + beds.length + ' bed' + (beds.length > 1 ? 's' : '') + ' free';
                transferRoomSel.appendChild(opt);
            });
    }

    function populateTransferBeds() {
        if (!transferRoomSel || !transferBedSel) return;
        const selectedOpt = transferRoomSel.selectedOptions && transferRoomSel.selectedOptions[0];
        const roomName = transferRoomSel.value;
        transferBedSel.innerHTML = '<option value="">-- Select Bed --</option>';
        if (!roomName || !selectedOpt) {
            if (transferFloorEl) transferFloorEl.value = '';
            return;
        }
        if (transferFloorEl) transferFloorEl.value = selectedOpt.dataset.floor || '';
        const key = [roomName, transferBlockSel ? transferBlockSel.value : '', selectedOpt.dataset.floor || ''].join('||');
        const group = transferRoomGroups[key] || [];
        const beds = getTransferBeds(group);
        beds.forEach(letter => {
            const opt = document.createElement('option');
            opt.value = letter;
            opt.textContent = 'Bed ' + letter;
            transferBedSel.appendChild(opt);
        });
    }

    function openTransferModal(id, uid, studentName, roomNo, block, floor, bedNo, paymentStatus) {
        if (!transferModal) return;
        if (transferBookingIdEl) transferBookingIdEl.value = id;
        if (transferStudentTextEl) {
            transferStudentTextEl.innerText = (studentName ? studentName + ' (' + uid + ')' : ('UID: ' + uid));
        }
        if (transferCurrentTextEl) {
            transferCurrentTextEl.innerText = `${block} - ${floor} - Room ${roomNo} (Bed ${bedNo || '--'}) ${paymentStatus ? '[' + String(paymentStatus).toUpperCase() + ']' : ''}`;
        }
        populateTransferBlocks(block);
        populateTransferRooms();
        if (transferFloorEl) transferFloorEl.value = '';
        transferModal.show();
    }

    function confirmTransferBooking() {
        if (!transferBlockSel || !transferRoomSel || !transferBedSel) return false;
        if (!transferBlockSel.value || !transferRoomSel.value || !transferFloorEl.value || !transferBedSel.value) {
            alert('Please choose a new block, room, and bed.');
            return false;
        }
        return confirm('Transfer this booking to the selected room and bed?');
    }

    document.addEventListener('click', function (event) {
        const btn = event.target.closest('.js-transfer-btn');
        if (!btn) return;
        openTransferModal(
            btn.dataset.bookingId || '',
            btn.dataset.uid || '',
            btn.dataset.name || '',
            btn.dataset.room || '',
            btn.dataset.block || '',
            btn.dataset.floor || '',
            btn.dataset.bed || '',
            btn.dataset.status || ''
        );
    });

    function escapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function renderUnappliedStudents(students) {
        const arr = Array.isArray(students) ? students : [];
        if (unappliedBadgeEl) unappliedBadgeEl.innerText = String(arr.length);

        if (!unappliedListEl) return;
        if (!arr.length) {
            unappliedListEl.innerHTML = '<div class="list-group-item text-muted">No hostel students found without a room booking.</div>';
            return;
        }

        unappliedListEl.innerHTML = arr.map(s => {
            const safeName = escapeHtml(s.sname || '--');
            const safeUid = escapeHtml(s.uid || '--');
            return `
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold">${safeName}</div>
                        <div class="text-muted small">UID: ${safeUid}</div>
                    </div>
                    <span class="badge bg-secondary">Hostel</span>
                </div>
            `;
        }).join('');
    }

    function fetchUnappliedStudents(term) {
        if (!unappliedListEl) return;
        const enc = encodeURIComponent(term || '');
        unappliedListEl.innerHTML = '<div class="list-group-item text-muted">Loading...</div>';
        fetch(`/api/admin/roombookings/unapplied-students?term=${enc}`, { credentials: 'same-origin' })
            .then(res => {
                if (!res.ok) throw new Error('Request failed');
                const ct = res.headers.get('content-type');
                if (!ct || !ct.includes('application/json')) throw new Error('Invalid response');
                return res.json();
            })
            .then(rows => renderUnappliedStudents(Array.isArray(rows) ? rows : []))
            .catch(() => {
                if (unappliedListEl) {
                    unappliedListEl.innerHTML = '<div class="list-group-item text-danger">Could not load hostel students.</div>';
                }
            });
    }

    function openUnappliedStudentsModal() {
        if (!unappliedModal) return;
        if (unappliedSearchEl) unappliedSearchEl.value = '';
        fetchUnappliedStudents('');
        unappliedModal.show();
    }

    function switchBlock(b, el){
        currentBlock = b;
        document.querySelectorAll('#blockTabs .nav-link').forEach(x => x.classList.remove('active'));
        if (el) el.classList.add('active');
        renderFloors();
    }

    function renderFloors(){
        const floors = uniq(rooms.filter(r => (r.block || '').trim() === currentBlock)
            .map(r => (r.floor || '').trim()).filter(Boolean));

        const floorPills = document.getElementById('floorPills');
        if (!floorPills) return;
        floorPills.innerHTML = '';
        floors.forEach((f, idx) => {
            const active = idx === 0 ? 'active' : '';
            floorPills.innerHTML += `<li class="nav-item"><button class="nav-link ${active}" onclick="switchFloor('${f}', this)">${f}</button></li>`;
        });
        currentFloor = floors[0] || 'Ground Floor';
        renderGrid();
    }

    function switchFloor(f, el){
        currentFloor = f;
        document.querySelectorAll('#floorPills .nav-link').forEach(x => x.classList.remove('active'));
        if (el) el.classList.add('active');
        renderGrid();
    }

    function groupByRoom(list){
        const g = {};
        list.forEach(r => {
            const key = (r.room_no || '').toString();
            if (!g[key]) g[key] = [];
            g[key].push(r);
        });
        return g;
    }

    function compareBookingFreshness(a, b) {
        const aTime = new Date(a && (a.booked_at || a.created_at) ? (a.booked_at || a.created_at) : 0).getTime();
        const bTime = new Date(b && (b.booked_at || b.created_at) ? (b.booked_at || b.created_at) : 0).getTime();
        if (aTime !== bTime) return bTime - aTime;

        const aId = parseInt(a && a.booking_id ? a.booking_id : a && a.id ? a.id : 0, 10) || 0;
        const bId = parseInt(b && b.booking_id ? b.booking_id : b && b.id ? b.id : 0, 10) || 0;
        return bId - aId;
    }

    function renderGrid(){
        const container = document.getElementById('roomsContainer');
        if (!container) return;
        container.innerHTML = '';
        const title = document.getElementById('gridTitle');
        if (title) title.innerText = `Rooms: ${currentBlock} - ${currentFloor}`;

        const subset = rooms.filter(r => (r.block || '').trim() === currentBlock && (r.floor || '').trim() === currentFloor);
        const grouped = groupByRoom(subset);

        Object.keys(grouped).sort().forEach(roomNo => {
            const items = grouped[roomNo];
            const info = items[0] || {};
            const capacity = parseInt(info.capacity) || 1;
            
            let bedsHtml = '';
            const allLetters = ['A', 'B', 'C', 'D', 'E', 'F'];
            
            for (let i = 0; i < capacity; i++) {
                const bedLetter = allLetters[i] || String.fromCharCode(65 + i);
                
                // Find if this specific bed is booked
                const booking = items
                    .filter(b => (b.booked_bed || '').trim().toUpperCase() === bedLetter && b.booked_uid)
                    .sort(compareBookingFreshness)[0];
                
                if (booking) {
                    const bookedBy = (booking.booked_name && booking.booked_uid) 
                        ? `${booking.booked_name.split(' ')[0]} (${booking.booked_uid})` 
                        : (booking.booked_name || booking.booked_uid || 'Booked');
                    const isNewUid = /^BH/i.test(((booking.booked_uid || '') + '').trim());
                    const paymentStatus = String(booking.payment_status || '').trim().toLowerCase();
                    const boxClass = isNewUid
                        ? 'room-booked-new'
                        : (paymentStatus === 'pending' ? 'room-booked-pending' : 'room-booked');
                    const labelText = isNewUid ? 'NEW ADMISSION' : (paymentStatus === 'pending' ? 'PENDING' : 'CONFIRMED');

                    bedsHtml += `
                        <div class="col-${12 / Math.min(capacity, 3)}">
                            <div class="room-box ${boxClass} room-disabled" style="height: 80px; padding: 5px;">
                                <div class="room-no" style="font-size: 0.8rem;">Bed ${bedLetter}</div>
                                <div class="fw-bold mt-1" style="font-size: 0.8rem; text-align: center; word-break: break-all;">${bookedBy}</div>
                                <div class="small mt-1" style="font-size: 0.62rem; font-weight: 700;">${labelText}</div>
                            </div>
                        </div>`;
                } else if (info.is_permanent) {
                    const desc = info.description || 'PERMANENT';
                    bedsHtml += `
                        <div class="col-${12 / Math.min(capacity, 3)}">
                            <div class="room-box bg-secondary text-white room-disabled" style="height: 80px; padding: 5px; border-color: #555;">
                                <div class="room-no" style="font-size: 0.8rem;">Bed ${bedLetter}</div>
                                <div class="fw-bold mt-1" style="font-size: 0.75rem; text-align: center; word-break: break-all;">${desc}</div>
                            </div>
                        </div>`;
                } else {
                    const canLock = (role === 'SuperID');
                    const clickAttr = canLock ? `onclick="selectRoom('${roomNo}','${info.block}','${info.floor}','${bedLetter}')"` : '';
                    bedsHtml += `
                        <div class="col-${12 / Math.min(capacity, 3)}">
                            <div class="room-box room-available" style="height: 80px; padding: 5px;" ${clickAttr}>
                                <div class="room-no" style="font-size: 0.8rem;">Bed ${bedLetter}</div>
                                <div class="text-white small mt-1" style="font-size: 0.65rem;">${role === 'SuperID' ? 'LOCK' : 'AVAIL'}</div>
                            </div>
                        </div>`;
                }
            }

            const meta = `${info.room_type || ''} • Cap ${info.capacity || ''}`.trim();

            container.innerHTML += `
                <div class="col-md-6 col-lg-4">
                    <div class="room-card">
                        <div class="room-header text-center d-flex justify-content-between align-items-center">
                            <span>Room ${roomNo}</span>
                            <span class="badge bg-secondary" style="font-size: 0.65rem;">${meta}</span>
                        </div>
                        <div class="row g-2 pt-1">
                            ${bedsHtml}
                        </div>
                    </div>
                </div>
            `;
        });
    }

    function selectRoom(room_no, block, floor, bed_no){
        if (role !== 'SuperID') return;
        selected = { room_no, block, floor, bed_no };
        const text = document.getElementById('adminSelRoomText');
        if (text) text.innerText = `${block} - ${floor} - Room ${room_no} (Bed ${bed_no})`;
        const roomEl = document.getElementById('a_room_no');
        const bedEl = document.getElementById('a_bed_no');
        const blockEl = document.getElementById('a_block');
        const floorEl = document.getElementById('a_floor');
        if (roomEl) roomEl.value = room_no;
        if (bedEl) bedEl.value = bed_no;
        if (blockEl) blockEl.value = block;
        if (floorEl) floorEl.value = floor;
        const uidEl = document.getElementById('a_uid');
        const amtEl = document.getElementById('a_amount');
        const txnEl = document.getElementById('a_txn');
        const agreeEl = document.getElementById('a_agree_check');
        if (uidEl) uidEl.value = '';
        if (amtEl) amtEl.value = '';
        if (txnEl) txnEl.value = '';
        if (agreeEl) agreeEl.checked = false;
        if (lockModal) lockModal.show();
    }

    function submitAdminLock(){
        if (role !== 'SuperID') return false;
        const uid = ((document.getElementById('a_uid') || {}).value || '').trim();
        if (!uid) {
            alert('Please enter student UID');
            return false;
        }
        const agreed = !!(document.getElementById('a_agree_check') || {}).checked;
        if (!agreed) {
            alert('Please confirm agreement accepted.');
            return false;
        }
        const amtRaw = ((document.getElementById('a_amount') || {}).value || '').trim();
        const txn = ((document.getElementById('a_txn') || {}).value || '').trim();
        if (amtRaw) {
            const amt = parseFloat(amtRaw);
            if (isNaN(amt)) {
                alert('Advance amount must be a valid number.');
                return false;
            }
            if (!txn) {
                alert('Transaction ID is required when advance amount is provided.');
                return false;
            }
        }
        const a = document.getElementById('a_agreement');
        if (a) a.value = 'true';
        return confirm('Lock this room for the student?');
    }

    function filterTable() {
        const input = document.getElementById("searchInput");
        if (!input) return;
        const filter = input.value.toLowerCase();
        const tbody = document.querySelector(".table tbody");
        if (!tbody) return;
        const trs = tbody.getElementsByTagName("tr");

        for (let i = 0; i < trs.length; i++) {
            // Skip the "No locked bookings found" row if present
            if (trs[i].getElementsByTagName("td").length === 1) continue;
            
            const tds = trs[i].getElementsByTagName("td");
            let match = false;
            for (let j = 0; j < tds.length; j++) {
                if (tds[j]) {
                    const txtValue = tds[j].textContent || tds[j].innerText;
                    if (txtValue.toLowerCase().indexOf(filter) > -1) {
                        match = true;
                        break;
                    }
                }
            }
            trs[i].style.display = match ? "" : "none";
        }
    }

    if (unappliedSearchEl) {
        unappliedSearchEl.addEventListener('input', e => fetchUnappliedStudents(e.target.value));
    }

    window.onload = initTabs;
</script>
</body>
</html>
