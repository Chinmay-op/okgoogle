<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restriction Audit - Admin Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/stylesheets/hostelpanel.css">
  <link rel="icon" href="/images/4174.png">
  <style>
    html, body {
      overflow-x: hidden;
      background-color: #f4f7fb;
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
      font-size: 14px;
      color: #1e293b;
      min-height: 100vh;
      padding-bottom: 30px;
    }
    .page-wrap {
      width: 100%;
      max-width: 100%;
      margin: 16px auto;
      padding: 0 16px;
    }
    .card-audit {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 14px;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
      overflow: hidden;
      width: 100%;
    }
    .header-bar {
      padding: 16px 20px;
      background: #ffffff;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    .header-title-group h1 {
      margin: 0;
      font-size: 22px;
      font-weight: 700;
      color: #0f172a;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .header-title-group p {
      margin: 4px 0 0 0;
      font-size: 13px;
      color: #64748b;
    }
    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    
    /* Toggle Switch Pill */
    .filter-switch-group {
      background: #f1f5f9;
      padding: 3px;
      border-radius: 10px;
      display: inline-flex;
      border: 1px solid #cbd5e1;
    }
    .filter-switch-btn {
      border: none;
      background: transparent;
      padding: 6px 14px;
      font-size: 12.5px;
      font-weight: 700;
      color: #64748b;
      border-radius: 7px;
      transition: all 0.2s ease;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .filter-switch-btn.active {
      background: #ffffff;
      color: #2563eb;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }
    .filter-switch-btn:hover:not(.active) {
      color: #1e293b;
      background: rgba(255, 255, 255, 0.5);
    }

    .search-wrap {
      position: relative;
      width: 240px;
    }
    .search-wrap i {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      font-size: 13px;
    }
    .search-input {
      padding-left: 34px;
      height: 38px;
      font-size: 13px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
    }
    .search-input:focus {
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }
    .badge-meta {
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 12.5px;
      font-weight: 600;
      background: #f1f5f9;
      color: #334155;
      border: 1px solid #e2e8f0;
    }
    .table-container {
      width: 100%;
      overflow-x: hidden;
    }
    .audit-table {
      width: 100%;
      table-layout: fixed;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 13.5px;
    }
    .audit-table th {
      background: #f8fafc;
      color: #334155;
      font-size: 12.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      padding: 12px 8px;
      border-bottom: 2px solid #cbd5e1;
      vertical-align: middle;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
    .audit-table td {
      padding: 10px 8px;
      border-bottom: 1px solid #e2e8f0;
      vertical-align: middle;
      color: #1e293b;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
    .audit-table tbody tr:hover td {
      background-color: #f8fafc;
    }
    .uid-link {
      font-weight: 700;
      font-size: 13.5px;
      color: #2563eb;
      text-decoration: none;
    }
    .uid-link:hover {
      color: #1d4ed8;
      text-decoration: underline;
    }
    .log-link {
      font-weight: 600;
      font-size: 12.5px;
      color: #0284c7;
      background: #f0f9ff;
      padding: 3px 7px;
      border-radius: 5px;
      border: 1px solid #bae6fd;
      text-decoration: none;
      display: inline-block;
    }
    .log-link:hover {
      background: #e0f2fe;
      color: #0369a1;
    }
    
    /* Badges */
    .badge-pt {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 14px;
      font-size: 11.5px;
      font-weight: 700;
      line-height: 1.2;
    }
    .badge-city {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fca5a5;
    }
    .badge-home {
      background: #dcfce7;
      color: #166534;
      border: 1px solid #86efac;
    }
    .badge-src {
      display: inline-block;
      padding: 4px 7px;
      border-radius: 6px;
      font-size: 11.5px;
      font-weight: 600;
      background: #e0e7ff;
      color: #3730a3;
      border: 1px solid #c7d2fe;
      line-height: 1.2;
    }
    .badge-src-sweep {
      background: #ede9fe;
      color: #5b21b6;
      border-color: #ddd6fe;
    }
    .badge-src-scan {
      background: #e0f2fe;
      color: #075985;
      border-color: #bae6fd;
    }
    .badge-src-backfill {
      background: #fef3c7;
      color: #92400e;
      border-color: #fde68a;
    }
    .badge-reason {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      background: #fff7ed;
      color: #9a3412;
      border: 1px solid #ffedd5;
      line-height: 1.3;
    }
    .status-pill {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 7px;
      border-radius: 5px;
      text-transform: uppercase;
      display: inline-block;
    }
    .status-active {
      background: #dcfce7;
      color: #15803d;
    }
    .status-dead {
      background: #f1f5f9;
      color: #64748b;
    }
    
    .timestamp-cell {
      font-size: 12.5px;
      font-weight: 500;
      color: #334155;
      line-height: 1.25;
    }
    .empty-row {
      padding: 50px 20px;
      text-align: center;
      color: #64748b;
      font-size: 15px;
    }
  </style>
</head>
<body>

<%
  // Extract ISO YYYY-MM-DD from Date / String
  function getISODateStr(val) {
    if (!val) return '';
    if (val instanceof Date) {
      var d = val;
      var y = d.getFullYear();
      var m = String(d.getMonth() + 1).padStart(2, '0');
      var day = String(d.getDate()).padStart(2, '0');
      return y + '-' + m + '-' + day;
    }
    var s = String(val).trim();
    var match = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (match) return match[1] + '-' + match[2] + '-' + match[3];
    var parsed = new Date(s);
    if (!isNaN(parsed.getTime())) {
      var y = parsed.getFullYear();
      var m = String(parsed.getMonth() + 1).padStart(2, '0');
      var day = String(parsed.getDate()).padStart(2, '0');
      return y + '-' + m + '-' + day;
    }
    return '';
  }

  // Compact date formatter (stacks date and time vertically)
  function formatCompactDate(val) {
    if (!val) return '<span class="text-muted">N/A</span>';
    var d = null;
    if (val instanceof Date) {
      d = val;
    } else {
      var s = String(val).trim();
      if (!s || s === 'N/A') return '<span class="text-muted">N/A</span>';
      
      var m = s.match(/^(\d{4})-(\d{2})-(\d{2})[T\s](\d{2}):(\d{2})(?::(\d{2}))?/);
      if (m) {
        var year = m[1];
        var monthIdx = parseInt(m[2], 10) - 1;
        var day = m[3];
        var hours = parseInt(m[4], 10);
        var minutes = m[5];
        var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var monthName = months[monthIdx] || m[2];
        var ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12;
        hours = hours ? hours : 12;
        var formattedHours = String(hours).padStart(2, '0');
        return '<div class="lh-sm"><span>' + day + ' ' + monthName + ' ' + year + '</span><br><small class="text-muted" style="font-size:11px;">' + formattedHours + ':' + minutes + ' ' + ampm + '</small></div>';
      }
      
      var parsed = new Date(s);
      if (!isNaN(parsed.getTime())) {
        d = parsed;
      } else {
        return s;
      }
    }
    
    if (d) {
      var day = String(d.getDate()).padStart(2, '0');
      var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      var monthName = months[d.getMonth()];
      var year = d.getFullYear();
      var hours = d.getHours();
      var minutes = String(d.getMinutes()).padStart(2, '0');
      var ampm = hours >= 12 ? 'PM' : 'AM';
      hours = hours % 12;
      hours = hours ? hours : 12;
      var formattedHours = String(hours).padStart(2, '0');
      return '<div class="lh-sm"><span>' + day + ' ' + monthName + ' ' + year + '</span><br><small class="text-muted" style="font-size:11px;">' + formattedHours + ':' + minutes + ' ' + ampm + '</small></div>';
    }
    
    return String(val);
  }

  // Format reason string to human friendly text
  function formatReasonText(reason) {
    if (!reason) return 'N/A';
    var r = String(reason);
    var map = {
      'hostel_scan_after_10pm': 'Hostel In Scan After 10 PM',
      'scanned_after_10pm': 'Hostel In Scan After 10 PM',
      'no_scan_before_10pm_city_pass': 'City Pass - No Return by Midnight',
      'no_scan_before_10pm_home_pass': 'Home Pass - No Hostel Scan',
      'no_scan_before_10pm': 'No Scan Before 10 PM',
      'midnight_sweep_city_pass_no_return': 'City Pass - No Return by Midnight',
      'midnight_sweep_home_pass_no_hostel_scan': 'Home Pass - No Hostel Scan',
      'midnight_sweep_home_pass_late_hostel_scan': 'Hostel In Scan After 10 PM',
      'midnight_sweep_post_10pm': 'Midnight Sweep Post-10 PM Rule',
      'post_10pm_rule': 'Post-10 PM Rule Enforced',
      'city_pass_after_10pm': 'City Pass Active After 10 PM',
      'home_pass_no_hostel_scan_after_10pm': 'Home Pass - Missing Hostel Scan'
    };
    if (map[r]) return map[r];
    return r.replace(/_/g, ' ').replace(/\b\w/g, function(l){ return l.toUpperCase(); });
  }

  // Format source badge text and class
  function getSourceBadge(source) {
    if (!source) return { text: 'System', class: 'badge-src' };
    var s = String(source);
    if (s === 'midnight_sweep') return { text: 'Midnight Sweep', class: 'badge-src badge-src-sweep' };
    if (s === 'hostel_scan') return { text: 'Hostel Scan', class: 'badge-src badge-src-scan' };
    if (s.startsWith('backfill')) return { text: 'Backfill (July)', class: 'badge-src badge-src-backfill' };
    if (s === 'student_session') return { text: 'Student Session', class: 'badge-src' };
    return { text: s.replace(/_/g, ' ').replace(/\b\w/g, function(l){ return l.toUpperCase(); }), class: 'badge-src' };
  }

  // Safe details formatter avoiding [object Object]
  function formatDetailsData(detailsObj) {
    if (!detailsObj) return '';
    if (typeof detailsObj === 'object') {
      try {
        return JSON.stringify(detailsObj, null, 2);
      } catch (e) {
        return String(detailsObj);
      }
    }
    var str = String(detailsObj).trim();
    if (!str) return '';
    try {
      var obj = JSON.parse(str);
      return JSON.stringify(obj, null, 2);
    } catch (e) {
      return str;
    }
  }
%>

  <div class="page-wrap">
    <div class="card-audit">
      <div class="header-bar">
        <div class="header-title-group">
          <h1>
            <i class="fas fa-shield-halved text-primary"></i>
            Restriction Audit
          </h1>
          <p id="headerSubtext">Showing all active restrictions</p>
        </div>
        <div class="header-actions">
          <div class="search-wrap">
            <i class="fas fa-search"></i>
            <input type="text" id="auditSearch" onkeyup="filterAuditTable()" class="form-control search-input" placeholder="Search UID, Name, Reason, Pass...">
          </div>
          
          <span class="badge-meta"><i class="fas fa-user-shield me-1"></i> Role: <strong><%= role %></strong></span>
          <span class="badge-meta"><i class="fas fa-list me-1"></i> Total: <strong id="rowCountBadge"><%= result.length %></strong></span>
          
          <a href="/daterange" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-bold" style="border-radius: 8px;">
            <i class="fas fa-arrow-left me-1"></i> Back to Panel
          </a>
        </div>
      </div>

      <% if (message && message.length) { %>
        <div class="alert alert-danger m-3 mb-0 border-0 shadow-sm">
          <i class="fas fa-exclamation-circle me-2"></i><%= message %>
        </div>
      <% } %>

      <div class="table-container">
        <table class="audit-table" id="auditTable">
          <thead>
            <tr>
              <th style="width: 2.5%; text-align: center;">#</th>
              <th style="width: 10.5%;">Restricted At</th>
              <th style="width: 6.5%;">UID</th>
              <th style="width: 12.5%;">Student Name</th>
              <th style="width: 7.5%;">Pass Type</th>
              <th style="width: 8.5%;">Source</th>
              <th style="width: 15%;">Restriction Reason</th>
              <th style="width: 5.5%; text-align: center;">Log ID</th>
              <th style="width: 8.5%;">Approval</th>
              <th style="width: 8.5%;">Gate Out</th>
              <th style="width: 5.5%;">Hostel In</th>
              <th style="width: 4.5%; text-align: center;">Status</th>
              <th style="width: 4.5%; text-align: center;">Details</th>
            </tr>
          </thead>
          <tbody>
            <% if (result && result.length > 0) { %>
              <% result.forEach(function(row, index) { %>
                <tr data-approval-date="<%= getISODateStr(row.approvaldt) %>"
                    data-restricted-date="<%= getISODateStr(row.restricted_at) %>"
                    data-hostelin-date="<%= getISODateStr(row.hostelintime) %>">
                  
                  <td style="text-align: center; font-weight: 600; color: #64748b;"><%= index + 1 %></td>
                  
                  <td class="timestamp-cell">
                    <%- formatCompactDate(row.restricted_at) %>
                  </td>
                  
                  <td>
                    <a href="/studentprofile/<%= row.uid %>" class="uid-link">
                      <%= row.uid || 'N/A' %>
                    </a>
                  </td>
                  
                  <td style="font-weight: 600; color: #0f172a;">
                    <%= row.sname || 'N/A' %>
                  </td>
                  
                  <td>
                    <% var pt = (row.passtype || '').toLowerCase(); %>
                    <% if (pt === 'city pass') { %>
                      <span class="badge-pt badge-city">City Pass</span>
                    <% } else if (pt === 'home pass') { %>
                      <span class="badge-pt badge-home">Home Pass</span>
                    <% } else { %>
                      <span class="badge-pt badge-home"><%= row.passtype || 'N/A' %></span>
                    <% } %>
                  </td>
                  
                  <td>
                    <% var srcInfo = getSourceBadge(row.restriction_source); %>
                    <span class="<%= srcInfo.class %>"><%= srcInfo.text %></span>
                  </td>
                  
                  <td>
                    <span class="badge-reason">
                      <%= formatReasonText(row.restriction_reason) %>
                    </span>
                  </td>
                  
                  <td style="text-align: center;">
                    <% if (row.logid) { %>
                      <a href="/codescanner/<%= row.uid %>?back=<%= encodeURIComponent('/restrictionaudit') %>" class="log-link">
                        #<%= row.logid %>
                      </a>
                    <% } else { %>
                      <span class="text-muted">N/A</span>
                    <% } %>
                  </td>
                  
                  <td class="timestamp-cell"><%- formatCompactDate(row.approvaldt) %></td>
                  <td class="timestamp-cell"><%- formatCompactDate(row.outdatetime) %></td>
                  <td class="timestamp-cell"><%- formatCompactDate(row.hostelintime) %></td>
                  
                  <td style="text-align: center;">
                    <% var st = (row.log_status || '').toUpperCase(); %>
                    <% if (st === 'ACTIVE') { %>
                      <span class="status-pill status-active">ACTIVE</span>
                    <% } else { %>
                      <span class="status-pill status-dead"><%= st || 'N/A' %></span>
                    <% } %>
                  </td>
                  
                  <td style="text-align: center;">
                    <% var detText = formatDetailsData(row.details); %>
                    <% if (detText && detText.trim().length > 0) { %>
                      <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11.5px; border-radius: 5px;"
                        onclick="viewDetails(<%= index %>)">
                        <i class="fas fa-eye me-1"></i>View
                      </button>
                    <% } else { %>
                      <span class="text-muted small">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr id="noRecordsRow">
                <td colspan="13" class="empty-row">
                  <i class="fas fa-clipboard-check fa-2x mb-3 text-muted d-block"></i>
                  No restriction audit records found.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Audit Details Modal -->
  <div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg" style="border-radius: 14px; overflow: hidden;">
        <div class="modal-header py-3 px-3 bg-light border-bottom">
          <h5 class="modal-title fw-bold text-dark mb-0 d-flex align-items-center gap-2 fs-4">
            <i class="fas fa-file-invoice text-primary"></i>
            <span>Restriction Pass Snapshot</span>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-3" id="modalDetailsContent">
          <!-- Rendered formatted key-value pairs -->
        </div>
        <div class="modal-footer bg-light py-2 px-3 border-top-0">
          <button type="button" class="btn btn-sm btn-secondary fw-bold" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    var auditRowData = <%- JSON.stringify(result.map(function(r) {
      var detailsObj = {};
      if (r.details) {
        try {
          detailsObj = typeof r.details === 'object' ? r.details : JSON.parse(r.details);
        } catch(e) { detailsObj = {}; }
      }
      return {
        logid: r.logid,
        reason: r.restriction_reason || '',
        details: detailsObj
      };
    })) %>;
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      try {
        localStorage.setItem('restriction_audit_last_visited', Date.now().toString());
      } catch (e) {
        console.error('Failed to set restriction audit visited timestamp:', e);
      }
      filterAuditTable();
    });

    function filterAuditTable() {
      var searchInput = document.getElementById("auditSearch");
      var textFilter = searchInput.value.toUpperCase();
      var table = document.getElementById("auditTable");
      var tr = table.getElementsByTagName("tr");

      var visibleCount = 0;

      for (var i = 1; i < tr.length; i++) {
        var row = tr[i];
        if (row.id === 'noRecordsRow') continue;

        var rowText = row.textContent || row.innerText;
        var matchesSearch = rowText.toUpperCase().indexOf(textFilter) > -1;

        if (matchesSearch) {
          row.style.display = "";
          visibleCount++;
        } else {
          row.style.display = "none";
        }
      }

      var countBadge = document.getElementById("rowCountBadge");
      if (countBadge) {
        countBadge.textContent = visibleCount;
      }
    }

    function formatDetailVal(label, val) {
      if (!val || val === 'null' || val === 'N/A' || val === 'undefined') {
        return '<span class="text-muted">Not Recorded / N/A</span>';
      }
      
      var s = String(val).trim();
      if (!s) return '<span class="text-muted">Not Recorded / N/A</span>';

      // Check if value is a date format YYYY-MM-DD HH:MM:SS or ISO
      var m = s.match(/^(\d{4})-(\d{2})-(\d{2})[T\s](\d{2}):(\d{2})(?::(\d{2}))?/);
      if (m) {
        var year = m[1];
        var monthIdx = parseInt(m[2], 10) - 1;
        var day = m[3];
        var hours = parseInt(m[4], 10);
        var minutes = m[5];
        var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var monthName = months[monthIdx] || m[2];
        var ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12;
        hours = hours ? hours : 12;
        var formattedHours = String(hours).padStart(2, '0');
        return day + ' ' + monthName + ' ' + year + ', ' + formattedHours + ':' + minutes + ' ' + ampm;
      }

      if (label.toLowerCase().includes('status')) {
        var st = s.toUpperCase();
        var badgeCls = st === 'ACTIVE' ? 'bg-success' : 'bg-secondary';
        return '<span class="badge ' + badgeCls + '">' + st + '</span>';
      }

      return s;
    }

    function viewDetails(index) {
      try {
        var rowData = auditRowData[index];
        if (!rowData) { alert('Details not available'); return; }
        var logid = rowData.logid;
        var reason = rowData.reason;
        var detailsObj = rowData.details || {};

        // Store context for button callbacks
        window._auditCtx = { logid: logid, reason: reason };

        var labelMap = {
          'approvaldt': { label: 'Approval Time', icon: 'far fa-calendar-check' },
          'outdatetime': { label: 'Gate Out Time', icon: 'fas fa-door-open' },
          'indatetime': { label: 'Gate In (Return) Time', icon: 'fas fa-door-closed' },
          'hostelintime': { label: 'Hostel In Time', icon: 'fas fa-building-user' },
          'log_status': { label: 'Pass Status', icon: 'fas fa-info-circle' },
          'status': { label: 'Pass Status', icon: 'fas fa-info-circle' }
        };

        var keys = Object.keys(detailsObj);
        var html = '<div class="card border-0 bg-light p-3 mb-0" style="border-radius: 12px; font-size: 1.05rem;">';

        if (keys.length === 0) {
          html += '<div class="text-center text-muted py-3">No additional details recorded.</div>';
        } else {
          keys.forEach(function(k) {
            var info = labelMap[k] || { 
              label: k.replace(/_/g, ' ').replace(/\b\w/g, function(l){ return l.toUpperCase(); }), 
              icon: 'fas fa-angle-right' 
            };
            var formattedVal = formatDetailVal(info.label, detailsObj[k]);

            html += '<div class="d-flex align-items-center justify-content-between py-3 px-2 border-bottom">' +
                      '<div class="d-flex align-items-center gap-2 text-secondary fw-semibold" style="font-size: 15px;">' +
                        '<i class="' + info.icon + ' text-primary fs-5" style="width: 24px;"></i>' +
                        '<span>' + info.label + '</span>' +
                      '</div>' +
                      '<div class="fw-bold text-dark text-end" style="font-size: 15px;">' + formattedVal + '</div>' +
                    '</div>';
          });
        }
        html += '</div>';

        if (logid && logid !== 'null' && logid !== 'undefined' && logid !== '') {
          var isHostelScanCase = ['hostel_scan_after_10pm', 'scanned_after_10pm', 'midnight_sweep_home_pass_late_hostel_scan'].includes(reason);
          var hasGateIn = !!detailsObj['indatetime'] && detailsObj['indatetime'] !== 'null' && detailsObj['indatetime'] !== '';
          var hasHostelIn = !!detailsObj['hostelintime'] && detailsObj['hostelintime'] !== 'null' && detailsObj['hostelintime'] !== '';
          
          html += '<div class="d-flex gap-2 justify-content-end mt-4 pt-2 border-top" id="dynamicActionButtons">';

          if (!isHostelScanCase && !hasGateIn) {
            html += '<button class="btn btn-primary fw-bold px-4 py-2" style="border-radius: 8px;" onclick="markAuditScanCtx(\'gate_in\', this)"><i class="fas fa-door-closed me-2"></i>Mark Gate In</button>';
          }
          if (!isHostelScanCase && !hasHostelIn) {
            html += '<button class="btn btn-warning fw-bold px-4 py-2" style="border-radius: 8px;" onclick="markAuditScanCtx(\'hostel_in\', this)"><i class="fas fa-building-user me-2"></i>Mark Hostel In</button>';
          }

          var unrestrictLabel = isHostelScanCase
            ? '<i class="fas fa-unlock me-2"></i>Unrestrict &amp; Record Hostel In'
            : '<i class="fas fa-unlock me-2"></i>Unrestrict';
          html += '<button class="btn btn-success fw-bold px-4 py-2" style="border-radius: 8px;" onclick="markAuditScanCtx(\'unrestrict\', this)">' + unrestrictLabel + '</button>';
          
          html += '</div>';
        }

        document.getElementById('modalDetailsContent').innerHTML = html;
        var modalEl = document.getElementById('detailsModal');
        var modal = new bootstrap.Modal(modalEl);
        modal.show();
      } catch (e) {
        console.error('Failed to display details modal:', e);
      }
    }

    // Uses window._auditCtx set by viewDetails to avoid inline string escaping issues
    function markAuditScanCtx(type, btnEl) {
      var ctx = window._auditCtx || {};
      markAuditScan(ctx.logid, type, btnEl, ctx.reason);
    }

    function markAuditScan(logid, type, btnEl, restrictionReason) {
        var ogText = btnEl.innerHTML;
        btnEl.disabled = true;
        btnEl.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
        
        fetch('/api/admin/audit/mark-scan/' + logid, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: type, restriction_reason: restrictionReason || '' })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (type === 'gate_in') {
                    alert('Gate In marked successfully!');
                    btnEl.outerHTML = '<button class="btn btn-secondary fw-bold px-4 py-2" style="border-radius: 8px;" disabled><i class="fas fa-check me-2"></i>Marked Gate In</button>';
                } else if (type === 'hostel_in') {
                    alert('Hostel In marked successfully!');
                    btnEl.outerHTML = '<button class="btn btn-secondary fw-bold px-4 py-2" style="border-radius: 8px;" disabled><i class="fas fa-check me-2"></i>Marked Hostel In</button>';
                } else if (type === 'unrestrict') {
                    var isHostelCase = ['hostel_scan_after_10pm', 'scanned_after_10pm', 'midnight_sweep_home_pass_late_hostel_scan'].includes(restrictionReason || '');
                    if (isHostelCase) {
                        alert('Student unrestricted! Hostel In time has been recorded using the original scan time.');
                    } else {
                        alert('Student unrestricted successfully!');
                    }
                    location.reload(); 
                } else {
                    alert('Action successful!');
                    location.reload(); 
                }
            } else {
                alert('Error: ' + data.message);
                btnEl.disabled = false;
                btnEl.innerHTML = ogText;
            }
        })
        .catch(err => {
            alert('Failed to process action');
            btnEl.disabled = false;
            btnEl.innerHTML = ogText;
        });
    }
  </script>
</body>
</html>
