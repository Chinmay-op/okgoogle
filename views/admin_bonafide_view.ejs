<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bonafide Request - Admin Detail</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background: #f0f2f5; padding: 24px; }
        .detail-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            padding: 28px;
            margin-bottom: 20px;
            max-width: 860px;
            margin-left: auto;
            margin-right: auto;
        }
        .detail-card h4 {
            font-weight: 700;
            font-size: 1.1rem;
            color: #2d3748;
            margin-bottom: 18px;
            padding-bottom: 12px;
            border-bottom: 2px solid #f0f0f0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .detail-card h4 i { color: #667eea; }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 16px;
            margin-bottom: 16px;
        }
        .info-item label {
            font-size: .73rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #a0aec0;
            display: block;
            margin-bottom: 4px;
        }
        .info-item .val {
            font-size: .95rem;
            font-weight: 600;
            color: #2d3748;
            background: #f7f8fa;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 9px 14px;
        }
        .status-badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 99px;
            font-size: .8rem;
            font-weight: 700;
        }
        .status-Pending    { background: #fef3c7; color: #92400e; }
        .status-Approved   { background: #d1fae5; color: #065f46; }
        .status-Rejected   { background: #fee2e2; color: #991b1b; }
        .status-Printed    { background: #e0e7ff; color: #3730a3; }
        .status-Collected  { background: #ccfbf1; color: #065f46; }
        .timeline { list-style: none; padding: 0; margin: 0; }
        .timeline li {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
            font-size: .88rem;
            color: #4a5568;
        }
        .timeline li:last-child { border-bottom: none; }
        .timeline-dot {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: .8rem;
        }
        .dot-done   { background: #d1fae5; color: #065f46; }
        .dot-pending { background: #fef3c7; color: #92400e; }
        .dot-skip   { background: #f7f8fa; color: #cbd5e0; }
        .action-bar {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 6px;
        }
        .cert-no-display {
            font-family: monospace;
            font-size: 1.1rem;
            font-weight: 800;
            color: #667eea;
            background: #f0f0ff;
            border: 1px solid #c3c8f5;
            border-radius: 8px;
            padding: 8px 16px;
            display: inline-block;
        }
        .verification-link {
            font-size: .8rem;
            color: #667eea;
            word-break: break-all;
        }
    </style>
</head>
<body>

<div style="max-width:860px;margin:0 auto 16px;">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
        <div>
            <h3 style="margin:0;font-weight:700;font-size:1.2rem;color:#2d3748;">
                <i class="fas fa-certificate me-2" style="color:#667eea;"></i>Request Detail
            </h3>
            <p style="color:#718096;font-size:.85rem;margin:4px 0 0;">Bonafide Certificate Request #<%= request?.id %></p>
        </div>
        <a href="/admin/bonafide-requests" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>
 
<% if (message && message.length > 0) { %>
<div class="alert alert-info alert-dismissible fade show" style="max-width:860px;margin:0 auto 16px;" role="alert">
    <%- message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>
 
<!-- Certificate Number + Status -->
<div class="detail-card">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;margin-bottom:20px;">
        <div>
            <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;color:#a0aec0;margin-bottom:6px;">Certificate Number</div>
            <% if (request?.certificate_no) { %>
            <span class="cert-no-display"><%= request?.certificate_no %></span>
            <% } else { %>
            <span style="color:#a0aec0;font-style:italic;">Not yet assigned</span>
            <% } %>
        </div>
        <div style="text-align:right;">
            <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;color:#a0aec0;margin-bottom:6px;">Status</div>
            <span class="status-badge status-<%= request?.status %>"><%= request?.status %></span>
        </div>
    </div>
 
    <% if (request?.verification_token) { %>
    <div style="background:#f0f0ff;border:1px solid #c3c8f5;border-radius:8px;padding:10px 14px;margin-bottom:16px;">
        <div style="font-size:.73rem;font-weight:700;text-transform:uppercase;color:#5a67d8;margin-bottom:4px;">
            <i class="fas fa-qrcode me-1"></i>Verification Link
        </div>
        <a href="/verify/bonafide/<%= request?.verification_token %>" target="_blank" class="verification-link">
            <%= (typeof process !== 'undefined' && process.env) ? process.env.BASE_URL || '' : '' %>/verify/bonafide/<%= request?.verification_token %>
        </a>
    </div>
    <% } %>
</div>
 
<!-- Student Info -->
<div class="detail-card">
    <h4><i class="fas fa-user"></i>Student Information</h4>
    <div class="info-grid">
        <div class="info-item">
            <label>Student Name</label>
            <div class="val"><%= request?.student_name %></div>
        </div>
        <div class="info-item">
            <label>UID / Enrollment No.</label>
            <div class="val" style="font-family:monospace;"><%= request?.student_uid %></div>
        </div>
        <div class="info-item">
            <label>Branch / Faculty</label>
            <div class="val"><%= request?.branch || 'N/A' %></div>
        </div>
        <div class="info-item">
            <label>Year</label>
            <div class="val"><%= request?.year || 'N/A' %></div>
        </div>
        <div class="info-item">
            <label>Academic Year</label>
            <div class="val"><%= request?.academic_year || 'N/A' %></div>
        </div>
        <div class="info-item">
            <label>Annual Hostel Fee</label>
            <div class="val">
                <% if (request?.hostel_fee) { %>
                Rs. <%= Number(request.hostel_fee).toLocaleString('en-IN') %>/-
                <% } else { %><span style="color:#e53e3e;">Not set</span><% } %>
            </div>
        </div>
        <div class="info-item">
            <label>Payment Status</label>
            <div class="val">
                <% if (request?.payment_status === 'paid') { %>
                    <span class="text-success" style="font-weight:700;"><i class="fas fa-check-circle me-1"></i>Paid (Accepted)</span>
                <% } else if (request?.payment_status === 'unpaid') { %>
                    <span class="text-danger" style="font-weight:700;"><i class="fas fa-times-circle me-1"></i>Not Paid</span>
                <% } else { %>
                    <span class="text-warning" style="font-weight:700;"><i class="fas fa-clock me-1"></i>Pending</span>
                <% } %>
            </div>
        </div>
        <div class="info-item">
            <label>Purpose</label>
            <div class="val"><%= request?.purpose || 'Scholarship Purpose Only' %></div>
        </div>
        <div class="info-item">
            <label>Request Date</label>
            <div class="val"><%= request?.request_date ? new Date(request.request_date).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric', timeZone: 'Asia/Kolkata'}) : '—' %></div>
        </div>
    </div>
    <% if (request?.admin_remark) { %>
    <div class="info-item" style="margin-top:8px;">
        <label>Admin Remark</label>
        <div class="val" style="font-style:italic;"><%= request?.admin_remark %></div>
    </div>
    <% } %>
    <% if (request?.status === 'Rejected' && request?.rejection_reason) { %>
    <div class="info-item" style="margin-top:8px;">
        <label style="color:#c53030;">Rejection Reason</label>
        <div class="val" style="border-color:#fc8181;background:#fff5f5;color:#c53030;"><%= request?.rejection_reason %></div>
    </div>
    <% } %>%>
</div>

<!-- Timeline -->
<div class="detail-card">
    <h4><i class="fas fa-stream"></i>Status Timeline</h4>
    <ul class="timeline">
        <li>
            <div class="timeline-dot dot-done"><i class="fas fa-paper-plane"></i></div>
            <div>
                <div style="font-weight:700;">Requested</div>
                <div style="color:#a0aec0;font-size:.82rem;"><%= request.request_date ? new Date(request.request_date).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) : '—' %></div>
            </div>
        </li>
        <li>
            <div class="timeline-dot <%= request.approved_date ? 'dot-done' : (request.status === 'Rejected' ? 'dot-reject' : 'dot-pending') %>">
                <i class="fas <%= request.approved_date ? 'fa-check' : (request.status === 'Rejected' ? 'fa-times' : 'fa-clock') %>"></i>
            </div>
            <div>
                <div style="font-weight:700;">
                    <% if (request.status === 'Rejected') { %>Rejected
                    <% } else if (request.approved_date) { %>Approved
                    <% } else { %>Pending Approval<% } %>
                </div>
                <div style="color:#a0aec0;font-size:.82rem;">
                    <% if (request.approved_date) { %>
                        <%= new Date(request.approved_date).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) %>
                    <% } else { %>Awaiting<% } %>
                </div>
            </div>
        </li>
        <li>
            <div class="timeline-dot <%= request.printed_date ? 'dot-done' : 'dot-skip' %>">
                <i class="fas fa-print"></i>
            </div>
            <div>
                <div style="font-weight:700;">Printed</div>
                <div style="color:#a0aec0;font-size:.82rem;"><%= request.printed_date ? new Date(request.printed_date).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) : '—' %></div>
            </div>
        </li>
        <li>
            <div class="timeline-dot <%= request.collected_date ? 'dot-done' : 'dot-skip' %>">
                <i class="fas fa-hand-holding"></i>
            </div>
            <div>
                <div style="font-weight:700;">Collected</div>
                <div style="color:#a0aec0;font-size:.82rem;"><%= request.collected_date ? new Date(request.collected_date).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) : '—' %></div>
            </div>
        </li>
    </ul>
</div>

<!-- Actions -->
<div class="detail-card">
    <h4><i class="fas fa-bolt"></i>Actions</h4>
    <div class="action-bar">
 
        <% if (request.status === 'Pending') { %>
        <form method="POST" action="/admin/bonafide/<%= request.id %>/approve" onsubmit="return handleApproveSubmit(this);">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" id="approveBtn" class="btn btn-success btn-sm">
                <i class="fas fa-check-circle me-1"></i>Approve Request
            </button>
        </form>
        <button class="btn btn-danger btn-sm" onclick="document.getElementById('rejectSection').style.display='block';this.style.display='none';">
            <i class="fas fa-times-circle me-1"></i>Reject Request
        </button>
        <% } %>
 
        <% if (request.status === 'Approved' || request.status === 'Printed' || request.status === 'Collected') { %>
        <a href="/admin/bonafide/<%= request.id %>/print" class="btn btn-primary btn-sm" target="_blank">
            <i class="fas fa-print me-1"></i>Print Certificate
        </a>
        <button id="saveDocBtn" data-id="<%= request.id %>" data-name="<%= request.student_name.split(' ').join('_') %>" class="btn btn-secondary btn-sm">
            <i class="fas fa-file-word me-1"></i>Save as Word (.doc)
        </button>
        <% } %>

        <% if (request.status === 'Approved') { %>
        <form method="POST" action="/admin/bonafide/<%= request.id %>/printed-manual" style="display:inline;" onsubmit="return handleManualPrintSubmit(this);">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" id="manualPrintBtn" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-check-double me-1"></i>Mark as Printed (Manual)
            </button>
        </form>
        <% } %>
 
        <% if (request.status === 'Printed') { %>
        <form method="POST" action="/admin/bonafide/<%= request.id %>/collected" onsubmit="return handleCollectedSubmit(this);">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" id="collectedBtn" class="btn btn-teal btn-sm" style="background:#4fd1c5;color:#fff;">
                <i class="fas fa-hand-holding me-1"></i>Mark as Collected
            </button>
        </form>
        <% } %>
    </div>
 
    <!-- Reject form (hidden by default) -->
    <div id="rejectSection" style="display:none;margin-top:18px;">
        <form method="POST" action="/admin/bonafide/<%= request.id %>/reject" onsubmit="return handleRejectSubmit(this);">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label style="font-weight:700;font-size:.88rem;color:#c53030;display:block;margin-bottom:6px;">
                <i class="fas fa-exclamation-triangle me-1"></i>Rejection Reason (required)
            </label>
            <textarea name="rejection_reason" class="form-control" rows="3" placeholder="Enter reason..." required></textarea>
            <div style="margin-top:10px;display:flex;gap:8px;">
                <button type="submit" id="rejectBtn" class="btn btn-danger btn-sm">Confirm Rejection</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('rejectSection').style.display='none';">Cancel</button>
            </div>
        </form>
    </div>
</div>
 
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function handleApproveSubmit(form) {
        if (!confirm('Approve this request?')) return false;
        const btn = document.getElementById('approveBtn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Approving...';
        }
        return true;
    }
    function handleRejectSubmit(form) {
        const btn = document.getElementById('rejectBtn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Rejecting...';
        }
        return true;
    }
    function handleManualPrintSubmit(form) {
        if (!confirm('Mark as Printed?')) return false;
        const btn = document.getElementById('manualPrintBtn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Updating...';
        }
        return true;
    }
    function handleCollectedSubmit(form) {
        if (!confirm('Mark as Collected by student?')) return false;
        const btn = document.getElementById('collectedBtn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Updating...';
        }
        return true;
    }

    async function saveAsWordDoc(requestId, studentName) {
        const filename = studentName + '.doc';
        try {
            // Fetch the Word file blob from the server
            const response = await fetch('/admin/bonafide/' + requestId + '/docx');
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            const blob = await response.blob();

            // Try to use modern File System Access API
            if (window.showSaveFilePicker) {
                const options = {
                    suggestedName: filename,
                    types: [{
                        description: 'Word Document (.doc)',
                        accept: {
                            'application/msword': ['.doc']
                        }
                    }]
                };
                const handle = await window.showSaveFilePicker(options);
                const writable = await handle.createWritable();
                await writable.write(blob);
                await writable.close();
            } else {
                // Fallback for older browsers
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            }
        } catch (err) {
            // Ignore AbortError (if user cancels the dialog)
            if (err.name !== 'AbortError') {
                console.error('Error saving file:', err);
                alert('Failed to save file. Downloading normally...');
                // Direct fallback download link trigger
                window.location.href = '/admin/bonafide/' + requestId + '/docx';
            }
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('saveDocBtn');
        if (btn) {
            btn.addEventListener('click', () => {
                const id = btn.getAttribute('data-id');
                const name = btn.getAttribute('data-name');
                saveAsWordDoc(id, name);
            });
        }
    });
</script>
</body>
</html>
