  <script>
    const backgroundImages = [
      '/loginimages/1.jpg',
      '/loginimages/2.jpg',
      '/loginimages/3.jpg',
      '/loginimages/4.jpg',
      '/loginimages/5.jpg',
      '/loginimages/6.jpg',
      '/loginimages/7.jpg'

    ];

    let currentImageIndex = 0;

    function changeBackground() {
      document.body.style.backgroundImage = `url('${backgroundImages[currentImageIndex]}')`;
      currentImageIndex = (currentImageIndex + 1) % backgroundImages.length;
    }

    // Set initial background
    changeBackground();

    // Change background every 5 seconds
    setInterval(changeBackground, 20000);

    // --- NOTIFICATION BADGE POLLING SCRIPT ---
    function updateBadges() {
      fetch('/api/admin/notification-counts')
        .then(response => response.json())
        .then(counts => {
          if (!counts || Object.keys(counts).length === 0) return;

          function setBadge(id, count) {
            const el = document.querySelector(`[data-badge="${id}"]`);
            if (el) {
              const num = (count && parseInt(count, 10) > 0) ? parseInt(count, 10) : 0;
              if (num > 0) {
                el.textContent = num;
                el.style.display = 'inline-block';
              } else {
                el.textContent = '';
                el.style.display = 'none';
              }
            }
          }

          // Individual sub-items and direct links
          setBadge('bonafideRequests', counts.bonafideRequests);
          setBadge('hostelBankRequests', counts.hostelBankRequests);
          setBadge('certificateRequests', (counts.bonafideRequests || 0) + (counts.hostelBankRequests || 0));
          setBadge('passRequests', counts.passRequests);
          setBadge('verifyComplaints', counts.verifyComplaints);
          setBadge('sickLeaveRequests', counts.sickLeaveRequests);
          setBadge('roomBookings', counts.roomBookings);
          setBadge('pendingAdmissions', counts.pendingAdmissions);
          setBadge('newStudentSuperId', counts.pendingAdmissions);
          setBadge('newStudentsBoysAdmin', counts.pendingAdmissions);
          // Restriction Audit badge logic (clears notification after page visit)
          var lastVisited = localStorage.getItem('restriction_audit_last_visited');
          var restrCount = counts.restrictionAudit || 0;
          if (lastVisited && restrCount > 0) {
            var lastVisitedTS = parseInt(lastVisited, 10);
            if (!isNaN(lastVisitedTS) && lastVisitedTS > 0) {
              restrCount = 0; // Clears notification badge after visiting restriction audit page
            }
          }
          setBadge('restrictionAudit', restrCount);

          // Parent toggles - sums
          setBadge('activityParent', (counts.passRequests || 0) + (counts.verifyComplaints || 0));
          setBadge('sickLeaveParent', counts.sickLeaveRequests || 0);
          setBadge('roomBookingParent', (counts.roomBookings || 0) + (counts.pendingAdmissions || 0));
          setBadge('studentsParent', counts.pendingAdmissions || 0);
        })
        .catch(err => console.error('Error polling notification counts:', err));
    }

    // Run immediately on page load, then poll every 35 seconds
    updateBadges();
    setInterval(updateBadges, 35000);
    // --- END NOTIFICATION BADGE POLLING SCRIPT ---
  </script>
