<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bonafide Certificate - Student Portal</title>
    <link rel="stylesheet" href="/stylesheets/studentportal.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" href="/images/4174.png">
    <style>
        .bonafide-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            padding: 28px;
            margin-bottom: 24px;
        }
        .bonafide-card h2 {
            font-size: 1.25rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .bonafide-card h2 i { color: #667eea; }
        .bonafide-card p.subtitle {
            color: #718096;
            font-size: 0.9rem;
            margin-bottom: 22px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 22px;
        }
        .info-field label {
            font-size: 0.76rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #a0aec0;
            display: block;
            margin-bottom: 5px;
        }
        .info-field .val {
            font-size: 0.97rem;
            font-weight: 600;
            color: #2d3748;
            background: #f7f8fa;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 9px 14px;
        }
        .alert-warning-box {
            background: #fffbeb;
            border: 1px solid #f6d860;
            border-radius: 10px;
            padding: 14px 18px;
            margin-bottom: 22px;
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }
        .alert-warning-box i { color: #d69e2e; font-size: 1.2rem; margin-top: 2px; }
        .alert-warning-box p { margin: 0; font-size: 0.9rem; color: #744210; }
        .alert-already {
            background: #ebf8ff;
            border: 1px solid #90cdf4;
            border-radius: 10px;
            padding: 14px 18px;
            display: flex;
            gap: 12px;
            align-items: center;
            margin-bottom: 20px;
        }
        .alert-already i { color: #3182ce; font-size: 1.1rem; }
        .alert-already p { margin: 0; font-size: 0.9rem; color: #2b6cb0; }
        .btn-request {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 11px 28px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity .2s;
        }
        .btn-request:hover { opacity: .88; }
        .btn-request:disabled { background: #cbd5e0; cursor: not-allowed; opacity: 1; }

        /* History Table */
        .history-table-wrap { overflow-x: auto; }
        table.history-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
        }
        table.history-table th {
            background: #f7f8fa;
            color: #718096;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.74rem;
            letter-spacing: .5px;
            padding: 11px 14px;
            border-bottom: 2px solid #e2e8f0;
            text-align: left;
        }
        table.history-table td {
            padding: 12px 14px;
            border-bottom: 1px solid #f0f0f0;
            color: #4a5568;
            vertical-align: middle;
        }
        table.history-table tr:hover td { background: #fafafa; }
        .status-badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 99px;
            font-size: 0.76rem;
            font-weight: 700;
        }
        .status-Pending    { background: #fef3c7; color: #92400e; }
        .status-Approved   { background: #d1fae5; color: #065f46; }
        .status-Rejected   { background: #fee2e2; color: #991b1b; }
        .status-Printed    { background: #e0e7ff; color: #3730a3; }
        .status-Collected  { background: #d1fae5; color: #065f46; }
        .cert-no { font-family: monospace; font-size: 0.82rem; color: #667eea; }
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #a0aec0;
        }
        .empty-state i { font-size: 2.5rem; margin-bottom: 12px; display: block; }
    </style>
</head>
<body>
    <button class="menu-toggle" onclick="toggleSidebar()">
        <i class="fas fa-bars"></i>
    </button>
    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <!-- Sidebar -->
    <div class="sidebar">
        <button class="sidebar-close" onclick="toggleSidebar()">
            <i class="fas fa-times"></i>
        </button>
        <div class="logo">
            <img src="/images/4174.png" alt="Logo">
            <h2>Gate Pass</h2>
        </div>
        <ul class="nav-links">
            <li>
                <a href="/student/dashboard">
                    <i class="fas fa-home"></i><span>Dashboard</span>
                </a>
            </li>
            <li>
                <a href="/student/roombooking">
                    <i class="fas fa-bed"></i><span>Room Booking</span>
                </a>
            </li>
            <li>
                <a href="/student/profile">
                    <i class="fas fa-user"></i><span>My Profile</span>
                </a>
            </li>
            <li>
                <a href="/student/attendance">
                    <i class="fas fa-calendar-check"></i><span>Attendance</span>
                </a>
            </li>
            <li>
                <a href="/student/passhistory">
                    <i class="fas fa-history"></i><span>Pass History</span>
                </a>
            </li>
            <li>
                <a href="/student/requestpass">
                    <i class="fas fa-ticket-alt"></i><span>Request Pass</span>
                </a>
            </li>
            <li>
                <a href="/student/sickleave">
                    <i class="fas fa-notes-medical"></i><span>Request Sick Leave</span>
                </a>
            </li>
            <li>
                <a href="/student/sickleaverequests">
                    <i class="fas fa-list-alt"></i><span>My Sick Leave Requests</span>
                </a>
            </li>
            <li>
                <a href="/student/mess" id="nav_student_breakfast_link">
                    <i class="fas fa-utensils"></i>
                    <span>Mess Selection</span>
                </a>
            </li>
            <li class="active">
                <a href="/student/bonafide" class="active">
                    <i class="fas fa-certificate"></i><span>Bonafide Certificate</span>
                </a>
            </li>
            <li>
                <a href="/student/bank-details">
                    <i class="fas fa-university"></i><span>Hostel Bank Details</span>
                </a>
            </li>
            <li>
                <a href="/student/notifications">
                    <i class="fas fa-bell"></i><span>Notifications</span>
                </a>
            </li>
            <li>
                <a href="/student/complain">
                    <i class="fas fa-exclamation-triangle"></i><span>Complain Box</span>
                </a>
            </li>
        </ul>
        <div class="user-info">
            <div class="user-detail">
                <img src="<%= student.path || '/images/default-avatar.png' %>" alt="Profile">
                <div class="stu-name">
                    <div class="name"><%= student.sname %></div>
                    <div class="role"><%= student.uid %></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="topbar">
            <div class="page-title">
                <h1><i class="fas fa-certificate" style="color:#667eea;margin-right:8px;"></i>Bonafide Certificate</h1>
                <p>Request your hostel bonafide certificate</p>
            </div>
            <div class="user-actions">
                <a href="/student/notifications" class="notification-btn">
                    <i class="fas fa-bell"></i>
                </a>
                <a href="/student/logout" class="logout-btn" style="text-decoration:none;">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>

        <% if (message && message.length > 0) { %>
        <div class="alert alert-info" style="margin-bottom:16px;">
            <i class="fas fa-info-circle"></i> <%- message %>
        </div>
        <% } %>

        <% if (!student.category || student.category.toLowerCase() !== 'hostel') { %>
        <!-- Not a hosteller -->
        <div class="bonafide-card">
            <div style="text-align:center;padding:30px 0;">
                <i class="fas fa-ban" style="font-size:2.5rem;color:#fc8181;margin-bottom:12px;display:block;"></i>
                <h3 style="color:#c53030;">Access Restricted</h3>
                <p style="color:#718096;">Bonafide Certificate is available only for hostel students.</p>
            </div>
        </div>
        <% } else { %>
 
        <!-- Request Card -->
        <div class="bonafide-card">
            <h2><i class="fas fa-file-certificate"></i>Request Bonafide Certificate</h2>
            <p class="subtitle">Review your read-only information, edit your name spelling and purpose, and submit.</p>
 
            <!-- Warning -->
            <div class="alert-warning-box">
                <i class="fas fa-exclamation-triangle"></i>
                <p>
                    <strong>⚠ Bonafide Certificate can only be requested once per academic year.</strong><br>
                    A new academic year will automatically allow a new request. Please request only if genuinely required.
                </p>
            </div>
 
            <% if (existingRequest) { %>
            <!-- Already applied -->
            <div class="alert-already">
                <i class="fas fa-check-circle"></i>
                <p>
                    You have <strong>already applied</strong> for a Bonafide Certificate for Academic Year
                    <strong><%= existingRequest.academic_year %></strong>.
                    Current status: <span class="status-badge status-<%= existingRequest.status %>"><%= existingRequest.status %></span>
                </p>
            </div>
            <% } %>

            <form method="POST" action="/student/bonafide/request" onsubmit="return confirmRequest()">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <!-- Readonly Auto-fetched Fields -->
                <div class="info-grid">
                    <div class="info-field">
                        <label><i class="fas fa-id-badge" style="margin-right:4px;"></i>UID</label>
                        <input type="text" class="form-control" style="background:#f7f8fa; border:1px solid #e2e8f0; font-weight:600; padding:10px 14px; border-radius:8px; width:100%;" value="<%= student.uid %>" readonly>
                    </div>
                    <div class="info-field">
                        <label><i class="fas fa-graduation-cap" style="margin-right:4px;"></i>Branch</label>
                        <input type="text" class="form-control" style="background:#f7f8fa; border:1px solid #e2e8f0; font-weight:600; padding:10px 14px; border-radius:8px; width:100%;" value="<%= student.dept %>" readonly>
                    </div>
                    <div class="info-field">
                        <label><i class="fas fa-layer-group" style="margin-right:4px;"></i>Year</label>
                        <input type="text" class="form-control" style="background:#f7f8fa; border:1px solid #e2e8f0; font-weight:600; padding:10px 14px; border-radius:8px; width:100%;" value="<%= student.year ? student.year + (student.year == 1 ? 'st' : student.year == 2 ? 'nd' : student.year == 3 ? 'rd' : 'th') + ' Year' : 'N/A' %>" readonly>
                    </div>
                    <div class="info-field">
                        <label><i class="fas fa-calendar-alt" style="margin-right:4px;"></i>Academic Year</label>
                        <input type="text" class="form-control" style="background:#f7f8fa; border:1px solid #e2e8f0; font-weight:600; padding:10px 14px; border-radius:8px; width:100%;" value="<%= academicYearFormatted %>" readonly>
                    </div>
                </div>

                <!-- Editable Fields -->
                <div style="margin-top:20px; display:grid; grid-template-columns:1fr; gap:16px;">
                    <div>
                        <label style="font-size:.76rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:#a0aec0; display:block; margin-bottom:5px;">
                            <i class="fas fa-user" style="margin-right:4px;"></i>Student Name
                        </label>
                        <input type="text" name="student_name" value="<%= student.sname %>" class="form-control" style="border:1px solid #cbd5e0; font-weight:600; padding:10px 14px; border-radius:8px; width:100%;" required <%= existingRequest ? 'disabled' : '' %>>
                        <small style="color:#a0aec0; font-size:0.75rem;">Correct spelling if necessary.</small>
                    </div>

                    <div>
                        <label style="font-size:.76rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:#a0aec0; display:block; margin-bottom:5px;">
                            <i class="fas fa-bullseye" style="margin-right:4px;"></i>Purpose
                        </label>
                        <select name="purpose" id="purposeSelect" class="form-control" style="border:1px solid #cbd5e0; font-weight:600; padding:10px 14px; border-radius:8px; width:100%; background-color:#fff;" onchange="toggleOtherPurpose()" <%= existingRequest ? 'disabled' : '' %> required>
                            <option>Scholarship Purpose Only</option>
                            <option>Bank Loan</option>
                            <option>Passport</option>
                            <option>Income Tax</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div id="otherPurposeWrapper" style="display:none;">
                        <label style="font-size:.76rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:#a0aec0; display:block; margin-bottom:5px;">
                            <i class="fas fa-pen" style="margin-right:4px;"></i>Specify Other Purpose
                        </label>
                        <textarea name="other_purpose" id="otherPurpose" class="form-control" style="border:1px solid #cbd5e0; padding:10px 14px; border-radius:8px; width:100%; min-height:80px;" placeholder="Please specify your purpose..." <%= existingRequest ? 'disabled' : '' %>></textarea>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div>
                            <label style="font-size:.76rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:#a0aec0; display:block; margin-bottom:5px;">
                                <i class="fas fa-bed" style="margin-right:4px;"></i>Occupancy
                            </label>
                            <select id="occupancy" name="occupancy" class="form-control" style="border:1px solid #cbd5e0; font-weight:600; padding:10px 14px; border-radius:8px; width:100%; background-color:#fff;" onchange="updateFee()" <%= existingRequest ? 'disabled' : '' %> required>
                                <option value="">Select</option>
                                <option value="single">Single</option>
                                <option value="double">Double</option>
                                <option value="triple">Triple</option>
                            </select>
                        </div>
                        <div>
                            <label style="font-size:.76rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:#a0aec0; display:block; margin-bottom:5px;">
                                <i class="fas fa-utensils" style="margin-right:4px;"></i>Mess Type
                            </label>
                            <select id="mess_type" name="mess_type" class="form-control" style="border:1px solid #cbd5e0; font-weight:600; padding:10px 14px; border-radius:8px; width:100%; background-color:#fff;" onchange="updateFee()" <%= existingRequest ? 'disabled' : '' %> required>
                                <option value="">Select</option>
                                <option value="veg">Veg</option>
                                <option value="nonveg">Non-Veg</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label style="font-size:.76rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:#a0aec0; display:block; margin-bottom:5px;">
                            <i class="fas fa-rupee-sign" style="margin-right:4px;"></i>Hostel Fee (Auto Calculated)
                        </label>
                        <input type="text" id="hostel_fee" class="form-control" style="background:#f7f8fa; border:1px solid #e2e8f0; font-weight:600; padding:10px 14px; border-radius:8px; width:100%; color:#2d3748;" readonly placeholder="Select Occupancy & Mess Type">
                    </div>
                </div>

                <div style="margin-top:24px;">
                    <% if (existingRequest) { %>
                    <button type="button" class="btn-request" disabled>
                        <i class="fas fa-certificate"></i> Already Requested for <%= academicYearFormatted %>
                    </button>
                    <% } else { %>
                    <button type="submit" id="submitBtn" class="btn-request">
                        <i class="fas fa-paper-plane"></i> Request Certificate
                    </button>
                    <% } %>
                </div>
            </form>
        </div>
 
        <!-- History Table -->
        <div class="bonafide-card">
            <h2><i class="fas fa-history"></i>My Request History</h2>
            <p class="subtitle">All your bonafide certificate requests</p>
 
            <% if (history && history.length > 0) { %>
            <div class="history-table-wrap">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Request Date</th>
                            <th>Academic Year</th>
                            <th>Purpose</th>
                            <th>Status</th>
                            <th>Remark / Cert No.</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% history.forEach(function(req) { %>
                        <tr>
                            <td><%= req.request_date ? new Date(req.request_date).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' }) : '—' %></td>
                            <td style="font-weight:600;"><%= req.academic_year || '—' %></td>
                            <td><%= req.purpose || '—' %></td>
                            <td>
                                <span class="status-badge status-<%= req.status %>"><%= req.status %></span>
                            </td>
                            <td style="font-size:0.83rem;color:#718096;">
                                <% if (req.status === 'Rejected' && req.rejection_reason) { %>
                                    <i class="fas fa-times-circle" style="color:#e53e3e;"></i> <%= req.rejection_reason %>
                                <% } else if (req.status === 'Approved') { %>
                                    <i class="fas fa-check-circle" style="color:#38a169;"></i> Collect (Cert No: <%= req.certificate_no || '—' %>)
                                <% } else if (req.status === 'Printed') { %>
                                    <i class="fas fa-print" style="color:#5a67d8;"></i> Ready for collection (Cert No: <%= req.certificate_no || '—' %>)
                                <% } else if (req.status === 'Collected') { %>
                                    <i class="fas fa-check-double" style="color:#38a169;"></i> Collected (Cert No: <%= req.certificate_no || '—' %>)
                                <% } else { %>
                                    <span style="color:#a0aec0;">Awaiting verification</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (req.status === 'Pending') { %>
                                <form method="POST" action="/student/bonafide/<%= req.id %>/cancel" style="display:inline;" onsubmit="return confirm('Are you sure you want to cancel this bonafide request?');">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" style="background:#e53e3e; color:#fff; border:none; padding:4px 10px; border-radius:6px; font-size:0.78rem; font-weight:600; cursor:pointer;">
                                        <i class="fas fa-times me-1"></i>Cancel
                                    </button>
                                </form>
                                <% } else { %>
                                <span style="color:#cbd5e0;">—</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <p>No requests yet.</p>
            </div>
            <% } %>
        </div>
 
        <% } %>
    </div><!-- .main-content -->
 
    <script>
        function toggleSidebar() {
            document.querySelector('.sidebar').classList.toggle('active');
            document.querySelector('.sidebar-overlay').classList.toggle('active');
        }
        function confirmRequest() {
            if (!confirm('Are you sure you want to request a Bonafide Certificate? This can only be done once per academic year.')) {
                return false;
            }
            const btn = document.getElementById('submitBtn');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
            }
            return true;
        }
        function toggleOtherPurpose() {
            const select = document.getElementById('purposeSelect');
            const wrapper = document.getElementById('otherPurposeWrapper');
            const textarea = document.getElementById('otherPurpose');
            if (select && select.value === 'Other') {
                wrapper.style.display = 'block';
                textarea.required = true;
            } else if (wrapper) {
                wrapper.style.display = 'none';
                textarea.required = false;
            }
        }
        const feeStructure = {
            veg: {
                single: 79000,
                double: 75000,
                triple: 71000
            },
            nonveg: {
                single: 80000,
                double: 76000,
                triple: 72000
            }
        };

        function updateFee() {
            const occupancy = document.getElementById('occupancy').value;
            const mess = document.getElementById('mess_type').value;
            const feeField = document.getElementById('hostel_fee');

            if (!occupancy || !mess) {
                feeField.value = '';
                feeField.placeholder = 'Select Occupancy & Mess Type';
                return;
            }

            let fee = feeStructure[mess][occupancy];
            feeField.value = '₹' + fee.toLocaleString('en-IN');
        }

        window.addEventListener('DOMContentLoaded', () => {
            toggleOtherPurpose();
            updateFee();
        });
    </script>
</body>
</html>
