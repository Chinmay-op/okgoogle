<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Tally Fee Data Preview</title>
  <link rel="stylesheet" href="/stylesheets/hostelpanel.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="icon" href="/images/4174.png">
  <style>
    .summary-card { border-left: 4px solid #0d6efd; }
    .table-responsive { max-height: 70vh; }
    .table th { position: sticky; top: 0; background: #f8f9fa; z-index: 1; }
  </style>
</head>
<body class="bg-light">

<div class="container-fluid py-4">
  <div class="row align-items-center mb-4">
    <div class="col-12 col-md-4 text-center text-md-start mb-3 mb-md-0">
      <button onclick="window.history.back()" class="btn btn-outline-dark shadow-sm" style="font-weight: 500; border-radius: 8px;">
        <i class="fas fa-arrow-left me-2"></i> Back
      </button>
    </div>
    <div class="col-12 col-md-4 text-center mb-3 mb-md-0">
      <img src="/images/logo.png" style="max-width: 250px; height: auto;" />
    </div>
    <div class="col-12 col-md-4"></div>
  </div>

  <% if(message && message.length > 0){ %>
    <div class="row justify-content-center mb-4">
      <div class="col-md-8 text-center">
        <div class="alert alert-info shadow-sm">
          <h5 class="mb-0"><%- message %></h5>
        </div>
      </div>
    </div>
  <% } %>

  <% 
    let totalRecords = result ? result.length : 0;
    let unmatchedRecords = 0;
    let lastImportDate = 'N/A';
    if(result && result.length > 0) {
      unmatchedRecords = result.filter(r => !r.uid).length;
      lastImportDate = result[0].imported_at ? new Date(result[0].imported_at).toLocaleString() : 'N/A';
    }
  %>

  <!-- Summary Card -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm border-0 summary-card">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap">
          <div>
            <h5 class="mb-1"><i class="fas fa-chart-pie text-primary me-2"></i> Import Summary</h5>
            <p class="text-muted mb-0 small">Last imported on: <strong><%= lastImportDate %></strong></p>
          </div>
          <div class="d-flex gap-4 mt-3 mt-md-0">
            <div class="text-center">
              <h4 class="mb-0 text-dark"><%= totalRecords %></h4>
              <small class="text-muted">Total Records</small>
            </div>
            <div class="text-center">
              <h4 class="mb-0 <%= unmatchedRecords > 0 ? 'text-danger' : 'text-success' %>"><%= unmatchedRecords %></h4>
              <small class="text-muted">Unmatched (No UID)</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search Bar -->
  <div class="row mb-3">
    <div class="col-md-4">
      <input type="text" id="searchInput" onkeyup="myFunction()" class="form-control" placeholder="Search by UID or Name...">
    </div>
  </div>

  <!-- Data Table -->
  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-bordered mb-0" id="tallyTable">
          <thead>
            <tr>
              <th>#</th>
              <th>Hostel UID</th>
              <th>Student Name (Tally)</th>
              <th>Dept</th>
              <th>Year</th>
              <th>Receivables Arrear Fee</th>
              <th>Receivables Current Year</th>
              <th>Receivables Extra Stay</th>
              <th>Received Arrear Fee</th>
              <th>Received Current Year</th>
              <th>Received Extra</th>
              <th>Balance</th>
              <th>As On Date</th>
            </tr>
          </thead>
          <tbody>
            <% if(result && result.length > 0) { %>
              <% result.forEach((row, index) => { %>
                <tr class="<%= !row.uid ? 'table-danger' : '' %>">
                  <td><%= index + 1 %></td>
                  <td><%= row.suid %></td>
                  <td><%= row.student_name %></td>

                  <td><%= row.dept || '-' %></td>
                  <td><%= row.year || '-' %></td>
                  <td>₹<%= parseFloat(row.recv_arrear_fee || 0).toLocaleString('en-IN') %></td>
                  <td>₹<%= parseFloat(row.recv_current_year || 0).toLocaleString('en-IN') %></td>
                  <td>₹<%= parseFloat(row.recv_extra_stay || 0).toLocaleString('en-IN') %></td>
                  <td>₹<%= parseFloat(row.recd_arrear_fee || 0).toLocaleString('en-IN') %></td>
                  <td>₹<%= parseFloat(row.recd_current_year || 0).toLocaleString('en-IN') %></td>
                  <td>₹<%= parseFloat(row.recd_extra || 0).toLocaleString('en-IN') %></td>
                  <td class="<%= parseFloat(row.balance || 0) > 0 ? 'text-danger fw-bold' : 'text-success fw-bold' %>">
                    ₹<%= parseFloat(row.balance || 0).toLocaleString('en-IN') %>
                  </td>
                  <td><%= row.as_on_date %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="13" class="text-center py-4 text-muted">No data available. Please import Tally Excel first.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<script>
function myFunction() {
  var input, filter, table, tr, td, i, txtValue;
  input = document.getElementById("searchInput");
  filter = input.value.toUpperCase();
  table = document.getElementById("tallyTable");
  tr = table.getElementsByTagName("tr");
  for (i = 1; i < tr.length; i++) {
    tdUid = tr[i].getElementsByTagName("td")[1];
    tdName = tr[i].getElementsByTagName("td")[2];
    if (tdUid || tdName) {
      let uidText = tdUid.textContent || tdUid.innerText;
      let nameText = tdName.textContent || tdName.innerText;
      
      if (uidText.toUpperCase().indexOf(filter) > -1 || 
          nameText.toUpperCase().indexOf(filter) > -1) {
        tr[i].style.display = "";
      } else {
        tr[i].style.display = "none";
      }
    }
  }
}
</script>

</body>
</html>
