<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bank Details Collection</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background: #f0f2f5; padding: 24px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .page-header {
            background: #fff;
            border-radius: 12px;
            padding: 20px 24px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }
        .page-header h3 { margin: 0; font-size: 1.2rem; font-weight: 700; color: #2d3748; }
        .page-header p  { margin: 4px 0 0; color: #718096; font-size: .87rem; }

        .table-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
            overflow: hidden;
        }
        table.req-table { width: 100%; border-collapse: collapse; font-size: .87rem; }
        table.req-table th {
            background: #f7f8fa;
            color: #718096;
            font-weight: 700;
            text-transform: uppercase;
            font-size: .72rem;
            letter-spacing: .5px;
            padding: 12px 16px;
            border-bottom: 2px solid #e2e8f0;
            text-align: left;
        }
        table.req-table td {
            padding: 13px 16px;
            border-bottom: 1px solid #f0f0f0;
            color: #4a5568;
            vertical-align: middle;
        }
        table.req-table tr:hover td { background: #fafbff; }

        .status-badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 99px;
            font-size: .74rem;
            font-weight: 700;
        }
        .status-Printed   { background: #e0e7ff; color: #3730a3; }
        .status-Collected { background: #ccfbf1; color: #065f46; }

        .btn-action { border: none; padding: 5px 12px; border-radius: 6px; font-size: .78rem; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; }
        .btn-collect { background: #ccfbf1; color: #065f46; }
        .btn-action:hover { opacity: .8; }

        .cert-no { font-family: monospace; font-size: .8rem; color: #667eea; }
        .empty-state { text-align: center; padding: 50px; color: #a0aec0; }
        .empty-state i { font-size: 2.5rem; display: block; margin-bottom: 12px; }

        @media (max-width: 768px) {
            body { padding: 12px; }
            .page-header { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
<body>

<div class="page-header">
    <div>
        <h3><i class="fas fa-university me-2" style="color:#667eea;"></i>Bank Details Letter Collection</h3>
        <p>Mark letters as collected when students pick them up from the Hostel Authority.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <a href="/tokenhomepage" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>
</div>

<% if (message && message.length > 0) { %>
<div class="alert alert-info alert-dismissible fade show" role="alert">
    <%= message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>

<div class="table-card">
    <table class="req-table">
        <thead>
            <tr>
                <th>Student Name</th>
                <th>Document No.</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        <% if (requests && requests.length > 0) { %>
            <% requests.forEach(function(r) { %>
            <tr>
                <td><strong><%= r.student_name %></strong></td>
                <td><span class="cert-no"><%= r.document_no || '-' %></span></td>
                <td>
                    <span class="status-badge status-<%= r.status %>"><%= r.status %></span>
                </td>
                <td>
                    <% if (r.status === 'Printed') { %>
                    <form action="/hostelauthority/bank-details/<%= r.id %>/collected" method="POST" style="display:inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-action btn-collect">
                            <i class="fas fa-check me-1"></i>Mark as Collected
                        </button>
                    </form>
                    <% } else { %>
                    <span style="color:#a0aec0;">-</span>
                    <% } %>
                </td>
            </tr>
            <% }); %>
        <% } else { %>
            <tr>
                <td colspan="4">
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        No printed letters awaiting collection.
                    </div>
                </td>
            </tr>
        <% } %>
        </tbody>
    </table>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
