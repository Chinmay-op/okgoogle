<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Login - Gate Pass System</title>
    <link rel="stylesheet" href="/stylesheets/studentportal.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" href="/images/4174.png">
    <style>
        /* Responsive full-bleed background for login page */
        body {
            background-size: cover !important;
            background-position: center center !important;
            background-repeat: no-repeat !important;
            min-height: 100vh;
            margin: 0;
        }

        /* Use fixed background on desktop for parallax feel; disable on small screens for performance */
        @media (min-width: 769px) {
            body {
                background-attachment: fixed;
            }
        }

        @media (max-width: 768px) {
            body {
                background-attachment: scroll;
                -webkit-background-size: cover;
                background-size: cover;
            }
        }

        /* Ensure the login container sits above the background and centers vertically */
        .student-login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 1;
        }

        .student-login-box {
            z-index: 2;
            position: relative;
        }
    </style>
</head>

<body>
    <div class="student-login-container">
        <div class="student-login-box">
            <div class="login-header">
                <img src="/images/logo.png" alt="Logo">
                <h1>Student Portal</h1>
                <p style="box-shadow: 20px;">Login to access your dashboard</p>
            </div>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var pwd = document.getElementById('password');
                    var btn = document.getElementById('togglePwd');
                    var icon = document.getElementById('togglePwdIcon');
                    if (!pwd || !btn || !icon) return;

                    btn.addEventListener('click', function () {
                        var isHidden = pwd.type === 'password';
                        pwd.type = isHidden ? 'text' : 'password';
                        // ensure one of the icon states
                        icon.classList.toggle('fa-eye', !isHidden);
                        icon.classList.toggle('fa-eye-slash', isHidden);
                        btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
                        btn.title = isHidden ? 'Hide password' : 'Show password';
                    });
                });
            </script>
            <% if(message && message.length> 0){ %>
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i>
                    <%- message %>
                </div>
                <% } %>

                    <form action="/student/login" method="POST">
                        <div class="form-group">
                            <label>Student UID</label>
                            <i class="fas fa-user"></i>
                            <input type="text" name="uid" placeholder="Enter your UID" required>
                        </div>

                        <div class="form-group" style="position: relative; display: flex; flex-direction: column;">
                            <label>Password</label>
                            <i class="fas fa-lock"></i>
                            <input id="password" type="password" name="password" placeholder="Enter your password"
                                required>
                            <div style="position: absolute; right: 40px; top: 36px;">
                                <button type="button" id="togglePwd" aria-label="Show password"
                                    title="Show/Hide password"
                                    style="background:none; border:none; cursor:pointer; color:#666;">
                                    <i class="fas fa-eye" id="togglePwdIcon"></i>
                                </button>
                            </div>

                        </div>
                        <a href="/student/forgot" style="display: absolute; padding-bottom: 4px;">Forgot Password</a>


                        <button type="submit" class="btn-login">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </button>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top" style="text-align: center;">
                        <span id="newStudentText" class="fs-6" style="color: black; display: inline-block; margin-top: 15px;">New student?</span><br>
                        <a href="/student/admission-landing" class="fw-bold fs-6 text-decoration-underline" style="color: red; display: inline-block; margin-top: 8px;">Apply for Hostel Admission</a>
                    </div>

                    <div class="login-footer">
                        <p id="firstTimeText" style="color: black;">First time? Use your mobile number as password</p>
                        <p style="margin-top: 10px;">
                            <a href="/loginpanel">Admin Login</a>
                        </p>
                    </div>
        </div>
    </div>

    <script>
        const backgroundImages = [
            '/loginimages/1.jpg',
            '/loginimages/2.jpg',
            '/loginimages/3.jpg',
            '/loginimages/4.jpg',
            '/loginimages/5.jpg',
            '/loginimages/6.jpg',
            '/loginimages/7.jpg'

        ];

        let currentImageIndex = 0;

        function changeBackground() {
            const img = new Image();
            img.src = backgroundImages[currentImageIndex];
            img.onload = function() {
                document.body.style.backgroundImage = `url('${img.src}')`;
                const newStudentText = document.getElementById('newStudentText');
                if(newStudentText) newStudentText.style.color = 'white';
                const firstTimeText = document.getElementById('firstTimeText');
                if(firstTimeText) firstTimeText.style.color = 'whitesmoke';
            };
            currentImageIndex = (currentImageIndex + 1) % backgroundImages.length;
        }

        // Set initial background
        changeBackground();

        // Change background every 5 seconds
        setInterval(changeBackground, 5000);
    </script>
</body>

</html>