<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hostel Student</title>
  <link rel="stylesheet" href="/stylesheets/hostelpanel.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="icon" href="/images/4174.png">


  <script>
    function myFunction() {
      var input, filter, table, tr, td, i;
      input = document.getElementById("searchbar");
      filter = input.value.toUpperCase();
      table = document.getElementById("myTable");
      tr = table.getElementsByTagName("tr");
      for (i = 0; i < tr.length; i++) {
        td = tr[i].getElementsByTagName("td")[1]; // for column one
        td1 = tr[i].getElementsByTagName("td")[2]; // for column two
        /* ADD columns here that you want you to filter to be used on */
        if (td) {
          if ((td.innerHTML.toUpperCase().indexOf(filter) > -1) || (td1.innerHTML.toUpperCase().indexOf(filter) > -1)) {
            tr[i].style.display = "";
          } else {
            tr[i].style.display = "none";
          }
        }
      }
    }

    function dateandtime() {
      var date = "2012-12-12 05:18:28.541";
      var offset = (3600000 * (+5.50 + 8));
      var dateformate = 'dd/mm/yyyy "at" h:MM TT';

      var dateArray = (date).split(' ');
      var year = dateArray[0].split('-');
      var time = dateArray[1].split(':');

      var d = new Date($.trim(year[0]), $.trim(year[1] - 1), $.trim(year[2]), $.trim(time[0]), $.trim(time[1]));
      var nd = new Date(d.getTime() + offset);
      alert(dateFormat(nd, dateformate));
    }
   
  </script>


</head>

<body>

  <div class="container mt-4">
    <div class="row align-items-center">
      <div class="col-12 col-md-4 text-center text-md-start mb-3 mb-md-0">
        <a href="/daterange" class="btn btn-outline-dark shadow-sm" style="font-weight: 500; border-radius: 8px;">
          <i class="fas fa-arrow-left me-2"></i> Back to Dashboard
        </a>
      </div>
      <div class="col-12 col-md-4 text-center mb-3 mb-md-0">
        <a href="/daterange"><img src="/images/logo.png" style="max-width: 250px; height: auto;" /></a>
      </div>
      <div class="col-12 col-md-4"></div>
    </div>
    <% if(message.length>0){ %>
      <div class="row justify-content-center mt-3">
        <div class="col-md-6 text-center">
          <div class="alert alert-danger shadow-sm">
            <h5 class="mb-0"><%- message %></h5>
          </div>
        </div>
      </div>
    <% } %>
  </div><br>

<!-- TALLY IMPORT SECTION -->
<div class="container mt-4">
  <div class="card shadow-sm border-0" style="border-left: 4px solid #198754 !important;">
    <div class="card-body">
      <h5 class="card-title mb-3">
        <i class="fas fa-file-invoice-dollar me-2 text-success"></i>
        Import Tally Fee Data
      </h5>
      <form action="/import-tally-excel" enctype="multipart/form-data" method="POST" class="row g-2 align-items-center">
        <div class="col-md-4">
          <input type="file" name="import-excel" class="form-control" accept=".xlsx,.xls" required />
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-success">
            <i class="fas fa-upload me-1"></i> Import Fee Structure
          </button>
        </div>
        <div class="col-auto">
          <a href="/tally-preview" class="btn btn-outline-primary">
            <i class="fas fa-table me-1"></i> Review Imported Data
          </a>
        </div>
        <div class="col-auto">
          <button type="submit" form="pushTallyForm" class="btn btn-warning text-dark">
            <i class="fas fa-paper-plane me-1"></i> Push to Student Profiles
          </button>
        </div>
      </form>
      <form id="pushTallyForm" action="/push-tally-data" method="POST" style="display:none;"></form>
      <small class="text-muted mt-2 d-block">
        * Upload the Tally fee Excel (format: Hostel UID, Student Name, Receivables, Received, Balance, As on Date).
        After importing, click "Push to Student Profiles" to verify linkage.
      </small>
    </div>
  </div>
</div><br>

  <!-- Excel Upload Form -->
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Import Hostel Students from Excel</h5>
            <form action="/import-excel-hostel" enctype="multipart/form-data" method="post">
              <div class="mb-3">
                <label for="fileInput" class="form-label">Select Excel File (.xlsx)</label>
                <input type="file" name="import-excel" id="fileInput" class="form-control" accept=".xlsx, .xls" required />
              </div>
              <button type="submit" class="btn btn-primary">Upload</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div><br><br>

  <div class="container">

    <div class="row justify-content-center">
      <div class="input-group rounded">
        <input type="search" class="form-control rounded" placeholder="Search" aria-label="Search" aria-describedby="search-addon" id="searchbar" onkeyup="myFunction()" />

        <i class="fas fa-search"></i>
        </span>
      </div>

    </div>
    <div class="row justify-content-end" style="margin-top: 15px;">
      <div class="col-auto">
        <% if (typeof role !== 'undefined') { %>
          <a href="/studentsupdatehostel/<%= role %>/download" class="btn btn-success">
            <i class="fas fa-file-download"></i> Download Hostel Students (Excel)
          </a>
          <a href="/studentsupdatehostel/<%= encodeURIComponent(role) %>/export-master" class="btn btn-primary shadow-sm" style="font-weight: 500;">
            <i class="fas fa-file-excel"></i> Export Student Biodata
          </a>
        <% } %>
      </div>
    </div>
  </div>
  <div class="container table-responsive py-5">
    <table class="table table-bordered table-hover" id="myTable">
      <thead class="thead-dark">
        <tr>

          <th scope="col">S.N</th>
          <th scope="col">Student UID</th>
          <th scope="col">Hostel ID</th>
          <th scope="col">NAME</th>
          <th scope="col">ACTION</th>
        </tr>
      </thead>
      <tbody>
        <% if(result.length> 0) { %>
        <% for(var i=0;i<result.length;i++){ %>
        <% if(result[i].status=='Restrict') { %>
        <tr class="table-danger">
          <td scope="row"><%- i + 1 %></td>
          <td>
            <a href="/studentprofile/<%-result[i].uid%>?from=hostel&role=<%= role %>">
              <%-result[i].uid%>
            </a>
          </td>
          <td><%- result[i].hostel_id || '-' %></td>
          <td><%- result[i].sname%></td>
          <td>
            <a
              href="/Unrestrictstu/<%-result[i].uid%>?redirect=/studentsupdatehostel/<%= role %>"
              class="btn btn-outline-success btn-sm"
            >
              <i class="fas fa-unlock"></i> Unrestrict
            </a>
          </td>
        </tr>
        <% }else{ %>
        <tr>
          <td scope="row"><%- i + 1 %></td>
          <td>
            <a href="/studentprofile/<%-result[i].uid%>?from=hostel&role=<%= role %>">
              <%-result[i].uid%>
            </a>
          </td>
          <td><%- result[i].hostel_id || '-' %></td>
          <td><%- result[i].sname%></td>
          <td>
            <a
              href="/restrictstu/<%-result[i].uid%>?redirect=/studentsupdatehostel/<%= role %>"
              class="btn btn-outline-danger btn-sm"
              onclick="return confirm('Restrict this student account?');"
            >
              <i class="fas fa-ban"></i> Restrict
            </a>
          </td>
        </tr>

        <% } %>


        <% } %>

        <% }else{ %>
        <tr class="warning no-result">
          <td colspan="10"> <i class="fa fa-warning"></i>
            <center>Data Not found</center>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>

</body>

</html>