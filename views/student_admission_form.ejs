  function setReviewImage(imgId, emptyId, previewId, fileInputId, draftFlagName, fallbackText) {
    var img = document.getElementById(imgId);
    var empty = document.getElementById(emptyId);
    var preview = document.getElementById(previewId);
    var input = document.getElementById(fileInputId);
    var box = img ? img.closest('.border') : null;
    var hasFile = !!(input && input.files && input.files.length > 0);
    var previewVisible = !!(preview && preview.src && preview.style.display !== 'none');

    if (hasFile && previewVisible) {
      img.src = preview.src;
      img.style.display = 'inline-block';
      empty.style.display = 'none';
      if (box) box.classList.remove('border-danger');
      return;
    }

    if (draftPayload && draftPayload.values && draftPayload.values[draftFlagName]) {
      img.style.display = 'none';
      empty.style.display = 'block';
      empty.innerHTML = '<div class="alert alert-danger py-2 mb-0"><i class="fas fa-triangle-exclamation me-1"></i>' + escapeHtml(fallbackText) + '</div>';
      if (box) box.classList.add('border-danger');
      return;
    }

    img.style.display = 'none';
    empty.style.display = 'block';
    empty.innerHTML = '<div class="alert alert-light py-2 mb-0 border"><span class="text-muted">Not available right now</span></div>';
    if (box) box.classList.remove('border-danger');
  }

