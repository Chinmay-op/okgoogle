  function restoreAdmissionDraft() {
    if (!draftPayload || !draftPayload.values) return;

    restoringDraft = true;
    try {
      var form = document.getElementById('admissionForm');
      if (!form) return;

      var controls = form.querySelectorAll('input, select, textarea');
      controls.forEach(function(field) {
        var key = field.id || field.name;
        if (!key || field.type === 'submit' || field.type === 'button' || field.type === 'hidden' || field.type === 'file') {
          return;
        }

        if (field.type === 'radio') {
          field.checked = draftPayload.values['radio:' + field.name] === field.value;
          return;
        }

        if (field.type === 'checkbox') {
          field.checked = !!draftPayload.values['check:' + key];
          return;
        }

        if (Object.prototype.hasOwnProperty.call(draftPayload.values, key)) {
          field.value = draftPayload.values[key];
        }
      });

      var religionSel = document.getElementById('religion');
      var casteSel = document.getElementById('caste_category_select');
      if (religionSel) toggleReligionOther(religionSel);
      if (casteSel) toggleCasteOther(casteSel);

      if (draftPayload.currentStep) {
        var stepNo = parseInt(draftPayload.currentStep, 10);
        if (!isNaN(stepNo) && stepNo >= 1 && stepNo <= 5) {
          currentStep = stepNo;
        }
      }
    } finally {
      restoringDraft = false;
    }
  }

  // ============================================================
  // Auto-advance: Enter key moves to the next Step 1 field
  // ============================================================
  var step1FieldIds = [
    'full_name', 'father_name', 'father_occupation',
    'mother_name', 'mother_occupation', 'permanent_address',
    'parent_phone', 'student_mobile', 'student_email',
    'admission_year', 'branch',
    'dob', 'religion', 'religion_other',
    'caste_category_select', 'caste_category_other',
    'student_photo_input'
  ];

  function getNextVisibleField(currentIndex) {
    for (var i = currentIndex + 1; i < step1FieldIds.length; i++) {
      var el = document.getElementById(step1FieldIds[i]);
      if (el && el.offsetParent !== null && el.style.display !== 'none') {
        return el;
      }
    }
    return null;
  }

  step1FieldIds.forEach(function(fieldId, index) {
    var field = document.getElementById(fieldId);
    if (!field) return;

    var tagName = field.tagName.toLowerCase();

    if (tagName === 'select') {
      // For dropdowns: advance on selection change (when a value is picked)
      field.addEventListener('change', function() {
        if (this.value) {
          var next = getNextVisibleField(index);
          if (next) next.focus();
        }
      });
    } else if (tagName === 'textarea') {
      // For textarea: Shift+Enter advances, plain Enter keeps newline
      field.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && e.shiftKey) {
          e.preventDefault();
          var next = getNextVisibleField(index);
          if (next) next.focus();
        }
      });
    } else {
      // For text/tel/date/file inputs: Enter advances
      field.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          var next = getNextVisibleField(index);
          if (next) next.focus();
        }
      });
    }
  });

  // ============================================================
  // 1. Step Navigation
  // ============================================================
  let currentStep = 1;
  const totalSteps = 5;
  const steps = [null, document.getElementById('step1'), document.getElementById('step2'), document.getElementById('step3'), document.getElementById('step4'), document.getElementById('step5')];

  // Guard: if steps don't exist (submitted state), bail out
  if (!steps[1]) return;

  if (admissionForm) {
    admissionForm.addEventListener('input', saveAdmissionDraft);
    admissionForm.addEventListener('change', saveAdmissionDraft);
  }

  restoreAdmissionDraft();

  function showStep(n) {
    for (let i = 1; i <= totalSteps; i++) {
      steps[i].style.display = (i === n) ? 'block' : 'none';
    }
    currentStep = n;
    updateProgress();
    saveAdmissionDraft();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateProgress() {
    const pct = ((currentStep - 1) / (totalSteps - 1)) * 100;
    document.getElementById('progressBar').style.width = pct + '%';
    document.getElementById('progressBar').textContent = 'Step ' + currentStep + ' of ' + totalSteps;
    for (let i = 1; i <= totalSteps; i++) {
      const circle = document.getElementById('stepCircle' + i);
      const label = document.getElementById('stepLabel' + i);
      circle.className = 'step-circle';
      label.className = 'step-label';
      if (i === currentStep) {
        circle.classList.add('active');
        circle.innerHTML = i;
        label.classList.add('active-label');
      } else if (isStepComplete(i)) {
        circle.classList.add('completed');
        circle.innerHTML = '<i class="fas fa-check"></i>';
      } else if (i < currentStep) {
        circle.classList.add('incomplete');
        circle.innerHTML = i;
        label.classList.add('incomplete-label');
      } else {
        circle.innerHTML = i;
      }
    }
  }

  var progressUpdateTimer = null;
  function scheduleProgressUpdate() {
    if (progressUpdateTimer) return;
    progressUpdateTimer = setTimeout(function() {
      progressUpdateTimer = null;
      updateProgress();
    }, 0);
  }

