<!-- Bootstrap 5 JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Toggle "Other" text input for Caste Category
function toggleCasteOther(sel) {
  var otherInput = document.getElementById('caste_category_other');
  if (sel.value === 'Other') {
    otherInput.style.display = 'block';
    otherInput.required = true;
    otherInput.focus();
  } else {
    otherInput.style.display = 'none';
    otherInput.required = false;
    otherInput.value = '';
  }
}

// Toggle "Other" text input for Religion
function toggleReligionOther(sel) {
  var otherInput = document.getElementById('religion_other');
  if (sel.value === 'Other') {
    otherInput.style.display = 'block';
    otherInput.required = true;
    otherInput.focus();
  } else {
    otherInput.style.display = 'none';
    otherInput.required = false;
    otherInput.value = '';
  }
}

document.addEventListener('DOMContentLoaded', function() {

  // When "Other" is selected for caste, copy typed value into the select's submitted value
  var admissionForm = document.querySelector('form');
  if (admissionForm) {
    admissionForm.addEventListener('submit', function() {
      var casteSel = document.getElementById('caste_category_select');
      var casteOther = document.getElementById('caste_category_other');
      if (casteSel && casteSel.value === 'Other' && casteOther && casteOther.value.trim()) {
        // Replace the select value with the custom typed value
        casteSel.name = '';                     // remove name from select so it won't submit
        casteOther.name = 'caste_category';     // give the text input the real field name
      }
      // Same for Religion
      var religionSel = document.getElementById('religion');
      var religionOther = document.getElementById('religion_other');
      if (religionSel && religionSel.value === 'Other' && religionOther && religionOther.value.trim()) {
        religionSel.name = '';
        religionOther.name = 'religion';
      }
    });
  }

  var ADMISSION_DRAFT_KEY = 'tnps_hostel_admission_draft_v1';
  var draftPayload = null;
  var restoringDraft = false;
  try {
    draftPayload = JSON.parse(localStorage.getItem(ADMISSION_DRAFT_KEY) || 'null');
  } catch (e) {
    draftPayload = null;
  }

  function safeSetDraftItem(payload) {
    try {
      localStorage.setItem(ADMISSION_DRAFT_KEY, JSON.stringify(payload));
    } catch (e) {}
  }

  function saveAdmissionDraft() {
    if (restoringDraft) return;

    var form = document.getElementById('admissionForm');
    if (!form) return;

    var payload = {
      currentStep: currentStep,
      values: {}
    };

    var controls = form.querySelectorAll('input, select, textarea');
    controls.forEach(function(field) {
      var key = field.id || field.name;
      if (!key || field.type === 'submit' || field.type === 'button' || field.type === 'hidden') return;

      if (field.type === 'file') {
        if (field.id === 'student_photo_input') payload.values.__hasPhoto = !!(field.files && field.files.length);
        if (field.id === 'student_sig_input') payload.values.__hasStudentSignature = !!(field.files && field.files.length);
        if (field.id === 'parent_sig_input') payload.values.__hasParentSignature = !!(field.files && field.files.length);
        return;
      }

      if (field.type === 'radio') {
        if (field.checked) payload.values['radio:' + field.name] = field.value;
        return;
      }

      if (field.type === 'checkbox') {
        payload.values['check:' + key] = field.checked;
        return;
      }

      payload.values[key] = field.value;
    });

    safeSetDraftItem(payload);
  }

  function renderUploadWarning(statusEl, message) {
    if (!statusEl) return;
    statusEl.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>' + message + '</span>';
  }

  function renderUploadNeutral(statusEl, message) {
    if (!statusEl) return;
    statusEl.innerHTML = '<span class="text-muted">' + message + '</span>';
  }

  function refreshUploadState() {
    var photoFile = photoInput && photoInput.files && photoInput.files.length > 0;
    var studentSig = document.getElementById('student_sig_input');
    var parentSig = document.getElementById('parent_sig_input');
    var studentFile = studentSig && studentSig.files && studentSig.files.length > 0;
    var parentFile = parentSig && parentSig.files && parentSig.files.length > 0;

    if (photoFile) {
      photoPreview.style.display = 'block';
      renderUploadNeutral(photoStatus, 'Photo selected and ready.');
    } else if (draftPayload && draftPayload.values && draftPayload.values.__hasPhoto) {
      photoPreview.style.display = 'none';
      renderUploadWarning(photoStatus, 'Photo was not retained after refresh. Please upload again.');
    } else {
      photoPreview.style.display = 'none';
      renderUploadNeutral(photoStatus, 'Passport photo not uploaded yet.');
    }

    var studentPreview = document.getElementById('student_sig_preview');
    var studentStatus = document.getElementById('student_sig_status');
    if (studentFile) {
      studentPreview.style.display = 'block';
      renderUploadNeutral(studentStatus, 'Signature uploaded and ready.');
    } else if (draftPayload && draftPayload.values && draftPayload.values.__hasStudentSignature) {
      studentPreview.style.display = 'none';
      renderUploadWarning(studentStatus, 'Student signature was not retained after refresh. Please upload again.');
    } else {
      studentPreview.style.display = 'none';
      renderUploadNeutral(studentStatus, 'Student signature not uploaded yet.');
    }

    var parentPreview = document.getElementById('parent_sig_preview');
    var parentStatus = document.getElementById('parent_sig_status');
    if (parentFile) {
      parentPreview.style.display = 'block';
      renderUploadNeutral(parentStatus, 'Signature uploaded and ready.');
    } else if (draftPayload && draftPayload.values && draftPayload.values.__hasParentSignature) {
      parentPreview.style.display = 'none';
      renderUploadWarning(parentStatus, 'Parent signature was not retained after refresh. Please upload again.');
    } else {
      parentPreview.style.display = 'none';
      renderUploadNeutral(parentStatus, 'Parent signature not uploaded yet.');
    }
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function fieldValue(id) {
    var el = document.getElementById(id);
    return el ? ((el.value || '') + '').trim() : '';
  }

  function radioValue(name) {
    var el = document.querySelector('input[name="' + name + '"]:checked');
    return el ? el.value : '';
  }

  function checkboxLabel(id, label) {
    var el = document.getElementById(id);
    return '<span class="badge ' + (el && el.checked ? 'bg-success' : 'bg-secondary') + '">' + escapeHtml(label) + ': ' + (el && el.checked ? 'Accepted' : 'Not Accepted') + '</span>';
  }

  function isFileValid(inputId) {
    var input = document.getElementById(inputId);
    if (!input || !input.files || input.files.length === 0) return false;
    return !(input.files[0] && input.files[0].size > 500 * 1024);
  }

  function isStep1Complete() {
    var step1 = document.getElementById('step1');
    if (!step1) return false;
    var requiredFields = step1.querySelectorAll('input[required], select[required], textarea[required]');
    for (var i = 0; i < requiredFields.length; i++) {
      var field = requiredFields[i];
      if (field.type === 'file') {
        if (!field.files || field.files.length === 0 || field.files[0].size > 500 * 1024) return false;
      } else if (!field.checkValidity()) {
        return false;
      }
    }
    return true;
  }

  function isStep2Complete() {
    return !!(document.getElementById('messVeg') && document.getElementById('messVeg').checked
      || document.getElementById('messNonVeg') && document.getElementById('messNonVeg').checked);
  }

  function isStep3Complete() {
    return !!(document.getElementById('decl1_check') && document.getElementById('decl1_check').checked
      && document.getElementById('decl2_check') && document.getElementById('decl2_check').checked
      && document.getElementById('undert_check') && document.getElementById('undert_check').checked);
  }

  function isStep4Complete() {
    return isFileValid('student_sig_input') && isFileValid('parent_sig_input');
  }

  function isStep5Complete() {
    var amountRaw = ((document.getElementById('advance_amount') || {}).value || '').trim();
    var amount = amountRaw ? parseFloat(amountRaw) : NaN;
    var hasValidAmount = amountRaw !== '' && !isNaN(amount) && amount > 0;
    var hasMode = !!((document.getElementById('paymentCash') && document.getElementById('paymentCash').checked)
      || (document.getElementById('paymentOnline') && document.getElementById('paymentOnline').checked));
    return hasValidAmount && hasMode;
  }

  function isStepComplete(stepNo) {
    if (stepNo === 1) return isStep1Complete();
    if (stepNo === 2) return isStep2Complete() && isStep1Complete();
    if (stepNo === 3) return isStep3Complete() && isStep2Complete() && isStep1Complete();
    if (stepNo === 4) return isStep4Complete() && isStep3Complete() && isStep2Complete() && isStep1Complete();
    if (stepNo === 5) return isStep5Complete() && isStep4Complete() && isStep3Complete() && isStep2Complete() && isStep1Complete();
    return false;
  }

  function buildReviewSummary() {
    var rows = [
      ['Full Name', fieldValue('full_name') || '--'],
      ["Father's Name", fieldValue('father_name') || '--'],
      ["Father's Occupation", fieldValue('father_occupation') || '--'],
      ["Mother's Name", fieldValue('mother_name') || '--'],
      ["Mother's Occupation", fieldValue('mother_occupation') || '--'],
      ['Permanent Address', fieldValue('permanent_address') || '--'],
      ['Parent Phone', fieldValue('parent_phone') || '--'],
      ['Student Mobile', fieldValue('student_mobile') || '--'],
      ['Student Email', fieldValue('student_email') || '--'],
      ['Admission Year', fieldValue('admission_year') || '--'],
      ['Branch', fieldValue('branch') || '--'],
      ['Date of Birth', fieldValue('dob') || '--'],
      ['Religion', fieldValue('religion') === 'Other' ? fieldValue('religion_other') || 'Other' : fieldValue('religion') || '--'],
      ['Caste Category', fieldValue('caste_category_select') === 'Other' ? fieldValue('caste_category_other') || 'Other' : fieldValue('caste_category_select') || '--'],
      ['Mess Preference', radioValue('mess_preference') || '--'],
