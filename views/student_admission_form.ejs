        + '<div class="fw-semibold" style="word-break:break-word;">' + escapeHtml(row[1]) + '</div>'
        + '</div></div>';
    });

    html += '<div class="col-md-12"><div class="border rounded-3 p-3 bg-light shadow-sm">'
      + '<div class="small text-muted text-uppercase fw-bold mb-2">Declarations</div>'
      + '<div class="d-flex flex-wrap gap-2">'
      + checkboxLabel('decl1_check', 'Declaration 1')
      + checkboxLabel('decl2_check', 'Declaration 2')
      + checkboxLabel('undert_check', 'Undertaking')
      + '</div></div></div>';

    return html;
