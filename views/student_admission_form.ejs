  // ============================================================
  // Anti-Ragging Affidavit Screen helpers
  // ============================================================

  /** Strip trailing parenthetical abbreviation from branch text.
   *  e.g. "Computer Science & Engineering (CSE)" → "Computer Science & Engineering"
   *  Handles CSBS edge case by removing from the LAST " (" onward.
   */
  function stripBranchAbbreviation(branchText) {
    var lastParen = branchText.lastIndexOf(' (');
    if (lastParen !== -1) {
      return branchText.substring(0, lastParen).trim();
    }
    return branchText.trim();
  }

  /** Return ordinal suffix for a day number: 1→"st", 2→"nd", 3→"rd", others→"th" */
  function ordinalSuffix(day) {
    var j = day % 10, k = day % 100;
    if (j === 1 && k !== 11) return 'st';
    if (j === 2 && k !== 12) return 'nd';
    if (j === 3 && k !== 13) return 'rd';
    return 'th';
  }

  var MONTH_NAMES = ['January','February','March','April','May','June',
                     'July','August','September','October','November','December'];

  function populateAntiRaggingScreen() {
    var now = new Date();

    // --- Opening line ---
    var fullName  = (document.getElementById('full_name')  || {}).value || '';
    var fatherName = (document.getElementById('father_name') || {}).value || '';
    var branchSel = document.getElementById('branch');
    var branchRaw = branchSel ? (branchSel.options[branchSel.selectedIndex] || {}).text || '' : '';
    var branchClean = stripBranchAbbreviation(branchRaw);

    var sessionStart = now.getFullYear();
    var sessionEnd   = sessionStart + 1;

    var openingEl = document.getElementById('ar_opening_line');
    if (openingEl) {
      // Image exact wording: "I, {NAME}, S/o Mr./Ms./Mrs. {FATHER},"
      openingEl.textContent = 'I, ' + fullName + ', S/o Mr. ' + fatherName + ',';
    }

    // Clause 1 dynamic spans: branch name and academic session year
    var branchSpan  = document.getElementById('ar_branch_span');
    var sessionSpan = document.getElementById('ar_session_span');
    if (branchSpan)  branchSpan.textContent  = branchClean || '______';
    if (sessionSpan) sessionSpan.textContent = sessionStart + ' - ' + sessionEnd;

    // --- Declared date line ---
    var day   = now.getDate();
    var month = MONTH_NAMES[now.getMonth()];
    var year  = now.getFullYear();
    var declaredEl = document.getElementById('ar_declared_line');
    if (declaredEl) {
      declaredEl.textContent = 'Declared this ' + day + ordinalSuffix(day)
        + ' Day of ' + month + ' Month of ' + year + ' Year.';
    }

    // --- Parent signature ---
    var parentSigInput   = document.getElementById('parent_sig_input');
    var parentSigImg     = document.getElementById('ar_parent_sig_img');
    var parentSigEmpty   = document.getElementById('ar_parent_sig_empty');
    var parentNameEl     = document.getElementById('ar_parent_name');
    var parentMobileEl   = document.getElementById('ar_parent_mobile');
    var parentPhoneVal   = (document.getElementById('parent_phone') || {}).value || '';

    if (parentNameEl)   parentNameEl.textContent   = 'Name : ' + fatherName;
    if (parentMobileEl) parentMobileEl.textContent = 'Mobile No : ' + parentPhoneVal;

    if (parentSigInput && parentSigInput.files && parentSigInput.files.length > 0) {
      var parentReader = new FileReader();
      parentReader.onload = function(e) {
        if (parentSigImg)   { parentSigImg.src = e.target.result; parentSigImg.style.display = 'block'; }
        if (parentSigEmpty) parentSigEmpty.style.display = 'none';
      };
      parentReader.readAsDataURL(parentSigInput.files[0]);
    } else {
      // Fallback: try existing preview
      var parentPreview = document.getElementById('parent_sig_preview');
      if (parentPreview && parentPreview.src && parentPreview.style.display !== 'none') {
        if (parentSigImg)   { parentSigImg.src = parentPreview.src; parentSigImg.style.display = 'block'; }
        if (parentSigEmpty) parentSigEmpty.style.display = 'none';
      } else {
        if (parentSigImg)   parentSigImg.style.display = 'none';
        if (parentSigEmpty) parentSigEmpty.style.display = 'inline-block';
      }
    }

    // --- Student / Deponent signature ---
    var studentSigInput  = document.getElementById('student_sig_input');
    var studentSigImg    = document.getElementById('ar_student_sig_img');
    var studentSigEmpty  = document.getElementById('ar_student_sig_empty');
    var studentNameEl    = document.getElementById('ar_student_name');
    var studentMobileEl  = document.getElementById('ar_student_mobile');
    var studentMobileVal = (document.getElementById('student_mobile') || {}).value || '';

    if (studentNameEl)   studentNameEl.textContent   = 'Name : ' + fullName;
    if (studentMobileEl) studentMobileEl.textContent = 'Mobile No : ' + studentMobileVal;

    if (studentSigInput && studentSigInput.files && studentSigInput.files.length > 0) {
      var studentReader = new FileReader();
      studentReader.onload = function(e) {
        if (studentSigImg)   { studentSigImg.src = e.target.result; studentSigImg.style.display = 'block'; }
        if (studentSigEmpty) studentSigEmpty.style.display = 'none';
      };
      studentReader.readAsDataURL(studentSigInput.files[0]);
    } else {
      // Fallback: try existing preview
      var studentPreview = document.getElementById('student_sig_preview');
      if (studentPreview && studentPreview.src && studentPreview.style.display !== 'none') {
        if (studentSigImg)   { studentSigImg.src = studentPreview.src; studentSigImg.style.display = 'block'; }
        if (studentSigEmpty) studentSigEmpty.style.display = 'none';
      } else {
        if (studentSigImg)   studentSigImg.style.display = 'none';
        if (studentSigEmpty) studentSigEmpty.style.display = 'inline-block';
      }
    }
  }

  function showAntiRaggingScreen() {
    // Hide all step divs
    for (var i = 1; i <= totalSteps; i++) {
      steps[i].style.display = 'none';
    }
    // Show the anti-ragging screen
    var arScreen = document.getElementById('antiRaggingScreen');
    if (arScreen) arScreen.style.display = 'block';
    populateAntiRaggingScreen();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function hideAntiRaggingScreen() {
    var arScreen = document.getElementById('antiRaggingScreen');
    if (arScreen) arScreen.style.display = 'none';
  }

  // Anti-ragging screen buttons
  var arBackBtn = document.getElementById('ar-back-btn');
  var arContinueBtn = document.getElementById('ar-continue-btn');
  if (arBackBtn) {
    arBackBtn.addEventListener('click', function() {
      hideAntiRaggingScreen();
      showStep(4);
    });
  }
  if (arContinueBtn) {
    arContinueBtn.addEventListener('click', function() {
      hideAntiRaggingScreen();
      showStep(5);
    });
  }

  // step4-next now shows the Anti-Ragging screen instead of jumping directly to step 5
  step4Next.addEventListener('click', function() {
    showAntiRaggingScreen();
  });
  if (reviewDetailsBtn) {
    reviewDetailsBtn.addEventListener('click', function() {
      renderReviewModal();
      if (reviewModal) reviewModal.show();
    });
  }
  var goMissingUploadsBtn = document.getElementById('goMissingUploadsBtn');
  if (goMissingUploadsBtn) {
    goMissingUploadsBtn.addEventListener('click', function() {
      if (reviewModal) reviewModal.hide();
      showStep(1);
      setTimeout(function() {
        var target = document.getElementById('student_photo_input');
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        if (target && typeof target.focus === 'function') {
          target.focus({ preventScroll: true });
        }
      }, 150);
    });
  }
  finalSubmit.addEventListener('click', function() {
    if (submissionInProgress) return;
    new bootstrap.Modal(document.getElementById('confirmModal')).show();
  });

  document.getElementById('confirmSubmitBtn').addEventListener('click', function() {
    if (submissionInProgress) return;
    submissionInProgress = true;
    this.disabled = true;
    this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Submitting...';
    if (finalSubmit) finalSubmit.disabled = true;
    // Force uppercase full name
    var fn = document.querySelector('input[name="full_name"]');
    if (fn) fn.value = fn.value.toUpperCase();
    document.getElementById('admissionForm').submit();
  });

  document.getElementById('step4-prev').addEventListener('click', function() { showStep(3); });

  // ============================================================
  // 6. Step 5 — Payment Amount & Mode
  // ============================================================
  var advanceAmountInput = document.getElementById('advance_amount');
  var paymentCash = document.getElementById('paymentCash');
  var paymentOnline = document.getElementById('paymentOnline');
  var cashCard = document.getElementById('cashCard');
  var onlineCard = document.getElementById('onlineCard');
  var advanceAmountStatus = document.getElementById('advance_amount_status');
  var paymentModeStatus = document.getElementById('payment_mode_status');

  function selectPaymentMode(mode) {
    if (mode === 'Cash') {
      paymentCash.checked = true;
      paymentOnline.checked = false;
      cashCard.classList.add('selected');
      onlineCard.classList.remove('selected');
    } else if (mode === 'Online') {
      paymentOnline.checked = true;
      paymentCash.checked = false;
      onlineCard.classList.add('selected');
      cashCard.classList.remove('selected');
    }
    validateStep5();
    saveAdmissionDraft();
  }

  function validateStep5() {
    var amountRaw = (advanceAmountInput.value || '').trim();
    var amount = amountRaw ? parseFloat(amountRaw) : NaN;
    var hasValidAmount = amountRaw !== '' && !isNaN(amount) && amount > 0;
    var hasMode = paymentCash.checked || paymentOnline.checked;

    if (amountRaw === '') {
      advanceAmountStatus.innerHTML = '<span class="text-muted">Enter the advance amount to proceed.</span>';
    } else if (!hasValidAmount) {
      advanceAmountStatus.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>Please enter a valid amount greater than zero.</span>';
    } else {
      advanceAmountStatus.innerHTML = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Stored as Rs. ' + amount.toFixed(2) + '</span>';
    }

    if (!hasMode) {
      paymentModeStatus.innerHTML = '<span class="text-muted">Select Cash or Online.</span>';
    } else {
      paymentModeStatus.innerHTML = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>' + (paymentCash.checked ? 'Cash selected' : 'Online selected') + '</span>';
    }

    finalSubmit.disabled = !(hasValidAmount && hasMode && signaturesValid);
    scheduleProgressUpdate();
  }

  cashCard.addEventListener('click', function() { selectPaymentMode('Cash'); });
  onlineCard.addEventListener('click', function() { selectPaymentMode('Online'); });
  paymentCash.addEventListener('change', validateStep5);
  paymentOnline.addEventListener('change', validateStep5);
  advanceAmountInput.addEventListener('input', validateStep5);
  advanceAmountInput.addEventListener('change', validateStep5);
  document.getElementById('step5-prev').addEventListener('click', function() { showStep(4); });

  function syncRestoredWizardState() {
    if (!draftPayload || !draftPayload.values) {
      refreshUploadState();
      validateStep1();
      checkDeclarations();
      validateStep4();
      validateStep5();
      showStep(currentStep || 1);
      return;
    }

    var savedMess = draftPayload.values['radio:mess_preference'];
    if (savedMess === 'Veg' || savedMess === 'Non-Veg') {
      selectMess(savedMess);
    }

    var savedPayment = draftPayload.values['radio:payment_mode'];
    if (savedPayment === 'Cash' || savedPayment === 'Online') {
      selectPaymentMode(savedPayment);
    }

    if (decl1.checked) {
      decl2Wrapper.style.display = 'block';
    }
    if (!decl1.checked) {
      decl2.checked = false;
      undert.checked = false;
      decl2Wrapper.style.display = 'none';
      undertWrapper.style.display = 'none';
    } else if (!decl2.checked) {
      undert.checked = false;
      undertWrapper.style.display = 'none';
    } else {
      undertWrapper.style.display = 'block';
    }

    refreshUploadState();
    validateStep1();
    checkDeclarations();
    validateStep4();
    validateStep5();
    showStep(currentStep || 1);
  }

  // ============================================================
  // 7. Set DOB max & Submission Date
  // ============================================================
  document.getElementById('dob').max = new Date().toISOString().split('T')[0];
  document.getElementById('submission_date_display').value = new Date().toLocaleDateString('en-IN', {
    timeZone: 'Asia/Kolkata',
    day: '2-digit',
    month: 'long',
    year: 'numeric'
  });

  // Init
  syncRestoredWizardState();
});
</script>
</body>
</html>
