<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hostel Admission Form — TNPS Boys Hostel</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome 6 -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <!-- Google Fonts Poppins -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { background-color: #edfffb; font-family: 'Poppins', sans-serif; color: #333; }
    .header-gradient { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px 20px; border-radius: 15px 15px 0 0; text-align: center; }
    .form-card { border-radius: 15px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); background: white; margin-bottom: 40px; border: none; }
    .step-card { padding: 30px; }
    .btn-gradient { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; font-weight: 600; padding: 12px 24px; border-radius: 8px; transition: transform 0.2s, box-shadow 0.2s; }
    .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4); color: white; }
    .btn-gradient:disabled { opacity: 0.6; cursor: not-allowed; transform: none; box-shadow: none; }
    .success-card { text-align: center; padding: 50px 20px; }
    .success-icon { font-size: 80px; color: #28a745; margin-bottom: 20px; }

    /* Remove arrows from number input */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type="number"] {
      -moz-appearance: textfield;
    }

    /* Progress bar */
    .step-progress { display: flex; justify-content: space-between; align-items: flex-start; margin: 20px 0 30px; position: relative; }
    .step-circle { margin: 0 auto; width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1rem; border: 3px solid #ccc; background: white; color: #aaa; z-index: 2; transition: all 0.3s ease; }
    .step-circle.active { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-color: #667eea; box-shadow: 0 0 15px rgba(102,126,234,0.4); }
    .step-circle.completed { background: #28a745; color: white; border-color: #28a745; }
    .step-circle.incomplete { background: #fff; color: #dc3545; border-color: #dc3545; }
    .step-label { font-size: 0.75rem; color: #888; text-align: center; margin-top: 5px; }
    .step-label.active-label { color: #667eea; font-weight: 600; }
    .step-label.incomplete-label { color: #dc3545; font-weight: 600; }
    .draft-note { color: #dc3545; font-weight: 600; }

    /* Mess preference cards */
    .mess-card { border: 2px solid #dee2e6; border-radius: 15px; padding: 30px 20px; text-align: center; cursor: pointer; transition: all 0.3s ease; background: white; }
    .mess-card:hover { border-color: #aaa; transform: translateY(-3px); box-shadow: 0 5px 20px rgba(0,0,0,0.1); }
    .mess-card.selected { transform: translateY(-3px); box-shadow: 0 5px 20px rgba(0,0,0,0.15); }
    #vegCard.selected { border-color: #28a745; border-width: 3px; }
    #nonVegCard.selected { border-color: #dc3545; border-width: 3px; }
    .mess-icon { font-size: 48px; margin-bottom: 15px; }

    /* Payment mode cards */
    .payment-card { border: 2px solid #dee2e6; border-radius: 15px; padding: 24px 18px; text-align: center; cursor: pointer; transition: all 0.3s ease; background: white; min-height: 150px; }
    .payment-card:hover { border-color: #667eea; transform: translateY(-3px); box-shadow: 0 5px 20px rgba(0,0,0,0.1); }
    .payment-card.selected { transform: translateY(-3px); box-shadow: 0 5px 20px rgba(0,0,0,0.15); border-width: 3px; }
    .payment-card.cash.selected { border-color: #17a2b8; }
    .payment-card.online.selected { border-color: #28a745; }
    .payment-icon { font-size: 42px; margin-bottom: 12px; }

    /* Declaration cards */
    .declaration-card { border: 1px solid #e0e0e0; border-radius: 10px; padding: 20px; margin-bottom: 20px; background: #fcfcfc; transition: opacity 0.4s ease, max-height 0.4s ease; }
    .declaration-text { background-color: #eef2f7; padding: 15px; border-radius: 0 5px 5px 0; font-style: italic; line-height: 1.7; }

    /* Signature upload cards */
    .sig-upload-card { border: 2px dashed #dee2e6; border-radius: 15px; padding: 25px; text-align: center; transition: border-color 0.3s; }
    .sig-upload-card:hover { border-color: #667eea; }

    /* ========== ANTI-RAGGING AFFIDAVIT SCREEN ========== */
    #antiRaggingScreen { display: none; }
    .ar-screen-card { border: 1.5px solid #dee2e6; border-radius: 12px; padding: 28px 32px; background: #fff; }
    .ar-screen-card h2 { font-size: 1.15rem; font-weight: 700; text-decoration: underline; color: #1a3a8f; }
    .ar-screen-card h5 { font-size: 1.0rem; font-weight: 700; }
    .ar-opening { font-size: 0.95rem; margin-bottom: 10px; }
    .ar-clause-list { font-size: 0.9rem; line-height: 1.75; padding-left: 20px; }
    .ar-clause-list li { margin-bottom: 6px; }
    .ar-declared { font-size: 0.9rem; margin-top: 16px; margin-bottom: 20px; }
    .ar-sig-block { text-align: center; }
    .ar-sig-img { display: block; margin: 0 auto 4px auto; max-width: 180px; max-height: 80px; object-fit: contain; border: 1px solid #ccc; border-radius: 4px; background: #fafafa; }
    .ar-sig-empty { display: inline-block; width: 180px; height: 60px; border: 2px dashed #aaa; border-radius: 4px; background: #fafafa; }
    .ar-sig-label { font-size: 0.78rem; color: #555; margin-top: 3px; }
    .ar-sig-name { font-weight: 600; font-size: 0.88rem; }
    .ar-sig-mobile { font-size: 0.82rem; color: #555; }
    .ar-sub-clause-list { margin-top: 5px; margin-bottom: 2px; padding-left: 22px; list-style-type: lower-alpha; font-size: 0.9rem; line-height: 1.75; }
    .ar-sub-clause-list li { margin-bottom: 5px; }

    /* Extra utility styles */
    .progress { height: 22px; border-radius: 12px; background-color: #e9ecef; }
    .progress-bar { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); font-size: 0.75rem; font-weight: 600; border-radius: 12px; transition: width 0.4s ease; }
    .step-connector { flex: 1; height: 3px; background: #dee2e6; z-index: 1; margin-top: 21px; }
    .card-step-heading { font-size: 1.3rem; font-weight: 600; color: #4a4a6a; margin-bottom: 5px; }
    .form-label { font-weight: 500; margin-bottom: 4px; }
    .form-control:focus, .form-select:focus { border-color: #667eea; box-shadow: 0 0 0 0.2rem rgba(102,126,234,0.25); }

    /* ========== MOBILE RESPONSIVE ========== */
    @media (max-width: 576px) {
      .step-card { padding: 18px 14px; }
      .header-gradient { padding: 20px 14px; }
      .header-gradient h1 { font-size: 1.2rem; }
      .header-gradient h5 { font-size: 0.85rem; }

      /* 1. Smaller buttons on mobile */
      .btn-gradient { padding: 8px 14px !important; font-size: 0.82rem !important; }
      .btn-outline-secondary { padding: 8px 14px !important; font-size: 0.82rem !important; }
      .btn-gradient.btn-lg, .btn-outline-primary.btn-lg { padding: 10px 18px !important; font-size: 0.9rem !important; }

      /* 4. Step circles – smaller and tighter spacing */
      .step-progress { margin: 12px 0 20px; gap: 2px; }
      .step-circle { width: 34px; height: 34px; font-size: 0.8rem; border-width: 2px; }
      .step-label { font-size: 0.62rem; max-width: 75px; line-height: 1.2; }
      .step-connector { height: 2px; margin-top: 16px; }
      .progress { height: 18px; }
      .progress-bar { font-size: 0.65rem; }
      .card-step-heading { font-size: 1.1rem; }

      /* 3. Signature previews constrained */
      .sig-upload-card { padding: 15px 10px; }
      .sig-upload-card img { max-width: 100% !important; max-height: 160px !important; width: auto !important; height: auto !important; }

      /* Mess cards */
      .mess-card { padding: 20px 12px; }
      .mess-icon { font-size: 36px; margin-bottom: 10px; }

      /* Payment cards */
      .payment-card { padding: 18px 10px; min-height: 130px; }
      .payment-icon { font-size: 32px; margin-bottom: 8px; }
    }
  </style>
</head>
<body>

<div class="container py-4" style="max-width: 900px;">

  <!-- Page Header Card -->
  <div class="form-card">
    <div class="header-gradient">
      <h1 class="mb-1">The Nagpur Pallottine Society Boys Hostel</h1>
      <h5 class="mb-2">Gavasi Manapur, Wardha Road, Nagpur-441108</h5>
      <p class="fst-italic mb-0">"Home Away From Home"</p>
    </div>

    <div class="step-card">

      <% if(submitted) { %>
        <!-- ============ SUCCESS STATE ============ -->
        <div class="success-card">
          <div class="success-icon">
            <i class="fas fa-check-circle"></i>
          </div>
          <h2 class="fw-bold" style="color: #28a745;">Application Submitted Successfully!</h2>
          <p class="text-muted mt-3 mb-4" style="font-size:1.1rem;">Your application has been submitted. The hostel office will review it and contact you.</p>
          <script>
            try { localStorage.removeItem('tnps_hostel_admission_draft_v1'); } catch (e) {}
          </script>
          <a href="/loginpanel" class="btn btn-gradient btn-lg"><i class="fas fa-home me-2"></i>Back to Home</a>
        </div>

      <% } else { %>
        <!-- ============ FLASH MESSAGE ============ -->
        <% if (message && message.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <!-- ============ PROGRESS BAR ============ -->
        <div class="progress mb-3">
          <div class="progress-bar" role="progressbar" id="progressBar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">Step 1 of 5</div>
        </div>

        <!-- Step Circles -->
        <div class="step-progress">
          <div class="text-center">
            <div class="step-circle active" id="stepCircle1">1</div>
            <div class="step-label active-label" id="stepLabel1">Personal Details</div>
          </div>
          <div class="step-connector"></div>
          <div class="text-center">
            <div class="step-circle" id="stepCircle2">2</div>
            <div class="step-label" id="stepLabel2">Mess Preference</div>
          </div>
          <div class="step-connector"></div>
          <div class="text-center">
            <div class="step-circle" id="stepCircle3">3</div>
            <div class="step-label" id="stepLabel3">Declarations</div>
          </div>
          <div class="step-connector"></div>
          <div class="text-center">
            <div class="step-circle" id="stepCircle4">4</div>
            <div class="step-label" id="stepLabel4">Signatures</div>
          </div>
          <div class="step-connector"></div>
          <div class="text-center">
            <div class="step-circle" id="stepCircle5">5</div>
            <div class="step-label" id="stepLabel5">Payment &amp; Submit</div>
          </div>
        </div>

        <!-- ============ FORM ============ -->
        <form action="/student/admission-form" method="POST" enctype="multipart/form-data" id="admissionForm">
          <input type="hidden" name="submission_token" value="<%= submissionToken %>">

          <!-- ===================== STEP 1 — Personal Details ===================== -->
          <div id="step1">
            <div class="card border-0 mb-4">
              <div class="card-body p-0">
                <h4 class="card-step-heading"><i class="fas fa-user me-2" style="color:#667eea;"></i>Step 1: Personal Details</h4>
                <hr>

                <div class="alert alert-info py-2">
                  <i class="fas fa-info-circle me-1"></i> All fields marked <strong>*</strong> are required.
                </div>

                <!-- Full Name -->
                <div class="mb-3">
                  <label for="full_name" class="form-label">Full Name in Block Letters <span class="text-danger">*</span></label>
                  <input type="text" class="form-control text-uppercase" name="full_name" id="full_name" required maxlength="100" placeholder="YOUR FULL NAME">
                </div>

                <!-- Father / Mother row -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label for="father_name" class="form-label">Father's Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="father_name" id="father_name" required maxlength="100">
                  </div>
                  <div class="col-md-6 mb-3">
                    <label for="father_occupation" class="form-label">Father's Occupation <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="father_occupation" id="father_occupation" maxlength="100" required>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label for="mother_name" class="form-label">Mother's Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="mother_name" id="mother_name" required maxlength="100">
                  </div>
                  <div class="col-md-6 mb-3">
                    <label for="mother_occupation" class="form-label">Mother's Occupation <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="mother_occupation" id="mother_occupation" maxlength="100" required>
                  </div>
                </div>

                <!-- Permanent Address -->
                <div class="mb-3">
                  <label for="permanent_address" class="form-label">Permanent / Postal Address <span class="text-danger">*</span></label>
                  <textarea class="form-control" name="permanent_address" id="permanent_address" rows="3" required maxlength="500"></textarea>
                </div>

                <!-- Phone numbers -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label for="parent_phone" class="form-label">Parent Phone No. <span class="text-danger">*</span></label>
                    <!-- pattern="[0-9+\-\s]{7,15}" -->
                    <input type="tel" class="form-control" name="parent_phone" id="parent_phone" required  maxlength="15" placeholder="e.g. 9876543210">
                  </div> 

                  <div class="col-md-6 mb-3">
                    <label for="student_mobile" class="form-label">Student Mobile Number <span class="text-danger">*</span></label>
                    <!-- pattern="[6-9][0-9]{9}" -->
                    <input type="tel" class="form-control" name="student_mobile" id="student_mobile" required  maxlength="10" title="Enter 10-digit Indian mobile number starting with 6-9" placeholder="e.g. 9876543210">
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-12 mb-3">
                    <label for="student_email" class="form-label">Student Personal Email <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" name="student_email" id="student_email" required maxlength="255" placeholder="e.g. student@example.com">
                  </div>
                </div>

                <!-- Admission Year / Branch -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label for="admission_year" class="form-label">Year of Admission <span class="text-danger">*</span></label>
                    <select class="form-select" name="admission_year" id="admission_year" required>
                      <option value="">-- Select Year --</option>
                      <option value="1">First Year</option>
                      <option value="2">Second Year</option>
                      <option value="3">Third Year</option>
                      <option value="4">Fourth Year</option>
                    </select>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label for="branch" class="form-label">Branch / Department <span class="text-danger">*</span></label>
                    <select class="form-select" name="branch" id="branch" required>
                      <option value="">-- Select Branch / Department --</option>
                      <optgroup label="B.Tech.">
                        <option value="COMPUTER ENGINEERING">Computer Science &amp; Engineering (CSE)</option>
                        <option value="ELECTRICAL ENGINEERING">Electrical Engineering</option>
                        <option value="INFORMATION TECHNOLOGY">Information Technology (IT)</option>
                        <option value="ELECTRONICS &amp; TELECOMMUNICATION ENGINEERING">Electronics &amp; Telecommunication Engineering (ETC)</option>
                        <option value="MECHANICAL ENGINEERING">Mechanical Engineering</option>
                        <option value="CIVIL ENGINEERING">Civil Engineering</option>
                        <option value="ARTIFICIAL INTELLIGENCE">Artificial Intelligence (AI)</option>
                        <option value="COMPUTER SCIENCE &amp; ENGINEERING (DATA SCIENCE)">Computer Science &amp; Engineering (Data Science)</option>
                        <option value="COMPUTER SCIENCE &amp; ENGINEERING (CYBER SECURITY)">Computer Science &amp; Engineering (Cyber Security)</option>
                        <option value="INDUSTRIAL IOT">Industrial IoT (IIoT)</option>
                        <option value="COMPUTER SCIENCE AND BUSINESS SYSTEMS">Computer Science and Business Systems (CSBS)</option>
                        <option value="ROBOTICS &amp; ARTIFICIAL INTELLIGENCE">Robotics &amp; Artificial Intelligence (RAI)</option>
                        <option value="MECHANICAL CAD-CAM">Mechanical CAD-CAM</option>
                      </optgroup>
                      <optgroup label="B.Voc.">
                        <option value="B.VOC. IN CYBER SECURITY">B.Voc. in Cyber Security</option>
                        <option value="B.VOC. IN SOFTWARE DEVELOPMENT">B.Voc. in Software Development</option>
                        <option value="B.VOC. IN VIRTUAL REALITY &amp; AUGMENTED REALITY">B.Voc. in Virtual Reality &amp; Augmented Reality</option>
                        <option value="B VOCATIONAL">B Vocational</option>
                      </optgroup>
                      <optgroup label="Other Programs">
                        <option value="BCA">BCA</option>
                        <option value="BBA">BBA</option>
                        <option value="MCA">MCA</option>
                        <option value="MBA">MBA</option>
                        <option value="M.TECH">M.Tech</option>
                        <option value="M.TECH CSE">M.Tech CSE</option>
                        <option value="M.TECH CADCAM">M.Tech CAD-CAM</option>
                      </optgroup>
                    </select>
                  </div>
                </div>

                <!-- DOB / Religion -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label for="dob" class="form-label">Date of Birth <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" name="dob" id="dob" required>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label for="religion" class="form-label">Religion <span class="text-danger">*</span></label>
                    <select class="form-select" name="religion" id="religion" required onchange="toggleReligionOther(this)">
                      <option value="">-- Select --</option>
                      <option value="Hindu">Hindu</option>
                      <option value="Muslim">Muslim</option>
                      <option value="Christian">Christian</option>
                      <option value="Sikh">Sikh</option>
                      <option value="Parsi">Parsi</option>
                      <option value="Buddhist">Buddhist</option>
                      <option value="Jain">Jain</option>
                      <option value="Other">Other</option>
                    </select>
                    <input type="text" class="form-control mt-2" name="religion_other" id="religion_other" maxlength="50" placeholder="Please specify your religion" style="display:none;">
                  </div>
                </div>

                <!-- Caste Category -->
                <div class="mb-3">
                  <label for="caste_category_select" class="form-label">Caste Category <span class="text-danger">*</span></label>
                  <select class="form-select" name="caste_category" id="caste_category_select" required onchange="toggleCasteOther(this)">
                    <option value="">-- Select Caste Category --</option>
                    <option value="SC">SC</option>
                    <option value="ST">ST</option>
                    <option value="OBC">OBC</option>
                    <option value="VJNT">VJNT</option>
                    <option value="General">General</option>
                    <option value="Other">Other</option>
                  </select>
                  <input type="text" class="form-control mt-2" name="caste_category_other" id="caste_category_other" maxlength="50" placeholder="Please specify your caste category" style="display:none;">
                </div>

                <!-- Student Passport Photo Upload -->
                <div class="mb-4 p-3 rounded" style="background: #f8f9fa; border: 1px solid #e0e0e0;">
                  <label for="student_photo_input" class="form-label fw-semibold">
                    <i class="fas fa-camera me-1" style="color:#667eea;"></i> Passport Size Photograph <span class="text-danger">*</span>
                  </label>
                  <small class="d-block text-muted mb-2">Accepted: JPEG, PNG, WebP &nbsp;|&nbsp; Max size: 500 KB</small>
                  <input type="file" class="form-control" name="student_photo" id="student_photo_input" accept="image/jpeg,image/jpg,image/png,image/webp" required>
                  <img id="photo_preview" style="display:none; width:120px; height:150px; object-fit:cover; border:2px solid #ddd; border-radius:8px; margin-top:10px;" alt="Photo Preview">
                  <div id="photo_status" class="mt-2"></div>
                </div>

                <!-- Step 1 Buttons -->
                <div class="d-flex justify-content-end mt-4">
                  <button type="button" class="btn btn-gradient" id="step1-next" disabled>
                    Next: Mess Preference <i class="fas fa-arrow-right ms-2"></i>
                  </button>
                </div>

              </div>
            </div>
          </div>
          <!-- END STEP 1 -->

          <!-- ===================== STEP 2 — Mess Preference ===================== -->
          <div id="step2" style="display:none;">
            <div class="card border-0 mb-4">
              <div class="card-body p-0">
                <h4 class="card-step-heading"><i class="fas fa-utensils me-2" style="color:#667eea;"></i>Step 2: Mess Preference</h4>
                <hr>

                <div class="row justify-content-center g-4 my-3">
                  <!-- Veg Card -->
                  <div class="col-md-5">
                    <div class="mess-card" id="vegCard">
                      <div class="mess-icon text-success">
                        <i class="fas fa-leaf"></i>
                      </div>
                      <h4 class="fw-bold">Vegetarian</h4>
                      <small class="text-muted">Vegetarian meals served daily</small>
                      <input type="radio" name="mess_preference" value="Veg" id="messVeg" class="d-none" required>
                    </div>
                  </div>
                  <!-- Non-Veg Card -->
                  <div class="col-md-5">
                    <div class="mess-card" id="nonVegCard">
                      <div class="mess-icon text-danger">
                        <i class="fas fa-drumstick-bite"></i>
                      </div>
                      <h4 class="fw-bold">Non-Vegetarian</h4>
                      <small class="text-muted">Includes egg &amp; meat options</small>
                      <input type="radio" name="mess_preference" value="Non-Veg" id="messNonVeg" class="d-none" required>
                    </div>
                  </div>
                </div>

                <!-- Step 2 Buttons -->
                <div class="d-flex justify-content-between mt-4">
                  <button type="button" class="btn btn-outline-secondary px-4 py-2" id="step2-prev">
                    <i class="fas fa-arrow-left me-2"></i> Previous
                  </button>
                  <button type="button" class="btn btn-gradient" id="step2-next" disabled>
                    Next: Declarations <i class="fas fa-arrow-right ms-2"></i>
                  </button>
                </div>

              </div>
            </div>
          </div>
          <!-- END STEP 2 -->

          <!-- ===================== STEP 3 — Declarations ===================== -->
          <div id="step3" style="display:none;">
            <div class="card border-0 mb-4">
              <div class="card-body p-0">
                <h4 class="card-step-heading"><i class="fas fa-file-alt me-2" style="color:#667eea;"></i>Step 3: Read &amp; Accept Declarations</h4>
                <hr>

                <div class="alert alert-warning py-2">
                  <i class="fas fa-exclamation-triangle me-1"></i> Please read all three declarations carefully. You must accept each to continue.
