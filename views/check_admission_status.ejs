<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Check Admission Status</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        body {
            background-color: #f0f2f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 0 0 15px 15px;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
            padding: 0.8rem 2rem;
        }

        .card {
            border-radius: 12px;
        }

        .status-badge {
            font-size: 1rem;
            padding: 8px 16px;
            border-radius: 20px;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-custom mb-4">
        <div class="container-fluid">
            <span class="navbar-brand text-white fw-bold"><i class="fas fa-university me-2"></i>Hostel Admission</span>
            <div class="navbar-nav ms-auto">
                <a href="/student/login" class="nav-item nav-link text-white">Home</a>
            </div>
        </div>
    </nav>

    <div class="container py-4" style="max-width: 800px;">
        <% if(message && message.length> 0) { %>
            <div class="alert alert-info shadow-sm rounded-3">
                <i class="fas fa-info-circle me-2"></i><%- message %>
            </div>
            <% } %>

                <% if (newApplication) { %>
                    <div class="alert alert-success shadow-sm rounded-3">
                        <h4 class="alert-heading"><i class="fas fa-check-circle me-2"></i>Application Submitted
                            Successfully!</h4>
                        <p>Your application ID is <strong>
                                <%= prefillAppId %>
                            </strong>. Please save this ID to check your status later.</p>
                    </div>
                    <% } %>

                        <% if (!result) { %>
                            <div class="card shadow border-0 mb-5">
                                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 text-center">
                                    <h3 class="fw-bold text-primary mb-1">Check Admission Status</h3>
                                    <p class="text-muted">Enter your application details below</p>
                                </div>
                                <div class="card-body p-4 p-md-5 pt-3">
                                    <form action="/check-admission-status" method="POST">
                                        <div class="mb-4">
                                            <label class="form-label fw-bold">Application ID</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light"><i
                                                        class="fas fa-hashtag"></i></span>
                                                <input type="number" name="application_id" class="form-control"
                                                    placeholder="e.g. 1024" value="<%= prefillAppId %>" required>
                                            </div>
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label fw-bold">Registered Mobile Number</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light"><i
                                                        class="fas fa-phone"></i></span>
                                                <input type="tel" name="student_mobile" class="form-control"
                                                    placeholder="10-digit mobile number" required>
                                            </div>
                                        </div>

                                        <div class="d-grid mt-4">
                                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                                <i class="fas fa-search me-2"></i>Check Status
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <% } %>

                                <% if (result) { %>

                                    <div class="text-end mb-3">
                                        <button class="btn btn-success shadow-sm" onclick="saveScreenshot()">
                                            <i class="fas fa-camera me-2"></i>Save Screenshot
                                        </button>
                                    </div>

                                    <div id="statusCard" class="card shadow border-0 overflow-hidden">
                                        <div class="card-header text-white"
                                            style="background: linear-gradient(135deg, #11998e, #38ef7d);">
                                            <h4 class="mb-0 py-1"><i class="fas fa-clipboard-check me-2"></i>Application
                                                Status</h4>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-hover mb-0">
                                                    <tbody>
                                                        <tr>
                                                            <th class="ps-4 w-35 bg-light">Application ID</th>
                                                            <td><span class="fw-bold text-primary">#<%= result.id %>
                                                                        </span></td>
                                                        </tr>
                                                        <tr>
                                                            <th class="ps-4 bg-light">Student Name</th>
                                                            <td>
                                                                <%= result.full_name %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th class="ps-4 bg-light">Course Details</th>
                                                            <td>
                                                                <%= result.branch %> (
                                                                    <%= result.admission_year==1 ? '1st' :
                                                                        result.admission_year==2 ? '2nd' :
                                                                        result.admission_year==3 ? '3rd' :
                                                                        result.admission_year + 'th' %> year
                                                                        )
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th class="ps-4 bg-light">Mess Preference</th>
                                                            <td>
                                                                <%= result.mess_preference %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th class="ps-4 bg-light">Current Status</th>
                                                            <td>
                                                                <% if (result.status==='Pending' ) { %>
                                                                    <span
                                                                        class="badge bg-warning text-dark status-badge"><i
                                                                            class="fas fa-clock me-1"></i> Pending
                                                                        Review</span>
                                                                    <% } else if (result.status==='Admitted' ) { %>
                                                                        <span class="badge bg-success status-badge"><i
                                                                                class="fas fa-check me-1"></i>
                                                                            Admitted</span>
                                                                        <% } else if (result.status==='Rejected' ) { %>
                                                                            <span
                                                                                class="badge bg-danger status-badge"><i
                                                                                    class="fas fa-times me-1"></i>
                                                                                Rejected</span>
                                                                            <% } else { %>
                                                                                <span
                                                                                    class="badge bg-secondary status-badge">
                                                                                    <%= result.status %>
                                                                                </span>
                                                                                <% } %>
                                                            </td>
                                                        </tr>
                                                        <% if (result.status==='Admitted' && result.allotted_room) { %>
                                                            <tr>
                                                                <th class="ps-4 bg-light text-success">Room Allotment
                                                                </th>
                                                                <td class="fw-bold text-success">
                                                                    Block: <%= result.allotted_block %>, Room: <%=
                                                                            result.allotted_room %>, Bed: <%=
                                                                                result.allotted_bed %>
                                                                </td>
                                                            </tr>
                                                            <% } %>

                                                                <% if (result.student_uid) { %>
                                                                    <tr>
                                                                        <th class="ps-4 bg-light">Generated UID</th>
                                                                        <td><span class="badge bg-dark">
                                                                                <%= result.student_uid %>
                                                                            </span></td>
                                                                    </tr>
                                                                    <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <% if (result.status==='Admitted' ) { %>
                                            <div class="alert mt-4 mx-3"
                                                style="background:#e8f5e9; border-left: 5px solid #2e7d32; border-radius:8px; padding:18px 20px;">
                                                <h6 class="fw-bold mb-2" style="color:#2e7d32;">
                                                    <i class="fas fa-door-open me-2"></i>You Can Now Login to the Hostel
                                                    Portal
                                                </h6>
                                                <p class="mb-2" style="color:#333;">Use the following credentials to log
                                                    in:</p>
                                                <table class="table table-sm table-borderless mb-2"
                                                    style="max-width:340px;">
                                                    <tr>
                                                        <td class="fw-semibold" style="color:#555;">Student UID:</td>
                                                        <td><span class="badge fs-6 px-3 py-2"
                                                                style="background:#1a3a8f; color:#fff; letter-spacing:2px;">
                                                                <%= result.student_uid %>
                                                            </span></td>
                                                    </tr>
                                                    <tr>
                                                        <td class="fw-semibold" style="color:#555;">Password:</td>
                                                        <td><span class="badge fs-6 px-3 py-2 bg-secondary">Your
                                                                registered mobile number</span></td>
                                                    </tr>
                                                </table>
                                                <p class="mb-3 small" style="color:#555;">
                                                    <i class="fas fa-info-circle me-1"></i>
                                                    After logging in for the first time, please change your password
                                                    immediately.
                                                </p>
                                                <a href="/student/login" class="btn btn-lg w-100 fw-bold"
                                                    style="background:#1a3a8f; color:#fff; border-radius:8px;">
                                                    <i class="fas fa-sign-in-alt me-2"></i>Login to Hostel Portal &rarr;
                                                </a>
                                            </div>


                                            <% } %>
                                    </div>
                                    <% } %>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        async function saveScreenshot() {
            try {
                const element = document.getElementById('statusCard');

                const canvas = await html2canvas(element, {
                    scale: 3,
                    useCORS: true,
                    backgroundColor: '#ffffff',
                    logging: false
                });

                const image = canvas.toDataURL('image/png');

                const link = document.createElement('a');
                link.href = image;
                link.download = 'Hostel_Admission_Status.png';

                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

            } catch (err) {
                console.error(err);
                alert('Unable to save screenshot');
            }
        }
    </script>
</body>

</html>