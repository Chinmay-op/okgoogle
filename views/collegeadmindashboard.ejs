<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>College Admin Dashboard</title>
  <link rel="stylesheet" href="/stylesheets/hostelpanel.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
  <link rel="icon" href="/images/4174.png">
</head>
<body>
  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div class="d-flex align-items-center">
        <a href="/daterange">
          <img src="/images/logo.png" alt="Logo" style="max-height:60px;" />
        </a>
        <h2 class="ms-3 mb-0">College Admin Dashboard</h2>
      </div>
      <a href="/logout" class="btn btn-danger btn-sm">Logout</a>
    </div>

    <% if (message && message.length > 0) { %>
      <div class="alert alert-info">
        <%- message %>
      </div>
    <% } %>

    <div class="row g-4">
      <div class="col-md-6">
        <div class="card shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title">Student Update List</h5>
            <p class="card-text text-muted">
              View and manage hostel and day scholar student records across all branches.
            </p>
            <div class="mt-auto">
              <a href="/studentsupdate" class="btn btn-primary w-100">
                Go to Student Update
              </a>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title">College Late Comers</h5>
            <p class="card-text text-muted">
              See late entry logs for all branches and filter by date range.
            </p>
            <div class="mt-auto">
              <a href="/CollegeLate" class="btn btn-warning w-100">
                Go to College Late List
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

