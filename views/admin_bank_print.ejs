<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bank Account Details - <%= request.student_name %></title>
    <%
    // Self-healing sanitization: If database contains pixel values instead of cm, default safely.
    const topMargin = (parseFloat(settings.top_margin) > 10 || !settings.top_margin) ? 2.0 : parseFloat(settings.top_margin);
    const bottomMargin = (parseFloat(settings.bottom_margin) > 10 || !settings.bottom_margin) ? 2.0 : parseFloat(settings.bottom_margin);
    const leftMargin = (parseFloat(settings.left_margin) > 10 || !settings.left_margin) ? 2.0 : parseFloat(settings.left_margin);
    const rightMargin = (parseFloat(settings.right_margin) > 10 || !settings.right_margin) ? 2.0 : parseFloat(settings.right_margin);
    const fontSize = (parseInt(settings.font_size) > 40 || !settings.font_size) ? 15 : parseInt(settings.font_size);
    const lineHeight = (parseFloat(settings.line_height) > 5 || !settings.line_height) ? 1.4 : parseFloat(settings.line_height);

    // Format date as DD/MM/YYYY
    const formattedDate = new Date().toLocaleDateString('en-GB', { timeZone: 'Asia/Kolkata' });
    %>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            font-family: "Times New Roman", serif;
            background: #fff;
            color: #000;
        }
        
        .certificate-container {
            box-sizing: border-box;
            width: 21cm;
            height: 28.5cm;
            display: flex;
            flex-direction: column;
        }

        .title-section {
            text-align: center;
            font-weight: bold;
            font-size: calc(var(--font-size, 15px) + 2px);
            margin-bottom: 20px;
            text-transform: uppercase;
        }
        .title-section span {
            border-bottom: 1.5px solid #000;
            display: inline-block;
            padding-bottom: 2px;
        }
        .title-section span span {
            border-bottom: 1.5px solid #000;
            display: inline-block;
            padding-bottom: 2px;
        }

        .bank-details-table {
            width: 100%;
            margin-bottom: 20px;
            font-size: var(--font-size, 15px);
            line-height: var(--line-height, 1.4);
        }
        .bank-details-table td {
            vertical-align: top;
            padding: 2px 0;
        }
        .bank-details-table td.label-col {
            width: 32%;
            font-weight: bold;
        }
        .bank-details-table td.colon-col {
            width: 3%;
            text-align: center;
        }
        .bank-details-table td.value-col {
            width: 65%;
            font-weight: bold;
        }

        .instruction-list {
            margin-bottom: 20px;
            font-size: var(--font-size, 15px);
            line-height: 1.3;
            padding-left: 20px;
        }
        .instruction-list li {
            margin-bottom: 5px;
            font-weight: bold;
        }

        .date-section {
            text-align: right;
            font-weight: bold;
            font-size: var(--font-size, 15px);
            margin-bottom: 8px;
        }

        /* Tables matching official scan layout */
        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
            font-size: var(--font-size, 15px);
        }
        .details-table th, .details-table td {
            border: 1px solid #000;
            padding: 6px;
            text-align: center;
        }
        .details-table th {
            font-weight: normal;
            font-size: calc(var(--font-size, 15px) - 1px);
        }
        .details-table td {
            font-weight: bold;
        }

        .signature-section {
            margin-top: 35px;
            font-size: var(--font-size, 15px);
            line-height: 1.3;
            font-weight: bold;
        }

        /* Screen Preview Mode */
        @media screen {
            body {
                background: #edf2f7;
                padding: 40px 20px;
                display: flex;
                flex-direction: column;
                align-items: center;
                min-height: 100vh;
            }
            .certificate-container {
                background: #fff;
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                padding-top: var(--top-margin, 2.0cm);
                padding-bottom: var(--bottom-margin, 2.0cm);
                padding-left: var(--left-margin, 2.0cm);
                padding-right: var(--right-margin, 2.0cm);
            }
            .manual-print-btn {
                margin-bottom: 20px;
                background: #3182ce;
                color: #fff;
                border: none;
                padding: 10px 25px;
                border-radius: 6px;
                cursor: pointer;
                font-family: sans-serif;
                font-weight: bold;
                font-size: 1rem;
                box-shadow: 0 2px 5px rgba(0,0,0,0.2);
                z-index: 100;
            }
        }

        /* Print Mode */
        @media print {
            @page {
                size: 21cm 28.5cm;
                margin: 0;
            }
            html, body {
                width: 21cm;
                height: 28.5cm;
                background: #fff;
            }
            .manual-print-btn {
                display: none !important;
            }
            .certificate-container {
                padding-top: var(--top-margin, 2.0cm);
                padding-bottom: var(--bottom-margin, 2.0cm);
                padding-left: var(--left-margin, 2.0cm);
                padding-right: var(--right-margin, 2.0cm);
                width: 21cm;
                height: 28.5cm;
            }
        }
    </style>
</head>
<body style="--top-margin: <%= topMargin %>cm; --bottom-margin: <%= bottomMargin %>cm; --left-margin: <%= leftMargin %>cm; --right-margin: <%= rightMargin %>cm; --font-size: <%= fontSize %>px; --line-height: <%= lineHeight %>;">

<button class="manual-print-btn" onclick="window.print()">Print</button>

<div class="certificate-container">
    <div class="title-section">
        <span>
            <span>
                BANK ACCOUNT DETAILS FOR<br>
                NEFT/RTGS/GPAY/ ONLINE PAYMENT
            </span>
        </span>
    </div>

    <table class="bank-details-table" border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td class="label-col">Name of the Bank</td>
            <td class="colon-col">:</td>
            <td class="value-col"><%= (typeof settings !== 'undefined' && settings.bank_name) ? settings.bank_name : request.bank_name %></td>
        </tr>
        <tr>
            <td class="label-col">Account Holder</td>
            <td class="colon-col">:</td>
            <td class="value-col"><%= (typeof settings !== 'undefined' && settings.account_holder) ? settings.account_holder : request.account_holder %></td>
        </tr>
        <tr>
            <td class="label-col">Branch</td>
            <td class="colon-col">:</td>
            <td class="value-col"><%= (typeof settings !== 'undefined' && settings.branch) ? settings.branch : request.bank_branch %></td>
        </tr>
        <tr>
            <td class="label-col">Account Number</td>
            <td class="colon-col">:</td>
            <td class="value-col"><%= (typeof settings !== 'undefined' && settings.account_number) ? settings.account_number : request.account_number %></td>
        </tr>
        <tr>
            <td class="label-col">IFSC Code</td>
            <td class="colon-col">:</td>
            <td class="value-col"><%= (typeof settings !== 'undefined' && settings.ifsc) ? settings.ifsc : request.ifsc %></td>
        </tr>
    </table>

    <ul class="instruction-list">
        <li>Kindly send the UTR Number (Transaction ID/ Reference Number) on the same day after making the payment.</li>
        <li>Via SMS/Whatapp : Mobile No: <%= (typeof settings !== 'undefined' && settings.contact_number) ? settings.contact_number : request.contact_number %></li>
        <li>Or Via Email : <span style="text-decoration: underline; color: #0000ee;"><%= (typeof settings !== 'undefined' && settings.email) ? settings.email : request.email %></span></li>
    </ul>

    <div class="date-section">
        Date: <%= formattedDate %>
    </div>

    <!-- Student Table 1 -->
    <table class="details-table">
        <thead>
            <tr>
                <th style="width: 50%;">Name of Student</th>
                <th style="width: 50%;">Father's Name</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><%= request.student_name %></td>
                <td><%= request.father_name %></td>
            </tr>
        </tbody>
    </table>

    <!-- Student Table 2 -->
    <table class="details-table">
        <thead>
            <tr>
                <th style="width: 33.33%;">Academic Year</th>
                <th style="width: 33.33%;">Branch</th>
                <th style="width: 33.33%;">Studying In</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><%= request.academic_year %></td>
                <td><%= request.branch %></td>
                <td><%= request.year %> year</td>
            </tr>
        </tbody>
    </table>

    <!-- Fee Table -->
    <table class="details-table" style="margin-bottom: 40px;">
        <thead>
            <tr>
                <th style="width: 25%;">Year</th>
                <th style="width: 25%;">Boarding</th>
                <th style="width: 25%;">Mess</th>
                <th style="width: 25%;">Total</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><%= request.year %></td>
                <td><%= parseFloat(request.boarding_fee).toFixed(2) %></td>
                <td><%= parseFloat(request.mess_fee).toFixed(2) %></td>
                <td><%= parseFloat(request.total_fee).toFixed(2) %></td>
            </tr>
        </tbody>
    </table>

    <div class="signature-section">
        Hostel Manager<br>
        Fr. Roby PA
    </div>
</div>

<script>
    window.addEventListener('load', () => {
        setTimeout(() => {
            window.print();
        }, 500);
    });
    window.addEventListener('afterprint', () => {
        fetch('/admin/bank-details/<%= request.id %>/printed', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': '<%= csrfToken %>'
            }
        }).catch(err => {});
    });
</script>

</body>
</html>
