<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Reset Password</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container py-5">
  <% if (message && message.length) { %>
    <div class="alert alert-info"><%- message %></div>
  <% } %>
  <h3>Reset Password</h3>
  <form method="POST" action="/student/reset" class="mt-3" style="max-width:420px;">
    <div class="mb-3">
      <label class="form-label">UID</label>
      <input name="uid" class="form-control" value="<%= uid || '' %>" required />
    </div>
    <div class="mb-3">
      <label class="form-label">6-digit Code</label>
      <input name="code" class="form-control" maxlength="6" placeholder="Enter code sent on email" required />
    </div>
    <div class="mb-3">
      <label class="form-label">New Password</label>
      <input type="password" name="newPassword" class="form-control" minlength="6" required />
    </div>
    <div class="mb-3">
      <label class="form-label">Confirm New Password</label>
      <input type="password" name="confirmPassword" class="form-control" minlength="6" required />
    </div>
    <button class="btn btn-primary">Reset Password</button>
    <a href="/student/login" class="btn btn-link">Back to login</a>
  </form>
</body>
</html>
