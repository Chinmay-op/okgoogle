<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hostel Out</title>
  <link rel="stylesheet" href="/stylesheets/hostelpanel.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
  <link rel="icon" href="/images/4174.png">


  <script>
    function myFunction() {
      var input, filter, table, tr, td, i;
      input = document.getElementById("searchbar");
      filter = input.value.toUpperCase();
      table = document.getElementById("myTable");
      tr = table.getElementsByTagName("tr");
      for (i = 0; i < tr.length; i++) {
        td = tr[i].getElementsByTagName("td")[3]; // for column one
        td1 = tr[i].getElementsByTagName("td")[2]; // for column two
        /* ADD columns here that you want you to filter to be used on */
        if (td) {
          if ((td.innerHTML.toUpperCase().indexOf(filter) > -1) || (td1.innerHTML.toUpperCase().indexOf(filter) > -1)) {
            tr[i].style.display = "";
          } else {
            tr[i].style.display = "none";
          }
        }
      }
    }

    function passfilter(value) {
      var input, filter, table, tr, td, i, txtValue;

      filter = value.toUpperCase();
      console.log(filter);
      table = document.getElementById("myTable");
      tr = table.getElementsByTagName("tr");
      for (i = 0; i < tr.length; i++) {
        td = tr[i].getElementsByTagName("td")[0];
        if (td) {
          txtValue = td.textContent || td.innerText;
          if (txtValue.toUpperCase().indexOf(filter) > -1) {
            tr[i].style.display = "";
          } else {
            tr[i].style.display = "none";
          }
        }
      }
    }


   function dateFormat(input_D) {
  // Expect 'YYYY-MM-DD HH:MM:SS' and render as 'D Mon YYYY, hh:mm am/pm' in LOCAL time
  if (!input_D || typeof input_D !== 'string') return input_D;
  input_D = input_D.trim();
  var m = input_D.match(/^(\d{4})-(\d{2})-(\d{2})\s+(\d{2}):(\d{2})(?::(\d{2}))?/);
  if (!m) return input_D;
  var yyyy = parseInt(m[1], 10);
  var mm = parseInt(m[2], 10) - 1;
  var dd = parseInt(m[3], 10);
  var HH = parseInt(m[4], 10);
  var Min = parseInt(m[5], 10);
  var SS = parseInt(m[6] || '0', 10);
  var d = new Date(yyyy, mm, dd, HH, Min, SS);
  if (isNaN(d.getTime())) return input_D;
  function pad(n) { return String(n).padStart(2, '0'); }
  var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var hour = d.getHours();
  var ampm = hour >= 12 ? 'pm' : 'am';
  var hour12 = hour % 12;
  if (hour12 === 0) hour12 = 12;
  return d.getDate() + ' ' + monthNames[d.getMonth()] + ' ' + d.getFullYear() + ', ' + pad(hour12) + ':' + pad(d.getMinutes()) + ' ' + ampm;
}

    window.onload = function () {
      var approvalDates = document.getElementsByClassName("approvalDate");
      for (var i = 0; i < approvalDates.length; i++) {
        if (approvalDates[i].innerHTML == 0) {
          approvalDates[i].innerHTML = "";
        }
        else {
          approvalDates[i].innerHTML = dateFormat(approvalDates[i].innerHTML);
        }
      }
    };


  </script>


</head>

<body>

  <div>
    <center>
      <% if(message.length>0){ %>
        <div class="alert-danger">
          <h5>
            <%- message %>
          </h5>
        </div>
        <% } %>
          <a href="/daterange"><img src="/images/logo.png" /></a><br><br>

          <div class="radio-inputs" align="center">
           
            <label class="radio">
              <input type="radio" name="radio" onclick="passfilter(this.value)" id="radio" value="Home Pass">
              <span class="name">Home Pass</span>
            </label>
            <label class="radio">
              <input type="radio" name="radio"  onclick="passfilter(this.value)" id="radio" value="City Pass">
              <span class="name">City Pass</span>
            </label>
            <label class="radio">
              <input type="radio" name="radio"  checked="checked" onclick="passfilter(this.value)" id="radio" value="">
              <span class="name">All Pass</span>
            </label>
          </div>
  </div>
  </center>
  </div><br>

  <div class="container">

    <div class="row justify-content-center">
      <div>
        <form action="/hosteloutdaterange" align="right" method="post">
          <div>
            <div align="center">
              <label class="form-label">Date From</label>
              <input type="date" name="datefrom">

              <label class="form-label">Date To</label>
              <input type="date" name="dateto">
              <button class="btn btn-primary"><span>Go</span></button>
            </div>
          </div>
        </form>
      </div>
      <div><input type="search" class="form-control rounded" placeholder="Search" aria-label="Search"
          aria-describedby="search-addon" id="searchbar" onkeyup="myFunction()" />
        <i class="fas fa-search"></i>
      </div>
    </div>
  </div>
  <div class="container table-responsive py-5">
    <table class="table table-bordered table-hover" id="myTable">
      <thead class="thead-dark">

        <tr>
          <th scope="col" hidden>Pass Type</th>
          <th scope="col">S.N</th>
          <th scope="col">UID</th>
          <th scope="col">NAME</th>
          <th scope="col">Hostel Out</th>
          <th scope="col">Take IN</th>
          <th scope="col">Action</th>

        </tr>
      </thead>
      <tbody>
        <% if(result.length> 0) { %>

          <% for(var i=0;i<result.length;i++){ %>
            <% if(result[i].status=='Restrict' ) { %>
              <tr class="table-danger" data-passtype="<%= result[i].passtype %>">
                <td hidden><%- result[i].passtype%></td>
                <td scope="row"><%- i + 1 %></td>
                <td><a href="/studentprofile/<%-result[i].uid%>"><%-result[i].uid%></a></td>
                <td><%- result[i].sname%></td>
                <td class="approvalDate"><%- result[i].approvaldt%></td>
                <td><a href="/instudents/<%-result[i].logid%>">
                    <lable class="btn btn-outline-dark">Hostel IN</lable>
                  </a></td>
                <td><a href="/Unrestrictstu/<%-result[i].uid%>">
                    <lable class="btn btn-outline-success">Unrestrict</lable>
                  </a></td>
              </tr>
              <% }else{ %>
                <tr data-passtype="<%= result[i].passtype %>">
                  <td hidden><%- result[i].passtype%></td>
                  <td scope="row"><%- i + 1 %></td>
                  <td><a href="/studentprofile/<%-result[i].uid%>"><%-result[i].uid%></a></td>
                  <td><%- result[i].sname%></td>
                  <td class="approvalDate"><%- result[i].approvaldt%></td>
                  <td><a href="/instudents/<%-result[i].logid%>">
                      <lable class="btn btn-outline-dark">Hostel IN</lable>
                    </a></td>
                  <td><a href="/restrictstu/<%-result[i].uid%>">
                      <lable class="btn btn-outline-danger">Restrict</lable>
                    </a></td>
                </tr>

                <% } %>

                  <% } %>

                    <% }else{ %>
                      <tr class="warning no-result">
                        <td colspan="10"> <i class="fa fa-warning"></i>
                          <center>Data Not found</center>
                        </td>
                      </tr>
                      <% } %>
      </tbody>
    </table>
  </div>

<script>
(function(){
  function saveFilter(val){
    try { localStorage.setItem('outstudents_pass_filter', String(val || '')); } catch(e) {}
  }
  function applySaved(){
    try {
      var saved = localStorage.getItem('outstudents_pass_filter');
      var radios = document.querySelectorAll('input[type="radio"][name="radio"]');
      if (saved !== null && radios && radios.length) {
        // Set the radio button UI
        var matched = null;
        for (var j=0; j<radios.length; j++) {
          if ((radios[j].value || '') === saved) { matched = radios[j]; break; }
        }
        if (matched) matched.checked = true;
        // Apply the filter to table rows
        if (typeof passfilter === 'function') passfilter(saved);
      }
    } catch(e) {}
  }

  document.addEventListener('DOMContentLoaded', function(){
    // 1) Restore and apply previously chosen radio filter
    applySaved();

    // 2) Persist whenever radio changes
    var radios = document.querySelectorAll('input[type="radio"][name="radio"]');
    for (var r = 0; r < radios.length; r++) {
      radios[r].addEventListener('change', function(ev){
        saveFilter((ev.target || {}).value || '');
      });
    }

    // 3) Before any action link navigation, snapshot current filter
    var table = document.getElementById('myTable');
    if (table) {
      var links = table.querySelectorAll(
        'a[href^="/instudents/"], a[href^="/restrictstu/"], a[href^="/Unrestrictstu/"]'
      );
      for (var k = 0; k < links.length; k++) {
        links[k].addEventListener('click', function(){
          var current = (document.querySelector('input[type="radio"][name="radio"]:checked') || {}).value || '';
          saveFilter(current);
        });
      }
    }
  });
})();
</script>

</body>

</html>