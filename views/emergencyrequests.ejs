<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Emergency Requests - Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; background: #f4f7f6; margin: 0; padding: 20px; }
        .container-main { max-width: 1000px; margin: 0 auto; background: #fff; padding: 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
        .page-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f0f2f5; padding-bottom: 20px; margin-bottom: 30px; }
        .page-header h1 { font-size: 24px; font-weight: 700; color: #1a1a1a; margin: 0; }
        .nav-links { display: flex; gap: 10px; }
        .btn-custom { padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 14px; text-decoration: none; border: none; cursor: pointer; transition: all 0.2s ease; }
        .btn-back { background: #f0f2f5; color: #333; }
        .btn-back:hover { background: #e4e6e9; text-decoration: none; color: #333; }
        .search-box { width: 100%; max-width: 400px; padding: 10px 15px; border-radius: 8px; border: 1px solid #ddd; margin-bottom: 20px; font-size: 14px; }
        
        .student-list { list-style: none; padding: 0; margin: 0; }
        .student-item { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; border-bottom: 1px solid #f0f2f5; transition: background 0.2s ease; }
        .student-item:hover { background: #f9fafb; }
        .student-info { display: flex; flex-direction: column; gap: 4px; }
        .student-name { font-weight: 600; color: #333; font-size: 16px; }
        .student-uid { font-size: 13px; color: #666; font-family: monospace; }
        
        .btn-enable { background: #dc3545; color: white; }
        .btn-enable:hover { background: #c82333; color: white; }
        .btn-disable { background: #28a745; color: white; }
        .btn-disable:hover { background: #218838; color: white; }
    </style>
</head>
<body>
    <div class="container-main">
        <div class="page-header">
            <div>
                <h1><i class="fas fa-exclamation-circle text-danger"></i> Emergency Pass Access</h1>
                <p style="margin: 5px 0 0; color: #888; font-size: 14px;">Enable one-time emergency pass requests for students</p>
            </div>
            <div class="nav-links">
                <a href="/admin/passrequests" class="btn-custom btn-back"><i class="fas fa-arrow-left"></i> Back to Requests</a>
            </div>
        </div>
        
        <% if(message && message.length > 0){ %>
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> <%- message %>
            </div>
        <% } %>

        <input type="text" id="searchInput" class="search-box" placeholder="Search by name or UID..." onkeyup="filterStudents()">

        <ul class="student-list" id="studentList">
            <% students.forEach(function(student) { %>
                <li class="student-item" data-name="<%= (student.sname || '').toLowerCase() %>" data-uid="<%= (student.uid || '').toLowerCase() %>">
                    <div class="student-info">
                        <span class="student-name"><%= student.sname %></span>
                        <span class="student-uid"><i class="fas fa-id-card"></i> <%= student.uid %></span>
                    </div>
                    <div>
                        <% if(student.emergency_pass_enabled) { %>
                            <button class="btn-custom btn-disable" onclick="toggleEmergency('<%= student.uid %>', false, this)">
                                <i class="fas fa-check-circle"></i> Enabled
                            </button>
                        <% } else { %>
                            <button class="btn-custom btn-enable" onclick="toggleEmergency('<%= student.uid %>', true, this)">
                                <i class="fas fa-bolt"></i> Enable One-Time
                            </button>
                        <% } %>
                    </div>
                </li>
            <% }); %>
        </ul>
    </div>

    <script>
        function filterStudents() {
            const val = document.getElementById('searchInput').value.toLowerCase();
            const items = document.querySelectorAll('.student-item');
            items.forEach(item => {
                const name = item.getAttribute('data-name');
                const uid = item.getAttribute('data-uid');
                if (name.includes(val) || uid.includes(val)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        function toggleEmergency(uid, enable, btnEl) {
            btnEl.disabled = true;
            btnEl.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
            
            fetch('/admin/emergency-requests/toggle/' + uid, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ enable: enable })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (enable) {
                        btnEl.className = 'btn-custom btn-disable';
                        btnEl.innerHTML = '<i class="fas fa-check-circle"></i> Enabled';
                        btnEl.onclick = function() { toggleEmergency(uid, false, btnEl); };
                    } else {
                        btnEl.className = 'btn-custom btn-enable';
                        btnEl.innerHTML = '<i class="fas fa-bolt"></i> Enable One-Time';
                        btnEl.onclick = function() { toggleEmergency(uid, true, btnEl); };
                    }
                } else {
                    alert('Error: ' + data.message);
                    btnEl.disabled = false;
                    btnEl.innerHTML = enable ? 'Enable One-Time' : 'Enabled';
                }
            })
            .catch(err => {
                alert('Network error occurred.');
                btnEl.disabled = false;
                btnEl.innerHTML = enable ? 'Enable One-Time' : 'Enabled';
            });
        }
    </script>
</body>
</html>
