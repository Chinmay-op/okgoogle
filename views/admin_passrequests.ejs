<script>
// Auto-refresh a few seconds after local midnight to update daily stats
(function(){
  function msUntilNextMidnight(){
    var now = new Date();
    var next = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 5, 0); // 00:00:05
    return next.getTime() - now.getTime();
  }
  var delay = msUntilNextMidnight();
  if (delay > 0 && delay < 36*60*60*1000) { // sanity cap
    setTimeout(function(){
      window.location.reload();
    }, delay);
  }
})();
</script>
