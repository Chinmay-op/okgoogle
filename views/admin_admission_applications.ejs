<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Hostel Admission Applications</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .header-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .stat-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-left: 5px solid #667eea;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }
        .stat-content {
            display: flex;
            flex-direction: column;
        }
        .stat-title {
            color: #6c757d;
            font-size: 0.9rem;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
        }
        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: #333;
        }
        .stat-icon {
            font-size: 2.5rem;
            opacity: 0.3;
        }
        
        .stat-card.total { border-left-color: #667eea; }
        .stat-card.total .stat-icon { color: #667eea; }
        
        .stat-card.pending { border-left-color: #f6ca35; }
        .stat-card.pending .stat-icon { color: #f6ca35; opacity: 0.5; }
        
        .stat-card.admitted { border-left-color: #43e97b; }
        .stat-card.admitted .stat-icon { color: #43e97b; opacity: 0.5; }
        
        .stat-card.rejected { border-left-color: #ff0844; }
        .stat-card.rejected .stat-icon { color: #ff0844; opacity: 0.4; }
        .table-card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 20px;
        }
    </style>
</head>
<body>
    <div class="container-fluid mt-4 px-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a href="/daterange" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
        </div>

        <div class="header-gradient d-flex justify-content-between align-items-center">
            <h2 class="mb-0"><i class="fas fa-clipboard-list"></i> Hostel Admission Applications</h2>
            <div>
                <a href="/admin/admission-applications/admitted-list" class="btn btn-light text-primary fw-bold shadow-sm">
                    <i class="fas fa-bed"></i> Room Master List
                </a>
            </div>
        </div>

        <% if (message && message.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <!-- Time Filter -->
        <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
            <h5 class="text-muted mb-0 fw-bold">Application Statistics</h5>
            <div class="d-flex align-items-center bg-white p-2 rounded shadow-sm border border-light">
                <label for="timeFilter" class="fw-bold me-2 text-dark mb-0"><i class="fas fa-calendar-alt text-primary"></i> Show:</label>
                <select id="timeFilter" class="form-select form-select-sm w-auto fw-bold text-primary border-0" style="background-color: #f8f9fa; cursor: pointer; outline: none; box-shadow: none;">
                    <option value="today" selected>Today's Applications</option>
                    <option value="total">Total Applications</option>
                </select>
            </div>
        </div>

        <!-- Stats Row -->
        <% 
            let todayStr = new Date().toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' });
            let todayApplications = applications.filter(a => new Date(a.submission_date).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' }) === todayStr);
            let pending = todayApplications.filter(a => a.status === 'Pending').length;
            let admitted = todayApplications.filter(a => a.status === 'Admitted').length;
            let rejected = todayApplications.filter(a => a.status === 'Rejected').length;
        %>
        <div class="row">
            <div class="col-md-3">
                <div class="stat-card total">
                    <div class="stat-content">
                        <div class="stat-title" id="titleTotal">Today's Applications</div>
                        <div class="stat-value" id="countTotal"><%= todayApplications.length %></div>
                    </div>
                    <i class="fas fa-layer-group stat-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card pending">
                    <div class="stat-content">
                        <div class="stat-title">Pending</div>
                        <div class="stat-value" id="countPending"><%= pending %></div>
                    </div>
                    <i class="fas fa-hourglass-half stat-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card admitted">
                    <div class="stat-content">
                        <div class="stat-title">Admitted</div>
                        <div class="stat-value" id="countAdmitted"><%= admitted %></div>
                    </div>
                    <i class="fas fa-check-circle stat-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card rejected">
                    <div class="stat-content">
                        <div class="stat-title">Rejected</div>
                        <div class="stat-value" id="countRejected"><%= rejected %></div>
                    </div>
                    <i class="fas fa-times-circle stat-icon"></i>
                </div>
            </div>
        </div>

        <!-- Filters & Table -->
        <div class="table-card">
            
            <!-- Top Actions: Export and Search -->
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-3 gap-3">
                <!-- Export Buttons (Left) -->
                <div class="d-flex gap-2 flex-wrap">
                    <span class="fw-semibold align-self-center me-1">
                        <i class="fas fa-file-excel text-success"></i> Export to Excel:
                    </span>
                    <a href="/admin/admission-applications/export?filter=all&time=today" id="exportAll" class="btn btn-sm btn-outline-success">All</a>
                    <a href="/admin/admission-applications/export?filter=pending&time=today" id="exportPending" class="btn btn-sm btn-warning text-white">Pending</a>
                    <a href="/admin/admission-applications/export?filter=admitted&time=today" id="exportAdmitted" class="btn btn-sm btn-success">Admitted</a>
                    <a href="/admin/admission-applications/export?filter=rejected&time=today" id="exportRejected" class="btn btn-sm btn-danger">Rejected</a>
                </div>

                <!-- Search Bar (Right) -->
                <div class="input-group" style="max-width: 350px;">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Search name, branch, mobile, etc...">
                </div>
            </div>

            <!-- Filter Tabs -->
            <ul class="nav nav-tabs mb-4" id="filterTabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#" data-filter="All">All</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" data-filter="Pending">Pending</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" data-filter="Admitted">Admitted</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" data-filter="Rejected">Rejected</a>
                </li>
            </ul>

            <div class="table-responsive">
                <table class="table table-hover align-middle" id="applicationsTable">
                    <thead class="table-light">
                        <tr>
                            <th>#ID</th>
                            <th>UID</th>
                            <th>Full Name</th>
                            <th>Branch</th>
                            <th>Year</th>
                            <th>Mobile</th>
                            <th>Mess</th>
                            <th>Submitted Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% applications.forEach(app => { 
                            let appDateStr = new Date(app.submission_date).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' });
                            let isToday = appDateStr === todayStr;
                        %>
                            <tr data-status="<%= app.status %>" data-date="<%= appDateStr %>" style="<%= isToday ? '' : 'display: none;' %>">
                                <td><%= app.id %></td>
                                <td><span class="badge bg-secondary"><%= app.student_uid || 'N/A' %></span></td>
                                <td class="fw-bold"><%= app.full_name %></td>
                                <td><%= app.branch %></td>
                                <td><%= app.admission_year %></td>
                                <td><%= app.student_mobile %></td>
                                <td>
                                    <% if(app.mess_preference === 'Veg') { %>
                                        <span class="badge bg-success"><i class="fas fa-leaf"></i> Veg</span>
                                    <% } else { %>
                                        <span class="badge bg-danger"><i class="fas fa-drumstick-bite"></i> Non-Veg</span>
                                    <% } %>
                                </td>
                                <td><%= new Date(app.submission_date).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' }) %></td>
                                <td>
                                    <% if(app.status === 'Pending') { %>
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    <% } else if(app.status === 'Admitted') { %>
                                        <span class="badge bg-success">Admitted</span>
                                    <% } else { %>
                                        <span class="badge bg-danger">Rejected</span>
                                    <% } %>
                                </td>
                                <td>
                                    <a href="/admin/admission-applications/<%= app.id %>" class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i> View & Process
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                        <% if(applications.length === 0) { %>
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">No applications found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const searchInput = document.getElementById('searchInput');
        const timeFilter = document.getElementById('timeFilter');

        function getTodayDateString() {
            return new Date().toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' });
        }
        
        function filterTable() {
            const activeTab = document.querySelector('#filterTabs .nav-link.active').getAttribute('data-filter');
            const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
            const timeOption = timeFilter ? timeFilter.value : 'today';
            const todayStr = getTodayDateString();
            
            const rows = document.querySelectorAll('#applicationsTable tbody tr');
            
            let countT = 0, countP = 0, countA = 0, countR = 0;

            rows.forEach(row => {
                if(!row.hasAttribute('data-status')) return; // skip empty row
                
                const status = row.getAttribute('data-status');
                const rowDate = row.getAttribute('data-date');
                
                const statusMatch = activeTab === 'All' || status === activeTab;
                const textMatch = row.textContent.toLowerCase().includes(searchTerm);
                const timeMatch = timeOption === 'total' || rowDate === todayStr;
                
                if(timeMatch) {
                    countT++;
                    if(status === 'Pending') countP++;
                    else if(status === 'Admitted') countA++;
                    else if(status === 'Rejected') countR++;
                }

                if(statusMatch && textMatch && timeMatch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            // Update stats cards
            if(document.getElementById('countTotal')) document.getElementById('countTotal').innerText = countT;
            if(document.getElementById('countPending')) document.getElementById('countPending').innerText = countP;
            if(document.getElementById('countAdmitted')) document.getElementById('countAdmitted').innerText = countA;
            if(document.getElementById('countRejected')) document.getElementById('countRejected').innerText = countR;
            
            // Update title
            const titleTotal = document.getElementById('titleTotal');
            if(titleTotal) {
                titleTotal.innerText = timeOption === 'today' ? "Today's Applications" : "Total Applications";
            }
            
            // Update export links
            const timeParam = timeOption === 'today' ? '&time=today' : '';
            const exportAll = document.getElementById('exportAll');
            const exportPending = document.getElementById('exportPending');
            const exportAdmitted = document.getElementById('exportAdmitted');
            const exportRejected = document.getElementById('exportRejected');
            
            if(exportAll) exportAll.href = '/admin/admission-applications/export?filter=all' + timeParam;
            if(exportPending) exportPending.href = '/admin/admission-applications/export?filter=pending' + timeParam;
            if(exportAdmitted) exportAdmitted.href = '/admin/admission-applications/export?filter=admitted' + timeParam;
            if(exportRejected) exportRejected.href = '/admin/admission-applications/export?filter=rejected' + timeParam;
        }

        // Client-side filtering tabs
        document.querySelectorAll('#filterTabs .nav-link').forEach(tab => {
            tab.addEventListener('click', function(e) {
                e.preventDefault();
                // Update active tab
                document.querySelectorAll('#filterTabs .nav-link').forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                
                filterTable();
            });
        });

        // Search bar listener
        if (searchInput) {
            searchInput.addEventListener('input', filterTable);
        }

        // Time filter listener
        if (timeFilter) {
            timeFilter.addEventListener('change', filterTable);
        }
    </script>
</body>
</html>
